# ─────────────────────────────────────────────────────────────
# CataManager — Variables de entorno para Dokploy (servicio app)
# Pega estas claves en: Dokploy → tu aplicación → Environment
# ─────────────────────────────────────────────────────────────

# ── Base de datos MySQL (servicio creado en Dokploy) ────────
# Crea un servicio MySQL 8 en Dokploy. Su host interno suele ser
# algo como "<nombre>-db-xxxx" (lo ves en el panel del servicio BD).
DB_HOST=tu-servicio-mysql-db-xxxx
DB_PORT=3306
DB_USER=catamanager
DB_PASS=cambia-esta-clave
DB_NAME=catamanager

# ── App ──────────────────────────────────────────────────────
# Clave maestra del panel /maestro (cámbiala por una larga y aleatoria:
# openssl rand -hex 24)
MASTER_KEY=cambia-esta-clave-maestra

# URL pública de la app (dominio real, p.ej. https://tuapp.com).
# Vacía = enlaces relativos. Se usa para compartir catálogos y SEO.
BASE_URL=

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# ─────────────────────────────────────────────────────────────
# PASOS UNA SOLA VEZ tras crear la BD en Dokploy:
#   1) El esquema se carga ejecutando el archivo `catamanager-full.sql`
#      contra esa BD (consola SQL del servicio o `mysql < catamanager-full.sql`).
#      Alternativa: en Dokploy monta `catamanager-full.sql` en
#      /docker-entrypoint-initdb.d/ del servicio MySQL.
#   2) La app siembra sola la tienda demo en su primer arranque si la
#      tabla `businesses` está vacía (no hace falta cargar datos).
# ─────────────────────────────────────────────────────────────
