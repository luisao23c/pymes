NODE_ENV=production
PORT=3000
BASE_URL=https://tu-dominio.com
MASTER_KEY=genera-una-clave-aleatoria-de-al-menos-32-caracteres

# En producción apunta estos directorios a un disco persistente.
DATA_DIR=/var/lib/nessik
UPLOAD_DIR=/var/lib/nessik/uploads
BACKUP_DIR=/var/lib/nessik/backups

# MariaDB (la aplicación usará estos valores tras completar la migración)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nessik_catalogo
DB_USER=nessik_app
DB_PASSWORD=cambia-esta-contrasena
DB_CONNECTION_LIMIT=10

# Archivo SQLite de origen para el importador de datos.
SQLITE_SOURCE=./data.db

# Demo opcional solo para desarrollo; nunca lo actives en producción.
SEED_DEMO=false
