# CataManager - Variables de entorno para Dokploy
# Copia este archivo como .env y ajusta los valores

# Clave maestra del admin (obligatorio)
MASTER_KEY=mk-cambiar-estaaa-clave

# Base de datos MariaDB (usa root directamente)
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=catamanager

# MariaDB root password (se usa tanto para root como para la app)
MYSQL_ROOT_PASSWORD=cambiar-root-password
