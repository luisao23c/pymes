<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Configuración', biz }) %>
  <style>
    /* ============================================================
       MEJORAS ADICIONALES PARA EL PANEL DE CONFIGURACIÓN
       ============================================================ */

    /* Transiciones suaves para todo */
    .config-section {
      transition: box-shadow 0.25s ease, transform 0.25s ease;
    }
    .config-section:hover {
      box-shadow: var(--md-elevation-2);
    }

    /* Inputs con estilo más refinado */
    .config-input {
      width: 100%;
      padding: 0.7rem 1rem;
      border: 1.5px solid var(--md-outline-soft);
      border-radius: var(--md-radius-sm);
      font-size: 0.9rem;
      font-family: var(--md-font-family);
      background: var(--md-surface);
      color: var(--md-on-surface);
      transition: border-color var(--md-motion), box-shadow var(--md-motion), background var(--md-motion);
      outline: none;
    }
    .config-input:focus {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 4px rgba(26, 115, 232, 0.12);
      background: var(--md-surface);
    }
    .config-input::placeholder {
      color: var(--md-on-surface-variant);
      opacity: 0.5;
    }

    /* Etiquetas de campo */
    .config-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--md-on-surface-variant);
      margin-bottom: 0.4rem;
    }

    /* Preview de colores */
    .color-preview {
      width: 100%;
      height: 40px;
      border-radius: 12px;
      border: 2px solid transparent;
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .color-preview:hover {
      transform: scale(1.02);
    }
    .color-radio:checked + .color-preview {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.2);
    }

    /* Opciones de plantilla */
    .template-option {
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .template-option:hover {
      transform: translateY(-2px);
      box-shadow: var(--md-elevation-1);
    }
    .template-radio:checked + .template-option {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.15);
    }

    /* Selector de columnas */
    .cols-option {
      transition: all 0.2s ease;
      cursor: pointer;
      min-width: 60px;
    }
    .cols-option:hover {
      transform: translateY(-2px);
      box-shadow: var(--md-elevation-1);
    }
    .cols-radio:checked + .cols-option {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.15);
    }

    /* Indicador de selección (check) en plantillas, estilos, colores y columnas */
    .template-option, .cols-option, .color-preview {
      position: relative;
    }
    .template-radio:checked + .template-option,
    .cols-radio:checked + .cols-option {
      border-color: var(--md-primary) !important;
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.25);
      transform: translateY(-2px);
    }
    .template-radio:checked + .template-option::after,
    .cols-radio:checked + .cols-option::after,
    .color-radio:checked + .color-preview::after {
      content: '✓';
      position: absolute;
      top: 5px; right: 5px;
      width: 20px; height: 20px;
      border-radius: 50%;
      background: var(--md-primary);
      color: #fff;
      font-size: 12px;
      font-weight: 900;
      line-height: 20px;
      text-align: center;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
      z-index: 5;
    }
    body.dark .template-radio:checked + .template-option,
    body.dark .cols-radio:checked + .cols-option {
      border-color: #8ab4f8 !important;
      box-shadow: 0 0 0 3px rgba(138, 180, 248, 0.25);
    }
    body.dark .template-radio:checked + .template-option::after,
    body.dark .cols-radio:checked + .cols-option::after,
    body.dark .color-radio:checked + .color-preview::after {
      background: #8ab4f8;
      color: #062e6f;
    }

    /* Chips de giros */
    .giro-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.8rem;
      border-radius: 60px;
      background: var(--md-secondary-container);
      color: var(--md-on-secondary-container);
      font-size: 0.75rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .giro-chip .remove-giro {
      cursor: pointer;
      opacity: 0.5;
      transition: opacity 0.2s ease;
      background: none;
      border: none;
      font-size: 0.8rem;
      padding: 0 0.2rem;
      color: inherit;
    }
    .giro-chip .remove-giro:hover {
      opacity: 1;
    }

    /* Dropdown de giros */
    .giro-dropdown-item {
      display: block;
      width: 100%;
      text-align: left;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--md-on-surface);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .giro-dropdown-item:hover {
      background: var(--md-primary-container);
      color: var(--md-on-primary-container);
    }

    /* Mensajes de éxito/error */
    .toast-message {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.8rem 1.2rem;
      border-radius: var(--md-radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      animation: mPop 0.3s cubic-bezier(0.2, 0, 0, 1) both;
    }
    .toast-success {
      background: var(--md-secondary-container);
      border: 1px solid #a7d7b5;
      color: var(--md-on-secondary-container);
    }
    .toast-error {
      background: var(--md-error-container);
      border: 1px solid #f5c6cb;
      color: #8c1d18;
    }

    /* Ajustes modo oscuro */
    body.dark .config-input {
      background: #0d1117;
      border-color: #30363d;
      color: #e6edf3;
    }
    body.dark .config-input:focus {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 4px rgba(138, 180, 248, 0.15);
    }
    body.dark .config-label {
      color: #9aa7b4;
    }
    body.dark .giro-chip {
      background: #20334d;
      color: #d6e3ff;
    }
    body.dark .giro-dropdown-item:hover {
      background: #264f9e;
      color: #d6e3ff;
    }
    body.dark .toast-success {
      background: #1a3a2a;
      border-color: #2d6a4f;
      color: #b7e4c7;
    }
    body.dark .toast-error {
      background: #4c1d24;
      border-color: #8b2d32;
      color: #f8a5a0;
    }

    /* ===== Tarjetas de redes sociales ===== */
    .social-field {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border: 1.5px solid var(--md-outline-soft);
      border-radius: 14px;
      background: var(--md-surface);
      transition: border-color .2s, box-shadow .2s, transform .15s;
      position: relative;
    }
    .social-field:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px -8px rgba(0,0,0,.12);
    }
    .social-field:focus-within {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 4px rgba(79, 70, 229, .1);
    }
    .social-chip {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 19px;
      flex-shrink: 0;
      box-shadow: 0 4px 10px -3px rgba(0,0,0,.25);
    }
    .social-chip-ig {
      background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%) !important;
    }
    .social-body {
      flex: 1;
      min-width: 0;
    }
    .social-name {
      display: block;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--md-on-surface-variant);
      margin-bottom: 2px;
    }
    .social-field input {
      width: 100%;
      border: none;
      background: transparent;
      font-size: .85rem;
      color: var(--md-on-surface);
      outline: none;
      padding: 0;
      font-family: var(--md-font-family);
    }
    .social-field input::placeholder {
      color: var(--md-on-surface-variant);
      opacity: .5;
    }
    .social-done {
      position: absolute;
      top: -7px;
      right: -7px;
      font-size: 17px;
      color: #22c55e;
      background: var(--md-surface);
      border-radius: 50%;
      opacity: 0;
      transform: scale(.4);
      transition: opacity .25s, transform .25s cubic-bezier(.34,1.56,.64,1);
      pointer-events: none;
    }
    .social-field[data-filled="1"] .social-done {
      opacity: 1;
      transform: scale(1);
    }
    body.dark .social-field {
      background: #161b22;
      border-color: #30363d;
    }
    body.dark .social-field:focus-within {
      border-color: #8ab4f8;
      box-shadow: 0 0 0 4px rgba(138, 180, 248, .12);
    }
    body.dark .social-name {
      color: #9aa7b4;
    }
    body.dark .social-field input {
      color: #e6edf3;
    }
    body.dark .social-done {
      background: #161b22;
    }
  </style>
</head>
<body class="m-material bg-slate-100 min-h-screen dark:bg-[#0d1117]">
  <% if (!esMaestro) { %>
    <%- include('admin/sidebar', { biz, active: 'config', canDesign }) %>
  <% } else { %>
    <nav class="sticky top-0 z-50 bg-[#141210] text-white border-b border-white/10">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/maestro/panel" class="flex items-center gap-2 text-sm font-bold hover:text-slate-300 transition">
          ← Panel maestro
        </a>
        <span class="text-xs font-black uppercase tracking-wider text-emerald-400">Diseño de <%= biz.name %></span>
      </div>
    </nav>
  <% } %>

  <main class="transition-all duration-300">
    <div class="px-4 md:px-8 py-5 md:py-7 space-y-4">

      <!-- HEADER -->
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 class="text-xl md:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
            ⚙️ <%= esMaestro ? 'Diseño y datos de la tienda' : (canDesign ? 'Diseño y configuración' : 'Configuración') %>
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
            <%= esMaestro ? 'Controlas el diseño, las imágenes, los datos y el acceso de esta tienda.' : (canDesign ? 'Personaliza el diseño, los datos y el acceso de tu tienda.' : 'Cambia los datos y el acceso de tu tienda.') %>
          </p>
        </div>
        <a href="/<%= biz.slug %>" target="_blank" class="m-btn m-btn-tonal m-btn-sm dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/></svg>
          Ver catálogo
        </a>
      </div>

      <%
        const cfgAction = esMaestro ? '/maestro/' + biz.id + '/config' : '/' + biz.slug + '/admin/config';
        const prevSrc = esMaestro ? '/maestro/' + biz.id + '/preview' : '/' + biz.slug + '/admin/preview';
      %>

      <!-- MENSAJES (se muestran como toast de SweetAlert2) -->
      <% if (ok || error) { %>
        <div id="panel-msg" class="hidden" data-tipo="<%= ok ? 'ok' : 'error' %>"><%= ok || error %></div>
      <% } %>

      <!-- ============================================================
      SECCIÓN 1: DATOS DEL NEGOCIO
      ============================================================ -->
      <section class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
          </div>
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white">Datos del negocio</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Nombre, contacto y giro</p>
          </div>
        </div>

        <form method="POST" action="<%= cfgAction %>" class="space-y-4" id="form-datos">
          <input type="hidden" name="sections-current" value="<%= biz.sections || '{}' %>">
          <input type="hidden" name="sections" id="sections-json" value="">
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="config-label">Nombre del negocio *</label>
              <input name="name" value="<%= biz.name %>" class="config-input" placeholder="Ej: Ferretería El Toro" required>
            </div>
            <div>
              <label class="config-label">WhatsApp (10 dígitos) *</label>
              <input id="config-whatsapp" name="whatsapp" value="<%= biz.whatsapp %>" type="tel" inputmode="numeric" maxlength="10" class="config-input" placeholder="8712345678" required>
              <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los pedidos llegarán a este número.</p>
            </div>
            <div>
              <label class="config-label">Moneda</label>
              <select name="currency" class="config-input">
                <% CURRENCIES.forEach(c => { %>
                  <option value="<%= c.code %>" <%= biz.currency === c.code ? 'selected' : '' %>><%= c.symbol %> · <%= c.name %> (<%= c.code %>)</option>
                <% }) %>
              </select>
              <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los precios de tu catálogo y los pedidos usan esta moneda.</p>
            </div>
          </div>

          <% var _redes = {}; try { _redes = JSON.parse(biz.redes || '{}'); } catch(e) {} %>
          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
            <label class="config-label">Redes sociales</label>
            <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">Agrega los enlaces de tus redes para que aparezcan en tu catálogo.</p>
            <div class="grid md:grid-cols-3 gap-3">
              <div class="social-field" data-filled="<%= _redes.facebook ? '1' : '0' %>">
                <span class="social-chip" style="background:#1877f2;"><i class="bi bi-facebook"></i></span>
                <div class="social-body">
                  <label class="social-name">Facebook</label>
                  <input name="redes_facebook" value="<%= _redes.facebook || '' %>" placeholder="https://facebook.com/tu-pagina" autocomplete="off">
                </div>
                <i class="bi bi-check-circle-fill social-done" title="Configurada"></i>
              </div>
              <div class="social-field" data-filled="<%= _redes.instagram ? '1' : '0' %>">
                <span class="social-chip social-chip-ig"><i class="bi bi-instagram"></i></span>
                <div class="social-body">
                  <label class="social-name">Instagram</label>
                  <input name="redes_instagram" value="<%= _redes.instagram || '' %>" placeholder="@tu-cuenta o enlace" autocomplete="off">
                </div>
                <i class="bi bi-check-circle-fill social-done" title="Configurada"></i>
              </div>
              <div class="social-field" data-filled="<%= _redes.tiktok ? '1' : '0' %>">
                <span class="social-chip" style="background:#111111;"><i class="bi bi-tiktok"></i></span>
                <div class="social-body">
                  <label class="social-name">TikTok</label>
                  <input name="redes_tiktok" value="<%= _redes.tiktok || '' %>" placeholder="@tu-cuenta o enlace" autocomplete="off">
                </div>
                <i class="bi bi-check-circle-fill social-done" title="Configurada"></i>
              </div>
            </div>
          </div>

          <div>
            <label class="config-label">Descripción</label>
            <textarea name="description" rows="2" class="config-input" placeholder="¿Qué vende tu negocio?"><%= biz.description %></textarea>
          </div>

          <div>
            <label class="config-label">Mensaje personalizado de WhatsApp <span class="font-normal text-slate-400">(opcional)</span></label>
            <textarea name="wa_message" rows="4" class="config-input" placeholder="Déjalo vacío para usar el mensaje por defecto."><%= biz.wa_message || '' %></textarea>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Es el mensaje que recibe el cliente al pedir. Puedes usar <b>{tienda}</b>, <b>{productos}</b> y <b>{total}</b>.</p>
          </div>

          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
            <input type="hidden" name="horario_set" value="1">
            <div class="flex items-center justify-between mb-1 flex-wrap gap-2">
              <label class="config-label !mb-0">Horario de atención</label>
              <button type="button" onclick="copiarHorarioATodos()" class="text-xs font-bold text-blue-600 hover:text-blue-700">Copiar Lunes → días abiertos</button>
            </div>
            <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">Enciende los días que abres y marca su horario.</p>
            <% const diasSemana = [['1','Lunes'],['2','Martes'],['3','Miércoles'],['4','Jueves'],['5','Viernes'],['6','Sábado'],['7','Domingo']]; %>
            <div class="rounded-xl border border-slate-200 dark:border-[#30363d] overflow-hidden divide-y divide-slate-100 dark:divide-[#30363d]">
              <% diasSemana.forEach(d => { const diaData = horario[d[0]] || null; const isOpen = !!(diaData && diaData.o); %>
                <div class="dia-row flex items-center gap-2 sm:gap-3 px-3 py-2 bg-white dark:bg-slate-900/40" data-dia="<%= d[0] %>">
                  <label class="m-switch shrink-0" title="Abierto / cerrado">
                    <input type="checkbox" class="dia-open" data-dia="<%= d[0] %>" <%= isOpen ? 'checked' : '' %> onchange="toggleDia(this)">
                    <span class="track"><span class="thumb"></span></span>
                  </label>
                  <span class="w-20 shrink-0 text-xs font-bold <%= isOpen ? 'text-slate-700 dark:text-slate-200' : 'text-slate-400 dark:text-slate-500' %>"><%= d[1] %></span>
                  <input type="time" name="h_open_<%= d[0] %>" value="<%= diaData ? diaData.o : '' %>" <%= isOpen ? '' : 'disabled' %> class="flex-1 min-w-0 border border-slate-200 dark:border-[#30363d] rounded-lg px-2 py-1.5 text-sm bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-40">
                  <span class="text-slate-400 text-xs shrink-0">a</span>
                  <input type="time" name="h_close_<%= d[0] %>" value="<%= diaData ? diaData.c : '' %>" <%= isOpen ? '' : 'disabled' %> class="flex-1 min-w-0 border border-slate-200 dark:border-[#30363d] rounded-lg px-2 py-1.5 text-sm bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-40">
                </div>
              <% }) %>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-2">Los días apagados se mostrarán como "Cerrado" en tu tienda.</p>
          </div>

          <div>
            <label class="config-label">Mensaje cuando esté cerrado</label>
            <textarea name="horario_msg" rows="2" class="config-input" placeholder="Estamos cerrados. Recibimos tu pedido y te respondemos en cuanto abramos."><%= horarioMsg %></textarea>
          </div>

          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
            <label class="config-label">Dirección / ubicación <span class="font-normal text-slate-400">(opcional)</span></label>
            <input name="address" value="<%= (typeof address !== 'undefined' && address) || '' %>" class="config-input" placeholder="Ej: Av. Juárez 120, Centro, Torreón, Coah.">
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Si escribes la dirección, tu catálogo mostrará un mapa con esa ubicación. Vacío = no se muestra mapa.</p>
          </div>

          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
            <label class="config-label">Preguntas frecuentes <span class="font-normal text-slate-400">(opcional)</span></label>
            <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">Aparecen como desplegables en tu catálogo. Agrega las que quieras; si no pones ninguna, no se muestra esa sección.</p>

            <!-- Ejemplos guía (no se guardan) -->
            <div class="rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/40 px-4 py-3 mb-4">
              <p class="text-[11px] font-black uppercase tracking-wide text-amber-700 dark:text-amber-400 mb-1">Ejemplos — preguntas que suelen hacer los clientes</p>
              <div class="space-y-2">
                <details class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-[#30363d] rounded-lg overflow-hidden">
                  <summary style="list-style:none;" class="px-3 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center justify-between cursor-pointer select-none">
                    <span>¿Hacen envíos?</span><span class="text-slate-400 text-base leading-none">+</span>
                  </summary>
                  <p class="px-3 pb-3 text-xs text-slate-500 dark:text-slate-400">Sí, hacemos envíos a toda la ciudad. El costo depende de tu zona.</p>
                </details>
                <details class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-[#30363d] rounded-lg overflow-hidden">
                  <summary style="list-style:none;" class="px-3 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center justify-between cursor-pointer select-none">
                    <span>¿Cuál es su horario?</span><span class="text-slate-400 text-base leading-none">+</span>
                  </summary>
                  <p class="px-3 pb-3 text-xs text-slate-500 dark:text-slate-400">Atendemos de lunes a sábado de 8:00 am a 6:00 pm.</p>
                </details>
                <details class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-[#30363d] rounded-lg overflow-hidden">
                  <summary style="list-style:none;" class="px-3 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center justify-between cursor-pointer select-none">
                    <span>¿Aceptan tarjeta?</span><span class="text-slate-400 text-base leading-none">+</span>
                  </summary>
                  <p class="px-3 pb-3 text-xs text-slate-500 dark:text-slate-400">Sí, aceptamos efectivo, tarjeta y transferencia.</p>
                </details>
              </div>
              <p class="text-[11px] text-amber-600 dark:text-amber-500 mt-1.5">Estos ejemplos son solo de guía y no se guardan. Usa el botón de abajo para cargarlos y edítalos a tu gusto, o escribe tus propias preguntas.</p>
            </div>

            <div id="faq-rows" class="space-y-3"></div>
            <input type="hidden" name="faq" id="faq-json" value=''>

            <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
              <label class="config-label">Banner de campaña <span class="font-normal text-slate-400">(publicidad en tu catálogo)</span></label>
              <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">Una franja arriba de tu catálogo para anunciar promociones. Ejemplos: "🔥 Buen Fin: -30% en toda la tienda", "🎉 2x1 en pinturas esta semana", "⚡ Envío gratis en pedidos +$500". Déjalo vacío para no mostrar nada.</p>
              <input name="campaign_text" value="<%= (biz.sections && biz.sections.indexOf('campaign') !== -1 && (JSON.parse(biz.sections||'{}').campaign||{}).text) || '' %>" maxlength="120" class="config-input" placeholder="🔥 Buen Fin: -30% en toda la tienda">
              <div class="flex items-center gap-2 mt-2">
                <label class="text-xs font-semibold text-slate-600 dark:text-slate-300 shrink-0">Termina el</label>
                <input name="campaign_ends" type="date" value="<%= (biz.sections && (JSON.parse(biz.sections||'{}').campaign||{}).ends) || '' %>" class="border border-slate-200 dark:border-[#30363d] rounded-lg px-2 py-1.5 text-sm bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <span class="text-[11px] text-slate-400">(opcional — muestra cuenta regresiva)</span>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 mt-1">
              <button type="button" onclick="faqAgregarFila()" class="m-btn m-btn-outline m-btn-sm !text-blue-600 dark:!text-[#8ab4f8] dark:!border-[#8ab4f8] dark:hover:!bg-blue-500/10">
                ＋ Agregar pregunta
              </button>
              <button type="button" onclick="faqCargarEjemplos()" class="m-btn m-btn-outline m-btn-sm !text-amber-600 dark:!text-amber-400 dark:!border-amber-700 dark:hover:!bg-amber-500/10">
                📋 Usar ejemplos
              </button>
            </div>
          </div>

          <div class="flex gap-3 pt-2">
            <button class="m-btn m-btn-filled flex-1 !min-h-11 dark:bg-[#8ab4f8] dark:text-[#062e6f] dark:hover:bg-[#a0c4ff]">
              Guardar cambios
            </button>
          </div>
        </form>
      </section>

      <!-- ============================================================
      SECCIÓN 2: DISEÑO DEL CATÁLOGO (maestro o dueño con plan que lo incluya)
      ============================================================ -->
      <% if (canDesign) { %>
      <%
        const hdrRaw = biz.header || diseno.header;
        const hdrColor = /^#[0-9a-fA-F]{6}$/.test(hdrRaw || '') ? hdrRaw : ((hdrRaw || '').match(/#[0-9a-fA-F]{6}/) || ['#334155'])[0];
        const accentVal = biz.accent || diseno.accent || '#2563eb';
        const accent2Val = biz.accent2 || diseno.accent2 || accentVal;
        const headerTextVal = biz.header_text || diseno.headerText || '#ffffff';
      %>
      <section class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
          <div class="flex items-center gap-4 flex-wrap">
            <div class="w-12 h-12 rounded-xl bg-fuchsia-50 dark:bg-fuchsia-900/30 text-fuchsia-600 dark:text-fuchsia-400 flex items-center justify-center text-2xl shrink-0">🎨</div>
            <div class="flex-1 min-w-[200px]">
              <h2 class="font-extrabold text-slate-900 dark:text-white">Diseño del catálogo</h2>
              <p class="text-xs text-slate-400 dark:text-slate-500">Escoge el estilo visual de tu catálogo — colores, tipografía y formas. Los mismos elementos, distinta personalidad.</p>
            </div>
          </div>

          <% var _fontHrefs = Array.from(new Set(CAT_DESIGNS.map(function(d){ return d.tokens.font.href; }))); %>
          <% _fontHrefs.forEach(function(h) { %><link rel="stylesheet" href="<%= h %>"><% }) %>

          <form method="POST" action="<%= cfgAction %>" id="cat-design-form" class="mt-5">
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
              <% CAT_DESIGNS.forEach(function(d) { %>
              <% var t = d.tokens; %>
              <label class="cat-design-card relative block cursor-pointer rounded-2xl border-2 transition overflow-hidden <%= catDesign.id === d.id ? 'border-blue-500' : 'border-slate-200 dark:border-[#30363d] hover:border-slate-300 dark:hover:border-[#3d444d]' %>">
                <input type="radio" name="catalog_design" value="<%= d.id %>" class="sr-only" <%= catDesign.id === d.id ? 'checked' : '' %>>

                <!-- Preview: mini tarjeta de producto renderizada con la paleta y tipografía reales del estilo -->
                <div class="cat-design-preview" style="background:<%= t.bg %>;">
                  <div class="cdp-card" style="background:<%= t.card %>; border-radius:<%= Math.min(t.radius, 14) %>px; box-shadow:<%= t.shadow %>; border:1px solid <%= t.border %>;">
                    <div class="cdp-thumb" style="background:<%= t.accentGlow %>; border-radius:<%= Math.max(0, Math.min(t.radius, 14) - 4) %>px;"></div>
                    <div class="cdp-info">
                      <div class="cdp-heading" style="font-family:<%= t.font.heading %>; color:<%= t.text %>;">Producto</div>
                      <div class="cdp-body" style="font-family:<%= t.font.body %>; color:<%= t.textSec %>;">Desde $99</div>
                    </div>
                  </div>
                  <div class="cdp-btn" style="background:<%= t.accent %>; border-radius:<%= Math.min(t.radius, 10) %>px;"></div>
                </div>

                <div class="p-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm"><%= d.emoji %></span>
                    <% if (catDesign.id === d.id) { %><span class="text-[10px] font-black uppercase tracking-wider text-blue-600 bg-blue-100 dark:bg-blue-900/40 dark:text-blue-300 px-2 py-0.5 rounded-full">En uso</span><% } %>
                  </div>
                  <p class="font-extrabold text-sm text-slate-900 dark:text-white mt-1"><%= d.name %></p>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5"><%= d.desc %></p>
                </div>
              </label>
              <% }) %>
            </div>
            <input type="hidden" name="save_design_only" value="1">
            <button type="submit" class="m-btn m-btn-filled m-btn-sm mt-4">Guardar diseño</button>
          </form>
          <style>
            .cat-design-preview { display:flex; align-items:center; gap:8px; padding:12px; }
            .cdp-card { flex:1; min-width:0; display:flex; align-items:center; gap:8px; padding:8px; }
            .cdp-thumb { width:30px; height:30px; flex-shrink:0; }
            .cdp-info { min-width:0; flex:1; }
            .cdp-heading { font-size:12px; font-weight:700; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
            .cdp-body { font-size:11px; margin-top:2px; }
            .cdp-btn { width:26px; height:26px; flex-shrink:0; }
            .cat-design-card.border-blue-500 { box-shadow:0 0 0 3px rgba(59,130,246,.15); }
          </style>
          <script>
            (function () {
              var form = document.getElementById('cat-design-form');
              if (!form) return;
              // Al cambiar de radio, marca la tarjeta activa y envía solo este formulario
              var radios = form.querySelectorAll('input[name="catalog_design"]');
              radios.forEach(function (r) {
                r.addEventListener('change', function () {
                  form.querySelectorAll('.cat-design-card').forEach(function (c) {
                    var on = c.querySelector('input').checked;
                    c.classList.toggle('border-blue-500', on);
                    c.classList.toggle('bg-blue-50/40', on);
                    c.classList.toggle('dark:bg-blue-900/10', on);
                    c.classList.toggle('border-slate-200', !on);
                    c.classList.toggle('dark:border-[#30363d]', !on);
                  });
                });
              });
            })();
          </script>
        </section>

      <!-- ============================================================
      SECCIÓN 3: IMÁGENES
      ============================================================ -->
      <section class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M4 20h16M6 8h.01M6 8a2 2 0 100-4 2 2 0 000 4z"/></svg>
          </div>
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white">Imágenes</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Logo y banner de tu tienda</p>
          </div>
        </div>

        <form method="POST" action="<%= cfgAction %>" class="space-y-4">
          <div>
            <label class="config-label">Logo</label>
            <div class="flex items-center gap-3">
              <label class="cursor-pointer bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold px-4 py-2.5 rounded-xl transition text-slate-700 dark:text-slate-300">
                📷 Subir logo
                <input id="foto-logo" type="file" accept="image/*" class="hidden" onchange="subirConEditor('foto-logo', 'logo-url', 'prev-logo')">
              </label>
              <img id="prev-logo" src="<%= biz.logo || '/img/sin-imagen.svg' %>" class="w-12 h-12 rounded-full object-cover border border-slate-200 dark:border-[#30363d]">
            </div>
            <input name="logo" id="logo-url" type="hidden" value="<%= biz.logo || '' %>">
          </div>

          <div>
            <label class="config-label">Banner de portada <span class="text-slate-400 font-normal">(plantillas con portada)</span></label>
            <div class="flex items-center gap-3">
              <label class="cursor-pointer bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold px-4 py-2.5 rounded-xl transition text-slate-700 dark:text-slate-300">
                📷 Subir banner
                <input id="foto-banner" type="file" accept="image/*" class="hidden" onchange="subirConEditor('foto-banner', 'banner-url', 'prev-banner')">
              </label>
              <img id="prev-banner" src="<%= biz.banner || '/img/sin-imagen.svg' %>" class="w-16 h-10 rounded-lg object-cover border border-slate-200 dark:border-[#30363d]">
            </div>
            <input name="banner" id="banner-url" type="hidden" value="<%= biz.banner || '' %>">
          </div>

          <div class="flex gap-3 pt-2">
            <button class="m-btn m-btn-filled flex-1 !min-h-11 dark:bg-[#8ab4f8] dark:text-[#062e6f] dark:hover:bg-[#a0c4ff]">
              Guardar cambios
            </button>
          </div>
        </form>
      </section>
      <% } %>

      <!-- ============================================================
      SECCIÓN 4: SEGURIDAD (solo visible para el dueño)
      ============================================================ -->
      <% if (!esMaestro) { %>
      <section class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-red-50 dark:bg-red-900/30 text-red-500 dark:text-red-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white">Acceso seguro</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Tu PIN para entrar al panel</p>
          </div>
        </div>

        <form method="POST" action="/<%= biz.slug %>/admin/cambiar-pin" class="space-y-3 mb-6">
          <div class="grid md:grid-cols-3 gap-3">
            <input name="pin_actual" type="text" inputmode="numeric" placeholder="PIN actual" class="config-input" required>
            <input name="pin_nuevo" type="text" inputmode="numeric" placeholder="PIN nuevo (6 a 12 dígitos)" class="config-input" required>
            <input name="pin_repite" type="text" inputmode="numeric" placeholder="Repite el PIN nuevo" class="config-input" required>
          </div>
          <button class="m-btn m-btn-filled m-btn-sm dark:bg-[#8ab4f8] dark:text-[#062e6f] dark:hover:bg-[#a0c4ff]">
            Cambiar PIN
          </button>
        </form>

        <div class="border-t border-slate-200 dark:border-[#30363d] pt-4">
          <p class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">¿El dueño olvidó su PIN?</p>
          <form method="POST" action="/<%= biz.slug %>/admin/resetear-pin" class="flex flex-wrap gap-2">
            <input name="master" type="password" placeholder="Código maestro" class="config-input flex-1 max-w-xs" required>
            <button class="m-btn m-btn-danger m-btn-sm dark:bg-[#8b2d32] dark:text-white dark:hover:bg-[#a03a3f]">
              Resetear a 1234
            </button>
          </form>
        </div>
      </section>
      <% } %>

    </div>
  </main>

  <%- include('admin/panel-ajax') %>
  <%- include('admin/toast') %>
  <%- include('partials/upload-js', { biz, esMaestro }) %>

  <script>
    <% if (canDesign) { %>
    // Preview en vivo del color + cambio automático de modo al elegir un color
    (function () {
      function init() {
        var modeInputs = document.querySelectorAll('input[name="color_mode"]');
        var presetInputs = document.querySelectorAll('input[name="color"]');
        var hex1 = document.querySelector('input[name="color_hex"]');
        var hex2 = document.querySelector('input[name="color_hex2"]');
        var preview = document.getElementById('color-live-preview');
        function setMode(m) {
          modeInputs.forEach(function (r) { r.checked = r.value === m; });
        }
        function refresh() {
          var m = (document.querySelector('input[name="color_mode"]:checked') || {}).value;
          var h1 = (hex1 && hex1.value) || '#2563eb';
          var h2 = (hex2 && hex2.value) || h1;
          if (preview) preview.style.background = m === 'solido' ? h1 : 'linear-gradient(135deg, ' + h1 + ', ' + h2 + ')';
          var sw = document.getElementById('mode-solid-swatch');
          if (sw) sw.style.background = h1;
          var dw = document.getElementById('mode-degradado-swatch');
          if (dw) dw.style.background = 'linear-gradient(135deg, ' + h1 + ', ' + h2 + ')';
        }
        presetInputs.forEach(function (r) {
          r.addEventListener('change', function () { setMode('degradado'); refresh(); });
        });
        if (hex1) hex1.addEventListener('input', function () {
          var cur = (document.querySelector('input[name="color_mode"]:checked') || {}).value;
          if (cur === 'estilo') setMode('degradado');
          refresh();
        });
        if (hex2) hex2.addEventListener('input', function () { setMode('degradado'); refresh(); });
        modeInputs.forEach(function (r) { r.addEventListener('change', refresh); });
        refresh();
      }
      var prevSwap = window.onPanelSwap;
      window.onPanelSwap = function () { if (typeof prevSwap === 'function') prevSwap(); init(); };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();

    // Editor visual: vista previa en vivo + ajustes finos del diseño
    (function () {
      var ESTILOS = <%- safeJson(ESTILOS) %>;
      var SLUG = '<%= prevSrc %>';
      var NAMES = ['template', 'estilo', 'color', 'color_mode', 'color_hex', 'color_hex2', 'grid_cols', 'bg', 'card', 'text', 'muted', 'border', 'radius', 'font', 'header_text'];
      function init() {
        var form = document.getElementById('diseno-form');
        var iframe = document.getElementById('diseno-preview');
        if (!form || !iframe) return;
        var timer = null;
        function q(n) { return form.querySelector('[name="' + n + '"]'); }
        function qc(n) { return form.querySelector('[name="' + n + '"]:checked'); }
        // Valor inicial del color de botones: si no cambia, la vista previa usa el color elegido arriba
        var accentInit = (function () { var el = q('accent'); return el ? el.value : ''; })();
        var accent2Init = (function () { var el = q('accent2'); return el ? el.value : ''; })();
        window.updatePreview = function () {
          var f = document.getElementById('diseno-form');
          var fr = document.getElementById('diseno-preview');
          if (!f || !fr) return;
          var p = new URLSearchParams();
          NAMES.forEach(function (n) {
            var el = (f.querySelector('[name="' + n + '"]:checked') || f.querySelector('[name="' + n + '"]'));
            if (el && el.value !== '') p.append(n, el.value);
          });
          // Color de botones: solo se envía si el usuario lo cambió (si no, sigue el color elegido arriba)
          var a1 = q('accent'), a2 = q('accent2');
          if (a1 && a1.value !== accentInit) p.append('accent', a1.value);
          if (a2 && a2.value !== accent2Init) p.append('accent2', a2.value);
          // Cabecera: solo se envía si el usuario marcó "usar mi color propio"
          var hc = document.getElementById('header-user');
          var hcol = document.getElementById('header-color');
          if (hc && hcol) p.append('header', hc.checked ? hcol.value : '');
          // Logo y banner viven en la sección Imágenes; se reflejan en la vista previa
          var lg = document.getElementById('logo-url'); if (lg && lg.value) p.append('logo', lg.value);
          var bn = document.getElementById('banner-url'); if (bn && bn.value) p.append('banner', bn.value);
          fr.src = SLUG + '?' + p.toString();
        };
        // Cambia el ancho de la vista previa (celular / computadora)
        window.setPreviewDevice = function (btn) {
          var fr = document.getElementById('diseno-preview');
          if (!fr) return;
          var mobile = btn && btn.getAttribute('data-device') === 'mobile';
          fr.style.width = mobile ? '390px' : '100%';
          fr.classList.toggle('mx-auto', mobile);
        };
        function schedule() { clearTimeout(timer); timer = setTimeout(window.updatePreview, 150); }
        function updateRadiusLabel() {
          var rr = document.getElementById('radius-range');
          var lbl = document.getElementById('radius-label');
          if (rr && lbl) lbl.textContent = rr.value + 'px';
        }
        function setColor(name, val) {
          var el = q(name); if (!el) return;
          el.value = val;
          var sp = el.parentElement.querySelector('span');
          if (sp) sp.textContent = val;
        }
        function setFont(css) {
          var sel = q('font'); if (!sel) return;
          for (var i = 0; i < sel.options.length; i++) if (sel.options[i].value === css) { sel.selectedIndex = i; break; }
        }
        function aplicarEstilo(id) {
          var e = ESTILOS.find(function (x) { return x.id === id; });
          if (!e) return;
          setColor('bg', e.bg); setColor('card', e.card); setColor('text', e.text);
          setColor('muted', e.muted); setColor('border', e.border);
          setColor('header_text', e.headerText || '#ffffff');
          // Al cambiar de estilo la cabecera vuelve a usar el degradado del estilo
          var hc = document.getElementById('header-user');
          var hcol = document.getElementById('header-color');
          var hlbl = document.getElementById('header-color-label');
          if (hc) hc.checked = false;
          var hcolor = (e.header || '').match(/#[0-9a-fA-F]{6}/);
          var hv = (hcolor || ['#334155'])[0];
          if (hcol) hcol.value = hv;
          if (hlbl) hlbl.textContent = hv;
          var rr = document.getElementById('radius-range');
          var rv = document.getElementById('radius-val');
          if (rr) rr.value = parseInt(e.radius) || 16;
          if (rv) rv.value = e.radius;
          updateRadiusLabel();
          setFont(e.font);
          schedule();
        }
        ['bg', 'card', 'text', 'muted', 'border', 'accent', 'accent2', 'header_text'].forEach(function (n) {
          var el = q(n); if (!el) return;
          el.addEventListener('input', function () {
            var sp = el.parentElement.querySelector('span');
            if (sp) sp.textContent = el.value;
            schedule();
          });
        });
        var hcol = document.getElementById('header-color');
        if (hcol) hcol.addEventListener('input', function () {
          var hlbl = document.getElementById('header-color-label');
          if (hlbl) hlbl.textContent = hcol.value;
          schedule();
        });
        var huser = document.getElementById('header-user');
        if (huser) huser.addEventListener('change', schedule);
        var rr = document.getElementById('radius-range');
        if (rr) rr.addEventListener('input', function () {
          var rv = document.getElementById('radius-val');
          if (rv) rv.value = rr.value + 'px';
          updateRadiusLabel();
          schedule();
        });
        var fontSel = q('font');
        if (fontSel) fontSel.addEventListener('change', schedule);
        form.querySelectorAll('input[type="radio"]').forEach(function (r) {
          r.addEventListener('change', function () {
            if (r.name === 'estilo') aplicarEstilo(r.value);
            schedule();
          });
        });
        ['color_hex', 'color_hex2'].forEach(function (n) {
          var el = q(n); if (el) el.addEventListener('input', schedule);
        });
        // Al subir logo/banner se refresca la vista previa automáticamente
        ['logo-url', 'banner-url'].forEach(function (id) {
          var el = document.getElementById(id);
          if (el) el.addEventListener('change', window.updatePreview);
        });
        updateRadiusLabel();
        window.updatePreview();
      }
      var prevSwap = window.onPanelSwap;
      window.onPanelSwap = function () { if (typeof prevSwap === 'function') prevSwap(); init(); };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
    <% } %>

    // Muestra los mensajes de guardado como toast de SweetAlert2
    (function () {
      var t = document.getElementById('panel-msg');
      if (t && t.textContent.trim() && window.Swal && Swal.isLoaded) {
        var ok = t.getAttribute('data-tipo') === 'ok';
        Swal.fire({ toast: true, position: 'bottom', timer: 3000, timerProgressBar: true, showConfirmButton: false, icon: ok ? 'success' : 'error', title: t.textContent.trim() });
      }
    })();
  </script>

  <script>
    function toggleDia(cb) {
      var row = cb.closest('.dia-row');
      if (!row) return;
      row.querySelectorAll('input[type="time"]').forEach(function (i) { i.disabled = !cb.checked; });
      var label = row.querySelector('span');
      if (label) label.className = label.className.replace(/text-slate-700 dark:text-slate-200|text-slate-400 dark:text-slate-500/g, cb.checked ? 'text-slate-700 dark:text-slate-200' : 'text-slate-400 dark:text-slate-500');
    }
    function copiarHorarioATodos() {
      var lunes = document.querySelector('.dia-row[data-dia="1"]');
      if (!lunes) return;
      var o = lunes.querySelector('input[name="h_open_1"]').value;
      var c = lunes.querySelector('input[name="h_close_1"]').value;
      if (!o || !c) { mostrarToast('Primero pon el horario de Lunes', 'error'); return; }
      var n = 0;
      document.querySelectorAll('.dia-row').forEach(function (row) {
        var d = row.getAttribute('data-dia');
        var cb = row.querySelector('.dia-open');
        if (!cb || !cb.checked) return;
        var oi = row.querySelector('input[name="h_open_' + d + '"]');
        var ci = row.querySelector('input[name="h_close_' + d + '"]');
        if (oi) oi.value = o;
        if (ci) ci.value = c;
        n++;
      });
      mostrarToast('Horario copiado a ' + n + ' día(s) abierto(s) ✓', 'ok');
    }

    // ===== Editor de preguntas frecuentes =====
    var FAQ_INICIAL = <%- safeJson(typeof faqList !== 'undefined' ? faqList : []) %>;
    function faqCrearFila(q, a) {
      var wrap = document.createElement('div');
      wrap.className = 'faq-row rounded-xl border border-slate-200 dark:border-[#30363d] bg-white dark:bg-slate-900/40 p-3 space-y-2';
      var rowTop = document.createElement('div');
      rowTop.style.cssText = 'display:flex;gap:8px;align-items:center;';
      var lbl = document.createElement('span');
      lbl.className = 'text-xs font-black text-slate-400 dark:text-slate-500';
      lbl.textContent = 'Pregunta';
      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'ml-auto shrink-0 w-7 h-7 rounded-lg flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition';
      del.innerHTML = '✕';
      del.title = 'Quitar';
      del.addEventListener('click', function () { wrap.remove(); });
      rowTop.appendChild(lbl);
      rowTop.appendChild(del);
      var inp = document.createElement('input');
      inp.type = 'text';
      inp.className = 'config-input faq-q';
      inp.placeholder = 'Ej: ¿Hacen envíos?';
      inp.value = q || '';
      var ta = document.createElement('textarea');
      ta.rows = 2;
      ta.className = 'config-input faq-a';
      ta.placeholder = 'Escribe aquí la respuesta…';
      ta.value = a || '';
      wrap.appendChild(rowTop);
      wrap.appendChild(inp);
      wrap.appendChild(ta);
      return wrap;
    }
    function faqAgregarFila(q, a) {
      var c = document.getElementById('faq-rows');
      if (c) c.appendChild(faqCrearFila(q, a));
    }
    var FAQ_EJEMPLOS = [
      { q: '¿Hacen envíos?', a: 'Sí, hacemos envíos a toda la ciudad. El costo depende de tu zona.' },
      { q: '¿Cuál es su horario?', a: 'Atendemos de lunes a sábado de 8:00 am a 6:00 pm.' },
      { q: '¿Aceptan tarjeta?', a: 'Sí, aceptamos efectivo, tarjeta y transferencia.' },
      { q: '¿Puedo pagar a plazos?', a: 'Sí, algunos productos se pueden pagar en abonos. Pregunta por las condiciones.' },
      { q: '¿Puedo comprar por mayoreo?', a: 'Sí, manejamos precios especiales por mayoreo. Escríbenos para cotizarte.' },
      { q: '¿Entregan el mismo día?', a: 'Los pedidos confirmados antes de las 4:00 pm se entregan el mismo día en la ciudad.' }
    ];
    function faqCargarEjemplos() {
      var c = document.getElementById('faq-rows');
      if (!c) return;
      FAQ_EJEMPLOS.forEach(function (f) { faqAgregarFila(f.q, f.a); });
      if (window.mostrarToast) window.mostrarToast('Ejemplos cargados — edítalos a tu gusto', 'ok');
      c.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    function faqSerializar() {
      var filas = [];
      document.querySelectorAll('#faq-rows .faq-row').forEach(function (r) {
        var q = (r.querySelector('.faq-q').value || '').trim();
        var a = (r.querySelector('.faq-a').value || '').trim();
        if (q && a) filas.push({ q: q, a: a });
      });
      var h = document.getElementById('faq-json');
      if (h) h.value = JSON.stringify(filas);
    }
    (function () {
      var form = document.getElementById('form-datos');
      if (form) form.addEventListener('submit', function () {
        faqSerializar();
        // Serializa el banner de campaña dentro de sections (mismo POST)
        var sec = {};
        try { sec = JSON.parse(document.querySelector('input[name=sections-current]') ? document.querySelector('input[name=sections-current]').value : '{}'); } catch (e) {}
        sec.campaign = {
          text: (form.querySelector('input[name=campaign_text]') || {}).value || '',
          ends: (form.querySelector('input[name=campaign_ends]') || {}).value || ''
        };
        var h = document.getElementById('sections-json');
        if (h) h.value = JSON.stringify(sec);
      });
      (FAQ_INICIAL || []).forEach(function (f) { faqAgregarFila(f.q || '', f.a || ''); });
    })();
  </script>

  <style>
      </style>

  <%- include('partials/img-editor', { upUrl: (esMaestro ? '/maestro/' + biz.id + '/upload' : '/' + biz.slug + '/admin/upload'), z: 9000 }) %>
<script>
    function subirConEditor(inputId, campoId, previewId) {
      var input = document.getElementById(inputId);
      if (!input || !input.files || !input.files[0]) return;
      var f = input.files[0];
      var rd = new FileReader();
      rd.onload = function () {
        abrirEditorImagen(rd.result, function (url) {
          var campo = document.getElementById(campoId);
          if (campo) { campo.value = url; campo.dispatchEvent(new Event('change')); }
          var prev = document.getElementById(previewId);
          if (prev) prev.src = url;
          if (window.mostrarToast) mostrarToast('Imagen aplicada ✓', 'ok');
        });
      };
      rd.readAsDataURL(f);
      input.value = '';
    }

  </script>

  <script>
    // WhatsApp de ventas: máximo 10 dígitos, solo números
    (function () {
      var wa = document.getElementById('config-whatsapp');
      if (!wa) return;
      wa.addEventListener('input', function () {
        var v = this.value.replace(/[^0-9]/g, '');
        if (v.length > 10) v = v.slice(0, 10);
        this.value = v;
      });
    })();
    // Redes sociales: marca la tarjeta como configurada cuando el campo tiene contenido
    document.querySelectorAll('.social-field input').forEach(function (inp) {
      inp.addEventListener('input', function () {
        this.closest('.social-field').setAttribute('data-filled', this.value.trim() ? '1' : '0');
      });
    });
  </script>
</body>
