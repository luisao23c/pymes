  <!-- Editor de imagen (logo / banner) -->
  <div class="img-editor-overlay" id="img-editor">
    <div class="img-editor-modal">
      <div class="img-editor-head">✏️ Editar imagen <button type="button" onclick="cerrarEditorImagen()">✕</button></div>
      <div class="img-editor-body">
        <div id="img-editor-wrap" class="img-editor-wrap">
          <canvas id="img-editor-canvas" width="800" height="800" class="img-editor-canvas"></canvas>
        </div>
        <div class="img-editor-tools">
          <button type="button" id="img-btn-fit" onclick="imgModo('contain')">Ajustar</button>
          <button type="button" id="img-btn-cover" onclick="imgModo('cover')">Expandir</button>
          <span class="img-hint" style="flex:1;text-align:right;">Arrastra para mover</span>
        </div>
        <div class="img-editor-tools">
          <span class="img-hint">Aspecto</span>
          <button type="button" class="img-aspect" data-a="1:1" onclick="imgAspect('1:1')">1:1</button>
          <button type="button" class="img-aspect" data-a="4:3" onclick="imgAspect('4:3')">4:3</button>
          <button type="button" class="img-aspect" data-a="16:9" onclick="imgAspect('16:9')">16:9</button>
          <button type="button" class="img-aspect" data-a="3:4" onclick="imgAspect('3:4')">3:4</button>
          <span class="img-sep">|</span>
          <button type="button" onclick="imgRotar()" title="Rotar 90°">⟳ Rotar</button>
          <button type="button" onclick="imgEspejo()" title="Voltear horizontal">⇋ Voltear</button>
          <button type="button" onclick="imgReset()" title="Restaurar original">↺ Restaurar</button>
        </div>
        <div class="img-editor-zoom">
          <span class="img-hint">Zoom</span>
          <input id="img-zoom" type="range" min="1" max="3" step="0.01" value="1" oninput="imgZoomChange(this.value)">
        </div>
        <div class="img-editor-foot">
          <button type="button" onclick="cerrarEditorImagen()">Cancelar</button>
          <button type="button" class="btn-primary" onclick="aplicarEditorImagen()">Aplicar</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    var imgEditor = { img: null, mode: 'cover', zoom: 1, panX: 0, panY: 0, baseScale: 1, rotation: 0, flip: false, aspect: '1:1' };
    var _imgOnDone = null;
    var _imgOnCancel = null;
    var IMG_UP_URL = '<%= esMaestro ? "/maestro/" + biz.id + "/upload" : "/" + biz.slug + "/admin/upload" %>';
    function imgOutSize() {
      switch (imgEditor.aspect) {
        case '4:3': return { W: 800, H: 600 };
        case '16:9': return { W: 800, H: 450 };
        case '3:4': return { W: 600, H: 800 };
        default: return { W: 800, H: 800 };
      }
    }
    function imgEff() {
      var img = imgEditor.img;
      var rotated = imgEditor.rotation % 180 !== 0;
      return { iw: rotated ? img.height : img.width, ih: rotated ? img.width : img.height };
    }
    function abrirEditorImagen(src, onDone, onCancel) {
      if (!src) return;
      _imgOnDone = onDone || null;
      _imgOnCancel = onCancel || null;
      var img = new Image();
      img.onload = function () {
        imgEditor.img = img;
        imgEditor.zoom = 1; imgEditor.panX = 0; imgEditor.panY = 0;
        imgEditor.mode = 'cover'; imgEditor.rotation = 0; imgEditor.flip = false; imgEditor.aspect = '1:1';
        var z = document.getElementById('img-zoom'); if (z) z.value = 1;
        document.querySelectorAll('.img-aspect').forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-a') === '1:1'); });
        document.getElementById('img-editor').classList.add('open');
        document.body.style.overflow = 'hidden';
        imgModo('cover');
      };
      img.onerror = function () { if (window.mostrarToast) mostrarToast('No se pudo cargar la imagen', 'error'); };
      img.src = src;
    }
    function imgRecalc() {
      var img = imgEditor.img; if (!img) return;
      var sz = imgOutSize();
      var eff = imgEff();
      var s;
      if (imgEditor.mode === 'contain') { s = Math.min(sz.W / eff.iw, sz.H / eff.ih); var zz = document.getElementById('img-zoom'); if (zz) zz.disabled = true; }
      else { s = Math.max(sz.W / eff.iw, sz.H / eff.ih); var z2 = document.getElementById('img-zoom'); if (z2) z2.disabled = false; }
      imgEditor.baseScale = s;
      imgEditor.panX = 0; imgEditor.panY = 0;
      imgDraw();
    }
    function imgModo(m) {
      imgEditor.mode = m;
      var fit = document.getElementById('img-btn-fit');
      var cover = document.getElementById('img-btn-cover');
      if (fit) fit.classList.toggle('on', m === 'contain');
      if (cover) cover.classList.toggle('on', m === 'cover');
      imgEditor.zoom = 1;
      var z = document.getElementById('img-zoom'); if (z) z.value = 1;
      imgRecalc();
    }
    function imgAspect(a) {
      imgEditor.aspect = a;
      document.querySelectorAll('.img-aspect').forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-a') === a); });
      imgEditor.zoom = 1;
      var z = document.getElementById('img-zoom'); if (z) z.value = 1;
      imgRecalc();
    }
    function imgRotar() { imgEditor.rotation = (imgEditor.rotation + 90) % 360; imgRecalc(); }
    function imgEspejo() { imgEditor.flip = !imgEditor.flip; imgDraw(); }
    function imgReset() {
      imgEditor.rotation = 0; imgEditor.flip = false; imgEditor.aspect = '1:1';
      document.querySelectorAll('.img-aspect').forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-a') === '1:1'); });
      imgEditor.mode = 'cover';
      imgModo('cover');
    }
    function imgZoomChange(v) { imgEditor.zoom = parseFloat(v); imgClamp(); imgDraw(); }
    function imgDraw() {
      var canvas = document.getElementById('img-editor-canvas');
      var img = imgEditor.img;
      if (!canvas || !img) return;
      var sz = imgOutSize();
      if (canvas.width !== sz.W) canvas.width = sz.W;
      if (canvas.height !== sz.H) canvas.height = sz.H;
      var ctx = canvas.getContext('2d');
      var eff = imgEff();
      var scale = imgEditor.baseScale * imgEditor.zoom;
      ctx.clearRect(0, 0, sz.W, sz.H);
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, sz.W, sz.H);
      ctx.save();
      ctx.translate(sz.W / 2, sz.H / 2);
      if (imgEditor.flip) ctx.scale(-1, 1);
      if (imgEditor.rotation) ctx.rotate(imgEditor.rotation * Math.PI / 180);
      ctx.drawImage(img, imgEditor.panX - (eff.iw * scale) / 2, imgEditor.panY - (eff.ih * scale) / 2, eff.iw * scale, eff.ih * scale);
      ctx.restore();
    }
    function imgClamp() {
      var img = imgEditor.img; if (!img) return;
      if (imgEditor.mode !== 'cover') { imgEditor.panX = 0; imgEditor.panY = 0; return; }
      var sz = imgOutSize();
      var eff = imgEff();
      var scale = imgEditor.baseScale * imgEditor.zoom;
      var w = eff.iw * scale, h = eff.ih * scale;
      var maxX = Math.max(0, (w - sz.W) / 2);
      var maxY = Math.max(0, (h - sz.H) / 2);
      imgEditor.panX = Math.min(maxX, Math.max(-maxX, imgEditor.panX));
      imgEditor.panY = Math.min(maxY, Math.max(-maxY, imgEditor.panY));
    }
    function imgInitDrag() {
      var wrap = document.getElementById('img-editor-wrap');
      if (!wrap) return;
      var dragging = false, sx = 0, sy = 0, sox = 0, soy = 0;
      function start(e) {
        if (imgEditor.mode !== 'cover') return;
        dragging = true;
        var p = e.touches && e.touches.length ? e.touches[0] : e;
        sx = p.clientX; sy = p.clientY;
        sox = imgEditor.panX; soy = imgEditor.panY;
        e.preventDefault();
      }
      function move(e) {
        if (!dragging) return;
        var p = e.touches && e.touches.length ? e.touches[0] : e;
        var sz = imgOutSize();
        var rect = wrap.getBoundingClientRect();
        var kx = sz.W / rect.width;
        var ky = sz.H / rect.height;
        imgEditor.panX = sox + (p.clientX - sx) * kx;
        imgEditor.panY = soy + (p.clientY - sy) * ky;
        imgClamp();
        imgDraw();
      }
      function end() { dragging = false; }
      wrap.addEventListener('mousedown', start);
      window.addEventListener('mousemove', move);
      window.addEventListener('mouseup', end);
      wrap.addEventListener('touchstart', start, { passive: false });
      window.addEventListener('touchmove', move, { passive: false });
      window.addEventListener('touchend', end);
    }
    function aplicarEditorImagen() {
      var canvas = document.getElementById('img-editor-canvas');
      if (!canvas || !imgEditor.img) return;
      canvas.toBlob(function (blob) {
        if (!blob) { if (window.mostrarToast) mostrarToast('No se pudo procesar la imagen', 'error'); return; }
        var cb = _imgOnDone; var cc = _imgOnCancel;
        _imgOnDone = null; _imgOnCancel = null;
        var fd = new FormData();
        fd.append('foto', blob, 'editada.png');
        var tok = (window.__csrfValue && window.__csrfValue()) || '';
        if (tok) fd.append('_csrf', tok);
        fetch(IMG_UP_URL, { method: 'POST', body: fd, headers: tok ? { 'x-csrf-token': tok } : {} })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            cerrarEditorImagen();
            if (d && d.url && cb) cb(d.url);
            else { if (window.mostrarToast) mostrarToast('No se pudo guardar la imagen', 'error'); if (cc) cc(); }
          })
          .catch(function () { cerrarEditorImagen(); if (window.mostrarToast) mostrarToast('Error al guardar la imagen', 'error'); if (cc) cc(); });
      }, 'image/png');
    }
    function cerrarEditorImagen() {
      var cc = _imgOnCancel;
      _imgOnDone = null; _imgOnCancel = null;
      document.getElementById('img-editor').classList.remove('open');
      document.body.style.overflow = '';
      if (cc) cc();
    }
    function subirConEditor(inputId, campoId, previewId) {
      var input = document.getElementById(inputId);
      if (!input || !input.files || !input.files[0]) return;
      var f = input.files[0];
      var rd = new FileReader();
      rd.onload = function () {
        abrirEditorImagen(rd.result, function (url) {
          var campo = document.getElementById(campoId);
          if (campo) { campo.value = url; campo.dispatchEvent(new Event('change')); }
          var prev = document.getElementById(previewId);
          if (prev) prev.src = url;
          if (window.mostrarToast) mostrarToast('Imagen aplicada ✓', 'ok');
        });
      };
      rd.readAsDataURL(f);
      input.value = '';
    }
    imgInitDrag();
  </script>
</body>
</html>
