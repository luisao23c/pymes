<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Asignar columnas', biz }) %>
</head>
<body class="m-material min-h-screen" style="background:var(--ap-bg);color:var(--ap-text)">
  <%- include('admin/sidebar', { biz, active: 'importar' }) %>

  <main class="md:pl-60">
    <div class="max-w-4xl mx-auto px-3 md:px-6 py-4 md:py-5 space-y-3">

      <%- include('admin/page-header', {
        icon: 'M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11',
        title: 'Asignar columnas',
        subtitle: 'Dile al sistema qué es cada columna de <b style="color:var(--ap-text)">tu archivo</b>.',
        actions: '<a href="/' + biz.slug + '/admin/importar" class="m-btn m-btn-outlined m-btn-sm">← Cambiar archivo</a>'
      }) %>

      <% if (resultado) { %>
        <div class="rounded-xl p-4 m-pop bg-amber-50 border border-amber-200">
          <p class="font-black text-amber-700 text-sm mb-2">⚠ Revisa antes de importar</p>
          <div class="max-h-64 overflow-y-auto m-scroll space-y-1">
            <% resultado.errores.forEach(e => { %>
              <p class="text-xs text-red-600"><%= e %></p>
            <% }) %>
          </div>
        </div>
      <% } %>

      <section class="m-card p-4">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-full text-white flex items-center justify-center font-black text-sm shrink-0" style="background:var(--ap-accent)">2</div>
          <div>
            <h2 class="font-extrabold" style="color:var(--ap-text)">Di qué es cada columna</h2>
            <p class="text-xs" style="color:var(--ap-text-sec)">Encontramos <b style="color:var(--ap-text)"><%= totalRows %> filas</b> · <b style="color:var(--ap-text)"><%= headers.length %> columnas</b> en tu archivo</p>
          </div>
        </div>

        <div class="mb-4 flex items-start gap-2 rounded-xl p-3 text-xs" style="background:var(--ap-bg);border:1px solid var(--ap-border);color:var(--ap-text)">
          <span class="shrink-0">💡</span>
          <span><b>Nombre</b> y <b>precio</b> son obligatorios. El resto puedes dejarlo vacío. Las columnas ya detectadas aparecen con <span class="font-bold">✓</span>.</span>
        </div>

        <form method="POST" action="/<%= biz.slug %>/admin/importar/ejecutar" class="space-y-2" id="importar-form">
          <input type="hidden" name="token" value="<%= token %>">

          <% FIELD_OPTIONS.forEach((f, fi) => {
            const colIdx = mapped.indexOf(f.value);
            const sample = colIdx > -1 && preview.length ? preview[0][headers[colIdx]] : '';
          %>
            <div class="grid grid-cols-1 sm:grid-cols-[1fr_1.6fr] gap-2 items-center py-2 border-b last:border-0" style="border-color:var(--ap-border)">
              <label class="text-sm font-bold flex items-center gap-1.5" style="color:var(--ap-text)">
                <%= f.label %>
                <% if (f.required) { %><span class="text-red-500">*</span><% } %>
                <% if (colIdx > -1) { %><span class="m-badge m-badge-success !h-5 !text-[10px]">✓</span><% } %>
              </label>
              <div>
                <select name="<%= f.value %>" class="w-full border <%= f.required && colIdx === -1 ? 'border-red-300 bg-red-50/40' : '' %> rounded-xl px-3 py-2 text-sm outline-none transition" style="<%= f.required && colIdx === -1 ? '' : 'border-color:var(--ap-border)' %>background:var(--ap-card);color:var(--ap-text)">
                  <option value="">— No usar / dejar vacío —</option>
                  <% headers.forEach((h, i) => { %>
                    <option value="<%= i %>" <%= (mapped[i] === f.value) ? 'selected' : '' %>><%= (i + 1) %>. <%= h %></option>
                  <% }) %>
                </select>
                <% if (sample) { %>
                  <p class="text-[10px] mt-0.5 truncate" style="color:var(--ap-text-sec)">Ej.: "<%= sample %>"</p>
                <% } %>
              </div>
            </div>
          <% }) %>

          <button class="m-btn m-btn-filled w-full !min-h-11 mt-3">
            Importar <%= totalRows %> producto(s)
          </button>
        </form>
      </section>

      <!-- Vista previa -->
      <section class="m-card p-4">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
          <h3 class="font-extrabold text-sm" style="color:var(--ap-text)">Vista previa de tu archivo</h3>
          <span class="m-badge m-badge-neutral">primeras <%= preview.length %> filas</span>
        </div>
        <div class="overflow-x-auto rounded-xl border" style="border-color:var(--ap-border)">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs border-b" style="color:var(--ap-text-sec);background:var(--ap-bg);border-color:var(--ap-border)">
                <th class="py-2 px-4 font-bold">#</th>
                <% headers.forEach((h, i) => { %>
                  <th class="py-2 px-4 font-bold" style="<%= mapped[i] ? 'color:var(--ap-accent-text)' : '' %>"><%= h %><% if (mapped[i]) { %><span class="ml-1 font-black">✓</span><% } %></th>
                <% }) %>
              </tr>
            </thead>
            <tbody style="color:var(--ap-text-sec)">
              <% preview.forEach((row, ri) => { %>
                <tr class="border-b last:border-0 transition" style="border-color:var(--ap-border)">
                  <td class="py-2 px-4" style="color:var(--ap-text-sec);opacity:.6"><%= ri + 2 %></td>
                  <% headers.forEach(h => { %>
                    <td class="py-2 px-4 max-w-[180px] truncate"><%= row[h] !== undefined && row[h] !== '' ? row[h] : '—' %></td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </main>
  <script>
    document.getElementById('importar-form').addEventListener('submit', function (e) {
      e.preventDefault();
      Swal.fire({
        title: '¿Importar productos?',
        text: 'Se importarán <%= totalRows %> producto(s) con este mapeo.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Sí, importar',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#2563eb'
      }).then(function (r) {
        if (r.isConfirmed) e.target.submit();
      });
    });
  </script>
</body>
</html>
