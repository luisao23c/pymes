<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Asignar columnas', biz }) %>
</head>
<body class="m-material bg-slate-100 min-h-screen">
  <%- include('admin/sidebar', { biz, active: 'importar' }) %>

  <main class="md:pl-60">
    <div class="max-w-4xl mx-auto px-3 md:px-6 py-4 md:py-5 space-y-3">

      <div class="flex items-center justify-between flex-wrap gap-2">
        <div>
          <h1 class="text-lg md:text-xl font-black tracking-tight text-slate-900">Asignar columnas</h1>
          <p class="text-xs text-slate-500 mt-0.5">Dile al sistema qué es cada columna de <b class="text-slate-700">tu archivo</b>.</p>
        </div>
        <a href="/<%= biz.slug %>/admin/importar" class="m-btn m-btn-outlined m-btn-sm">← Cambiar archivo</a>
      </div>

      <% if (resultado) { %>
        <div class="rounded-xl p-4 m-pop bg-amber-50 border border-amber-200">
          <p class="font-black text-amber-700 text-sm mb-2">⚠ Revisa antes de importar</p>
          <div class="max-h-64 overflow-y-auto m-scroll space-y-1">
            <% resultado.errores.forEach(e => { %>
              <p class="text-xs text-red-600"><%= e %></p>
            <% }) %>
          </div>
        </div>
      <% } %>

      <section class="m-card p-4">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-full bg-[var(--md-primary)] text-white flex items-center justify-center font-black text-sm shrink-0">2</div>
          <div>
            <h2 class="font-extrabold text-slate-900">Di qué es cada columna</h2>
            <p class="text-xs text-slate-400">Encontramos <b class="text-slate-600"><%= totalRows %> filas</b> · <b class="text-slate-600"><%= headers.length %> columnas</b> en tu archivo</p>
          </div>
        </div>

        <div class="mb-4 flex items-start gap-2 bg-[var(--md-secondary-container)] rounded-xl p-3 text-xs text-[var(--md-on-secondary-container)]">
          <span class="shrink-0">💡</span>
          <span><b>Nombre</b> y <b>precio</b> son obligatorios. El resto puedes dejarlo vacío. Las columnas ya detectadas aparecen con <span class="font-bold">✓</span>.</span>
        </div>

        <form method="POST" action="/<%= biz.slug %>/admin/importar/ejecutar" class="space-y-2" id="importar-form">
          <input type="hidden" name="token" value="<%= token %>">

          <% FIELD_OPTIONS.forEach((f, fi) => {
            const colIdx = mapped.indexOf(f.value);
            const sample = colIdx > -1 && preview.length ? preview[0][headers[colIdx]] : '';
          %>
            <div class="grid grid-cols-1 sm:grid-cols-[1fr_1.6fr] gap-2 items-center py-2 border-b border-slate-100 last:border-0">
              <label class="text-sm font-bold text-slate-700 flex items-center gap-1.5">
                <%= f.label %>
                <% if (f.required) { %><span class="text-red-500">*</span><% } %>
                <% if (colIdx > -1) { %><span class="m-badge m-badge-success !h-5 !text-[10px]">✓</span><% } %>
              </label>
              <div>
                <select name="<%= f.value %>" class="w-full border <%= f.required && colIdx === -1 ? 'border-red-300 bg-red-50/40' : 'border-slate-200' %> rounded-xl px-3 py-2 text-sm bg-white focus:border-blue-400 focus:ring-2 focus:ring-blue-100 outline-none transition">
                  <option value="">— No usar / dejar vacío —</option>
                  <% headers.forEach((h, i) => { %>
                    <option value="<%= i %>" <%= (mapped[i] === f.value) ? 'selected' : '' %>><%= (i + 1) %>. <%= h %></option>
                  <% }) %>
                </select>
                <% if (sample) { %>
                  <p class="text-[10px] text-slate-400 mt-0.5 truncate">Ej.: "<%= sample %>"</p>
                <% } %>
              </div>
            </div>
          <% }) %>

          <button class="m-btn m-btn-filled w-full !min-h-11 mt-3">
            Importar <%= totalRows %> producto(s)
          </button>
        </form>
      </section>

      <!-- Vista previa -->
      <section class="m-card p-4">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
          <h3 class="font-extrabold text-slate-900 text-sm">Vista previa de tu archivo</h3>
          <span class="m-badge m-badge-neutral">primeras <%= preview.length %> filas</span>
        </div>
        <div class="overflow-x-auto rounded-xl border border-slate-100">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs text-slate-500 bg-slate-50 border-b border-slate-200">
                <th class="py-2 px-4 font-bold">#</th>
                <% headers.forEach((h, i) => { %>
                  <th class="py-2 px-4 font-bold <%= mapped[i] ? 'text-[var(--md-primary)]' : '' %>"><%= h %><% if (mapped[i]) { %><span class="ml-1 font-black">✓</span><% } %></th>
                <% }) %>
              </tr>
            </thead>
            <tbody class="text-slate-600">
              <% preview.forEach((row, ri) => { %>
                <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50/50 transition">
                  <td class="py-2 px-4 text-slate-400"><%= ri + 2 %></td>
                  <% headers.forEach(h => { %>
                    <td class="py-2 px-4 max-w-[180px] truncate"><%= row[h] !== undefined && row[h] !== '' ? row[h] : '—' %></td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </main>
  <script>
    document.getElementById('importar-form').addEventListener('submit', function (e) {
      e.preventDefault();
      Swal.fire({
        title: '¿Importar productos?',
        text: 'Se importarán <%= totalRows %> producto(s) con este mapeo.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Sí, importar',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#2563eb'
      }).then(function (r) {
        if (r.isConfirmed) e.target.submit();
      });
    });
  </script>
</body>
</html>
