<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Empleados', biz }) %>
</head>
<body class="m-material bg-slate-100 min-h-screen">
  <%- include('admin/sidebar', { biz, active: 'empleados', canDesign }) %>

  <main class="md:pl-60">
    <div class="max-w-3xl mx-auto px-3 md:px-6 py-4 md:py-5 pb-24 md:pb-6">

      <div class="mb-4">
        <h1 class="text-lg md:text-xl font-black tracking-tight text-slate-900">Empleados</h1>
        <p class="text-xs text-slate-500 mt-0.5">Cada empleado tiene su propio PIN y permisos.</p>
      </div>

      <% if (ok) { %>
        <div class="mb-3 bg-emerald-50 text-emerald-700 text-sm font-bold px-4 py-3 rounded-xl m-pop">Guardado ✓</div>
      <% } %>
      <% if (error) { %>
        <div class="mb-3 bg-red-50 text-red-600 text-sm font-bold px-4 py-3 rounded-xl m-pop">⚠️ <%= error %></div>
      <% } %>

      <!-- Formulario (crear / editar) -->
      <section class="m-card p-4 mb-3">
        <div class="flex items-center justify-between mb-3">
          <h2 id="emp-form-title" class="font-extrabold text-slate-900 text-sm">Agregar empleado</h2>
          <button type="button" id="emp-cancel" onclick="cancelarEdicionEmpleado()" class="hidden text-xs font-bold text-red-500 hover:bg-red-50 px-3 py-1.5 rounded-full transition">✕ Cancelar edición</button>
        </div>
        <form method="POST" action="/<%= biz.slug %>/admin/empleado" id="emp-form" class="space-y-3">
          <input type="hidden" name="emp_id" id="emp-id" value="<%= formId || '' %>">
          <div class="grid sm:grid-cols-2 gap-3">
            <div class="m-field">
              <label for="emp-name">Nombre *</label>
              <input name="name" id="emp-name" required value="<%= formName || '' %>" placeholder="Ej: Ana García">
            </div>
            <div class="m-field">
              <label for="emp-pin">PIN de acceso *</label>
              <input name="pin" id="emp-pin" required type="text" inputmode="numeric" maxlength="12" placeholder="4 a 12 dígitos">
              <p class="text-[10px] text-slate-400 mt-0.5" id="emp-pin-hint">Para editar, déjalo vacío y conserva el PIN actual.</p>
            </div>
          </div>
          <div>
            <p class="font-bold text-xs text-slate-600 mb-1.5">Permisos</p>
            <div class="space-y-2">
              <% const modules = [...new Set(EMPLOYEE_PERMS.map(p => p.module))]; %>
              <% modules.forEach(m => { %>
                <div class="rounded-xl border border-slate-100 p-2.5">
                  <p class="text-xs font-bold text-slate-700 mb-1.5"><%= m %></p>
                  <div class="flex flex-wrap gap-2">
                    <% EMPLOYEE_PERMS.filter(p => p.module === m).forEach(p => { %>
                      <label class="flex items-center gap-1.5 text-sm text-slate-700 cursor-pointer">
                        <input type="checkbox" name="perms" value="<%= p.key %>" class="w-4 h-4 accent-blue-600" <%= (typeof formPerms !== 'undefined' && formPerms.includes(p.key)) ? 'checked' : '' %>>
                        <%= p.label %>
                      </label>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
            <p class="text-[11px] text-slate-400 mt-1.5">Si no marcas nada, el empleado no verá ninguna sección.</p>
          </div>
          <button id="emp-submit" class="m-btn m-btn-filled w-full !min-h-11">Agregar empleado</button>
        </form>
      </section>

      <!-- Lista -->
      <section class="m-card p-4">
        <h2 class="font-extrabold text-slate-900 text-sm mb-3">Tus empleados <span class="m-badge m-badge-neutral !ml-1"><%= employees.length %></span></h2>
        <% if (employees.length === 0) { %>
          <p class="text-xs text-slate-400">Aún no tienes empleados.</p>
        <% } else { %>
          <div class="space-y-2">
            <% employees.forEach(e => { %>
              <div class="flex items-center gap-3 p-3 rounded-xl border border-slate-100">
                <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-black shrink-0"><%= e.name.charAt(0).toUpperCase() %></div>
                <div class="flex-1 min-w-0">
                  <p class="font-bold text-sm text-slate-800"><%= e.name %></p>
                  <div class="flex flex-wrap gap-1 mt-0.5">
                    <% if (e.perms.length === 0) { %><span class="text-[10px] text-slate-400">Sin permisos</span><% } %>
                    <% e.perms.forEach(pk => { const p = EMPLOYEE_PERMS.find(x => x.key === pk); if (p) { %><span class="m-badge !h-5 !text-[10px] m-badge-primary"><%= p.label %></span><% } }) %>
                  </div>
                </div>
                <button type="button" onclick="editarEmpleado(<%= e.id %>)" class="m-btn m-btn-sm m-btn-outlined !min-h-0 !py-1.5">✎ Editar</button>
                <form method="POST" action="/<%= biz.slug %>/admin/empleado/<%= e.id %>/eliminar" data-confirm="¿Quitar a <%= e.name %>?">
                  <button class="m-btn-icon !w-8 !h-8 hover:!bg-red-50 hover:!text-red-500" title="Eliminar">🗑</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

    </div>
  </main>

  <%- include('admin/panel-ajax') %>
  <%- include('admin/toast') %>

  <script>
    var EMPLEADOS = <%- safeJson(employees.map(e => ({ id: e.id, name: e.name, perms: e.perms }))) %>;

    function editarEmpleado(id) {
      var e = EMPLEADOS.find(function (x) { return x.id === id; });
      if (!e) return;
      document.getElementById('emp-id').value = id;
      document.getElementById('emp-name').value = e.name;
      document.getElementById('emp-pin').value = '';
      document.getElementById('emp-pin').removeAttribute('required');
      document.getElementById('emp-pin-hint').textContent = 'Déjalo vacío para conservar el PIN actual (o escribe uno nuevo).';
      document.querySelectorAll('#emp-form [name="perms"]').forEach(function (cb) { cb.checked = (e.perms.indexOf(cb.value) !== -1); });
      document.getElementById('emp-form').action = '/<%= biz.slug %>/admin/empleado/' + id;
      document.getElementById('emp-form-title').textContent = 'Editar empleado';
      document.getElementById('emp-submit').textContent = 'Guardar cambios';
      document.getElementById('emp-cancel').classList.remove('hidden');
      document.getElementById('emp-form').scrollIntoView({ behavior: 'auto', block: 'start' });
    }

    function cancelarEdicionEmpleado() {
      document.getElementById('emp-id').value = '';
      document.getElementById('emp-name').value = '';
      document.getElementById('emp-pin').value = '';
      document.getElementById('emp-pin').setAttribute('required', '');
      document.getElementById('emp-pin-hint').textContent = 'Para editar, déjalo vacío y conserva el PIN actual.';
      document.querySelectorAll('#emp-form [name="perms"]').forEach(function (cb) { cb.checked = false; });
      document.getElementById('emp-form').action = '/<%= biz.slug %>/admin/empleado';
      document.getElementById('emp-form-title').textContent = 'Agregar empleado';
      document.getElementById('emp-submit').textContent = 'Agregar empleado';
      document.getElementById('emp-cancel').classList.add('hidden');
    }

    // Si venimos de un error al editar, mantener el modo edición
    var editId = <%- typeof formId !== 'undefined' && formId ? safeJson(formId) : 'null' %>;
    if (editId) {
      document.getElementById('emp-form').action = '/<%= biz.slug %>/admin/empleado/' + editId;
      document.getElementById('emp-form-title').textContent = 'Editar empleado';
      document.getElementById('emp-submit').textContent = 'Guardar cambios';
      document.getElementById('emp-cancel').classList.remove('hidden');
      document.getElementById('emp-pin').removeAttribute('required');
      document.getElementById('emp-pin-hint').textContent = 'Déjalo vacío para conservar el PIN actual (o escribe uno nuevo).';
    }
  </script>
</body>
</html>
