<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Catálogo</title>
  <script src="https://cdn.tailwindcss.com"></script>`n  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: #f8f7f4;
      color: #1a1816;
      min-height: 100vh;
    }

    /* Glassmorphism sutil */
    .glass {
      backdrop-filter: blur(16px) saturate(1.6);
      background: rgba(255, 255, 245, 0.5);
      border: 1px solid rgba(255, 255, 245, 0.3);
    }
    .glass-card {
      background: rgba(255, 255, 245, 0.6);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 245, 0.2);
      border-radius: 20px;
      transition: all 0.25s ease;
    }
    .glass-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.04);
    }

    /* Botones */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.4rem;
      border-radius: 60px;
      font-weight: 600;
      font-size: 0.75rem;
      background: #1a1a1a;
      color: #fff;
      border: none;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
      letter-spacing: 0.02em;
    }
    .btn-primary:hover {
      background: #000;
      transform: scale(1.03);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }
    .btn-wa {
      background: #22c55e;
    }
    .btn-wa:hover {
      background: #16a34a;
      box-shadow: 0 8px 24px rgba(34, 197, 94, 0.25);
    }

    /* Chips de categoría */
    .chip-active {
      background: #1a1a1a;
      color: #fff;
      border-color: #1a1a1a;
    }
    .chip-idle {
      background: rgba(255, 255, 245, 0.5);
      border: 1px solid rgba(0, 0, 0, 0.06);
      color: #3a3a3a;
    }
    .chip-idle:hover {
      background: #fff;
      border-color: #c0bdb6;
    }

    /* Input de búsqueda minimalista */
    .search-minimal {
      background: transparent;
      border: none;
      border-bottom: 2px solid rgba(0, 0, 0, 0.08);
      transition: all 0.2s;
      font-weight: 300;
      letter-spacing: -0.01em;
    }
    .search-minimal:focus {
      outline: none;
      border-bottom-color: #1a1a1a;
    }
    .search-minimal::placeholder {
      color: #b0aea8;
      font-weight: 300;
    }

    /* Tarjeta de producto (lista horizontal) */
    .product-row {
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid rgba(0, 0, 0, 0.04);
      transition: all 0.25s ease;
      padding: 1rem;
    }
    .product-row:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
      transform: translateY(-2px);
    }

    /* Badge de oferta */
    .badge-offer {
      background: #ef4444;
      color: #fff;
      font-size: 0.6rem;
      font-weight: 700;
      padding: 0.1rem 0.6rem;
      border-radius: 60px;
    }

    /* Barra de carrito fija */
    .cart-bar {
      backdrop-filter: blur(20px) saturate(1.8);
      background: rgba(26, 24, 22, 0.85);
      border: 1px solid rgba(255, 255, 245, 0.08);
      border-radius: 60px;
    }

    /* Footer */
    .footer-muted {
      color: #b0aea8;
      border-top: 1px solid rgba(0, 0, 0, 0.04);
    }

    /* Scroll suave para categorías */
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body>

  <!-- HEADER minimalista y centrado -->
  <header data-sec="hero" class="max-w-6xl mx-auto px-6 pt-12 pb-6 text-center header-gradient">
    <div class="relative inline-block">
      <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=f8f7f4&color=1a1816&size=80' %>"
           class="w-20 h-20 rounded-full mx-auto object-cover ring-1 ring-black/5 shadow-sm"
           alt="<%= biz.name %>" />
      <!-- pequeño badge de verificación sutil -->
      <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 rounded-full border-2 border-white shadow-sm flex items-center justify-center text-white text-[9px] font-black">✓</div>
    </div>

    <h1 class="text-4xl md:text-5xl font-light tracking-tight mt-5 cat-title"><%= biz.name %></h1>
    <p class="text-neutral-400 font-light mt-2 max-w-md mx-auto"><%= biz.description %></p>

    <div class="mt-5 flex justify-center gap-4 text-sm">
      <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>"
         class="text-neutral-600 hover:text-neutral-900 hover:underline underline-offset-4 transition">
        WhatsApp ↗
      </a>
      <span class="text-neutral-300">·</span>
      <span class="text-neutral-400">Envíos a La Laguna</span>
    </div>
  </header>

  <!-- MAIN -->
  <main data-sec="contenido" class="max-w-6xl mx-auto px-6 py-8 pb-32">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode }) %>
  </main>



  <!-- Scripts (incluye lógica de carrito y filtros) -->
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>