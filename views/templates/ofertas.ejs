<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Ofertas</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --accent:#dc2626; --accent2:#ef4444;
      --bg:#fefce8; --text:#1a1a1a; --muted:#999;
      --card:#ffffff; --border:#fecaca;
      --radius:12px;
      --head-font:'Inter',system-ui,sans-serif;
      --body-font:'Inter',system-ui,sans-serif;
    }
    body {
      font-family: var(--body-font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    h1,h2,h3,h4,h5,h6 { font-family: var(--head-font); }

    /* ═══ Shared components overrides ═══ */
    .product-card {
      background: var(--card) !important;
      border: 2px solid var(--border) !important;
      border-radius: var(--radius) !important;
      transition: all .25s ease !important;
      overflow: hidden; position: relative;
    }
    .product-card:hover {
      transform: translateY(-3px) !important;
      box-shadow: 0 12px 32px rgba(220,38,38,.12) !important;
      border-color: #f87171 !important;
    }
    .offer-card {
      background: var(--card) !important;
      border: 2px solid var(--border) !important;
      border-radius: var(--radius) !important;
      overflow: hidden; position: relative;
      transition: all .25s ease !important;
    }
    .offer-card:hover {
      transform: translateY(-3px) !important;
      box-shadow: 0 12px 32px rgba(220,38,38,.12) !important;
    }
    .badge-offer {
      background: var(--accent) !important; color: #fff !important;
      font-size:.65rem; font-weight:800; padding:.2rem .7rem;
      border-radius:6px; animation:pulse-badge 2s ease-in-out infinite;
    }
    @keyframes pulse-badge {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    .chip-active {
      background: var(--accent) !important; color: #fff !important;
      border-color: var(--accent) !important; border-radius: 8px !important;
    }
    .chip-idle {
      background: #fff !important; color: #991b1b !important;
      border: 2px solid #fca5a5 !important; border-radius: 8px !important;
      font-weight: 600;
    }
    .chip-idle:hover {
      background: var(--accent) !important; color: #fff !important;
      border-color: var(--accent) !important;
    }
    .search-input {
      background: #fff !important; color: var(--text) !important;
      border: 2px solid #fca5a5 !important; border-radius: 8px !important;
    }
    .search-input:focus {
      border-color: var(--accent) !important;
      box-shadow: 0 0 0 3px rgba(220,38,38,.15) !important;
    }
    .cat-chip { border-radius: 8px !important; }

    /* ═══ Template-specific ═══ */
    .deal-stripe {
      background: repeating-linear-gradient(
        -45deg, #dc2626, #dc2626 10px, #b91c1c 10px, #b91c1c 20px
      );
      height: 6px;
    }
    .offer-ribbon {
      position: absolute; top: 12px; left: -8px; z-index: 10;
      background: var(--accent); color: #fff;
      font-size: 11px; font-weight: 800; padding: 4px 12px 4px 16px;
      border-radius: 0 6px 6px 0;
      box-shadow: 0 2px 8px rgba(220,38,38,.3);
    }
    .offer-ribbon::before {
      content: ''; position: absolute; left: 0; bottom: -6px;
      border: 3px solid transparent; border-top-color: #7f1d1d; border-right-color: #7f1d1d;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .6rem 1.5rem; border-radius: 8px;
      font-weight: 800; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em;
      background: var(--accent); color: #fff; border: none;
      transition: all .2s ease; cursor: pointer;
    }
    .btn-primary:hover { background: #b91c1c; transform: scale(1.02); }
    .btn-wa { background: #22c55e !important; }
    .btn-wa:hover { background: #16a34a !important; }
    .cart-bar {
      backdrop-filter: blur(20px) !important;
      background: rgba(220,38,38,.95) !important;
      border-radius: 16px 16px 0 0 !important;
    }
    .footer-muted { color: #999; border-top: 1px solid rgba(220,38,38,.1); }
    .verify-badge {
      position:absolute;bottom:-2px;right:-2px;width:20px;height:20px;
      background:#22c55e;border-radius:50%;border:2px solid #fff;
      display:flex;align-items:center;justify-content:center;
      font-size:10px;color:#fff;font-weight:900;
    }
    .scrollbar-hide::-webkit-scrollbar{display:none}
    .scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none}
  </style>
</head>
<body>
  <div class="deal-stripe"></div>
  <header data-sec="hero" style="background:var(--bg);">
    <div style="max-width:1100px;margin:0 auto;padding:20px 16px;">
      <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <div style="position:relative;">
          <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=dc2626&color=fff&size=64' %>"
               style="width:56px;height:56px;border-radius:12px;object-fit:cover;border:3px solid #fca5a5;"
               alt="<%= biz.name %>" />
          <span class="verify-badge">✓</span>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:2px;">
            <span style="font-size:10px;font-weight:800;background:var(--accent);color:#fff;padding:2px 8px;border-radius:4px;text-transform:uppercase;letter-spacing:.1em;">🔥 Ofertas</span>
          </div>
          <h1 style="font-size:26px;font-weight:900;letter-spacing:-.02em;" data-editable="name"><%= biz.name %></h1>
          <p style="font-size:12px;color:var(--muted);margin-top:2px;"><%= biz.description %></p>
        </div>
        <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>"
           class="btn-primary btn-wa" style="margin-left:auto;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </header>
  <main data-sec="contenido" style="max-width:1100px;margin:0 auto;padding:0 16px 112px;">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode, mascaraCss: mascaraCss, mascaraConfig: mascaraConfig }) %>
  </main>
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>