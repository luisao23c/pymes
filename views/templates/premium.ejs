<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Premium</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --accent:#1a1a1a; --accent2:#333;
      --bg:#faf9f7; --text:#1a1a1a; --muted:#999;
      --card:#ffffff; --border:rgba(0,0,0,0.06);
      --radius:0px;
      --head-font:'Cormorant Garamond',Georgia,serif;
      --body-font:'DM Sans',system-ui,sans-serif;
    }
    body {
      font-family: var(--body-font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    h1,h2,h3,h4,h5,h6 { font-family: var(--head-font); }
    .serif { font-family: var(--head-font); }

    /* ═══ Shared components overrides ═══ */
    .product-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: 0 !important;
      transition: all .3s ease !important;
      overflow: hidden;
    }
    .product-card:hover {
      transform: translateY(-2px) !important;
      box-shadow: 0 12px 32px rgba(0,0,0,.08) !important;
    }
    .offer-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: 0 !important;
    }
    .badge-offer {
      background: #1a1a1a !important; color: #fff !important;
      font-size:.55rem; font-weight:700; padding:.15rem .6rem;
      border-radius:2px; letter-spacing:.08em; text-transform:uppercase;
    }
    .chip-active {
      background: #1a1a1a !important; color: #fff !important;
      border-color: #1a1a1a !important; border-radius: 2px !important;
    }
    .chip-idle {
      background: transparent !important; color: #555 !important;
      border: 1px solid rgba(0,0,0,.1) !important; border-radius: 2px !important;
    }
    .chip-idle:hover {
      background: #1a1a1a !important; color: #fff !important;
      border-color: #1a1a1a !important;
    }
    .search-input {
      background: transparent !important; color: var(--text) !important;
      border: none !important; border-bottom: 1px solid rgba(0,0,0,.15) !important;
      border-radius: 0 !important;
    }
    .search-input:focus {
      border-color: #1a1a1a !important; box-shadow: none !important;
    }
    .cat-chip { border-radius: 2px !important; }

    /* ═══ Template-specific ═══ */
    .lux-hero {
      position: relative; min-height: 70vh; display: flex;
      align-items: flex-end; overflow: hidden;
    }
    .lux-hero img.hero-bg {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover;
    }
    .lux-hero .lux-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.2) 40%, rgba(0,0,0,.05) 100%);
    }
    .lux-hero .lux-content {
      position: relative; z-index: 2; width: 100%; padding: 48px 32px;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .7rem 2rem; border-radius: 4px;
      font-weight: 600; font-size: .8rem; letter-spacing: .08em; text-transform: uppercase;
      background: #1a1a1a; color: #fff; border: none;
      transition: all .3s ease; cursor: pointer;
    }
    .btn-primary:hover { background: #333; letter-spacing: .12em; }
    .btn-wa { background: #22c55e !important; }
    .btn-wa:hover { background: #16a34a !important; }
    .cart-bar { background: rgba(26,26,26,.95) !important; border-radius: 0 !important; }
    .footer-muted { color: #999; border-top: 1px solid rgba(0,0,0,.06); }
    .verify-badge {
      position:absolute;bottom:-2px;right:-2px;width:18px;height:18px;
      background:#22c55e;border-radius:50%;border:2px solid #fff;
      display:flex;align-items:center;justify-content:center;
      font-size:9px;color:#fff;font-weight:900;
    }
    .scrollbar-hide::-webkit-scrollbar{display:none}
    .scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none}
  </style>
</head>
<body>
  <header data-sec="hero" class="lux-hero">
    <img class="hero-bg" src="<%= biz.cover || 'https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1200' %>" alt="" />
    <div class="lux-overlay"></div>
    <div class="lux-content">
      <div style="max-width:1100px;margin:0 auto;">
        <div style="display:flex;align-items:flex-end;gap:20px;flex-wrap:wrap;">
          <div style="position:relative;">
            <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=1a1a1a&color=fff&size=80' %>"
                 style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,.3);"
                 alt="<%= biz.name %>" />
            <span class="verify-badge">✓</span>
          </div>
          <div>
            <h1 class="serif" style="font-size:48px;font-weight:600;color:#fff;letter-spacing:-.02em;line-height:1.1;text-shadow:0 2px 16px rgba(0,0,0,.3);" data-editable="name"><%= biz.name %></h1>
            <p style="font-size:14px;color:rgba(255,255,255,.75);margin-top:8px;max-width:500px;"><%= biz.description %></p>
            <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
              <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>" class="btn-primary btn-wa">Contactar</a>
              <span style="display:inline-flex;align-items:center;gap:6px;padding:.7rem 1.5rem;border:1px solid rgba(255,255,255,.3);color:rgba(255,255,255,.8);font-size:.8rem;letter-spacing:.05em;border-radius:4px;">
                <i class="bi bi-geo-alt"></i> <%= biz.address || 'Ubicación' %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>
  <main data-sec="contenido" style="max-width:1100px;margin:0 auto;padding:32px 16px 112px;">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode, mascaraCss: mascaraCss, mascaraConfig: mascaraConfig }) %>
  </main>
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>