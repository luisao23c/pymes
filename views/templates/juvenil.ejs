<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Catálogo</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --accent:#8b5cf6; --accent2:#ec4899;
      --bg:#0a0a0a; --text:#f0f0f0; --muted:#555;
      --card:rgba(255,255,255,.03); --border:rgba(255,255,255,.06);
      --radius:20px;
      --head-font:'Space Grotesk',system-ui,sans-serif;
      --body-font:'Space Grotesk',system-ui,sans-serif;
    }
    body {
      font-family: var(--body-font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    h1,h2,h3,h4,h5,h6 { font-family: var(--head-font); }

    /* ═══ Shared components overrides ═══ */
    .product-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: var(--radius) !important;
      transition: all .3s cubic-bezier(.16,1,.3,1) !important;
      overflow: hidden;
    }
    .product-card:hover {
      transform: translateY(-6px) scale(1.01) !important;
      box-shadow: 0 20px 40px rgba(139,92,246,.15) !important;
      border-color: rgba(139,92,246,.3) !important;
    }
    .offer-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: var(--radius) !important;
    }
    .badge-offer {
      background: linear-gradient(135deg,#f43f5e,#e11d48) !important;
      color: #fff !important; font-size:.6rem; font-weight:700;
      padding:.2rem .7rem; border-radius:999px;
    }
    .chip-active {
      background: linear-gradient(135deg,var(--accent),var(--accent2)) !important;
      color: #fff !important; border-color: transparent !important;
      border-radius: 999px !important;
    }
    .chip-idle {
      background: rgba(255,255,255,.04) !important; color: #aaa !important;
      border: 1px solid rgba(255,255,255,.08) !important;
      border-radius: 999px !important;
    }
    .chip-idle:hover {
      background: rgba(255,255,255,.08) !important; color: #fff !important;
      border-color: rgba(255,255,255,.15) !important;
    }
    .search-input {
      background: rgba(255,255,255,.04) !important; color: #fff !important;
      border: 1px solid rgba(255,255,255,.08) !important;
      border-radius: 999px !important;
    }
    .search-input::placeholder { color: #555; }
    .search-input:focus {
      border-color: var(--accent) !important;
      box-shadow: 0 0 0 3px rgba(139,92,246,.2) !important;
    }
    .cat-chip { border-radius: 999px !important; }

    /* ═══ Template-specific ═══ */
    .neon-glow { box-shadow: 0 0 40px rgba(139,92,246,.15), 0 0 80px rgba(236,72,153,.08); }
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .6rem 1.5rem; border-radius: 999px;
      font-weight: 600; font-size: .78rem;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff; border: none; cursor: pointer;
      transition: all .2s ease; position: relative; overflow: hidden;
    }
    .btn-primary::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, #a78bfa, #f472b6);
      opacity: 0; transition: opacity .2s;
    }
    .btn-primary:hover::before { opacity: 1; }
    .btn-primary span { position: relative; z-index: 1; }
    .btn-wa { background: linear-gradient(135deg,#22c55e,#10b981) !important; }
    .btn-wa::before { background: linear-gradient(135deg,#34d399,#22c55e); }
    .cart-bar {
      backdrop-filter: blur(24px) saturate(1.8) !important;
      background: rgba(10,10,10,.85) !important;
      border: 1px solid rgba(255,255,255,.06) !important;
      border-radius: 20px !important; margin: 0 12px 12px !important;
    }
    .footer-muted { color: #555; border-top: 1px solid rgba(255,255,255,.06); }
    .verify-badge {
      position:absolute;bottom:-2px;right:-2px;width:20px;height:20px;
      background:linear-gradient(135deg,var(--accent),var(--accent2));
      border-radius:50%;border:2px solid var(--bg);
      display:flex;align-items:center;justify-content:center;
      font-size:10px;color:#fff;font-weight:900;
    }
    .header-gradient { position: relative; overflow: hidden; }
    .header-gradient::before {
      content: ''; position: absolute; width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(139,92,246,.2) 0%, transparent 70%);
      top: -150px; right: -100px; animation: float 8s ease-in-out infinite;
    }
    .header-gradient::after {
      content: ''; position: absolute; width: 300px; height: 300px;
      background: radial-gradient(circle, rgba(236,72,153,.15) 0%, transparent 70%);
      bottom: -100px; left: -50px; animation: float 10s ease-in-out infinite reverse;
    }
    @keyframes float {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(20px, -20px); }
    }
    .scrollbar-hide::-webkit-scrollbar{display:none}
    .scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none}
  </style>
</head>
<body>
  <header data-sec="hero" class="header-gradient neon-glow" style="background:#0a0a0a;position:relative;z-index:1;">
    <div style="position:relative;z-index:2;max-width:1100px;margin:0 auto;padding:28px 16px;">
      <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <div style="position:relative;">
          <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=8b5cf6&color=fff&size=64' %>"
               style="width:56px;height:56px;border-radius:16px;object-fit:cover;border:2px solid rgba(255,255,255,.1);"
               alt="<%= biz.name %>" />
          <span class="verify-badge">✓</span>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,rgba(139,92,246,.15),rgba(236,72,153,.15));padding:3px 10px;border-radius:999px;margin-bottom:6px;">
            <span style="font-size:10px;">🔥</span>
            <span style="font-size:10px;font-weight:600;color:#c084fc;letter-spacing:.05em;">NUEVO</span>
          </div>
          <h1 style="font-size:26px;font-weight:700;letter-spacing:-.03em;" data-editable="name"><%= biz.name %></h1>
          <p style="font-size:12px;color:#666;margin-top:2px;"><%= biz.description %></p>
        </div>
        <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>"
           class="btn-primary btn-wa" style="margin-left:auto;">
          <span>💬 Pregúntanos</span>
        </a>
      </div>
    </div>
  </header>
  <main data-sec="contenido" style="max-width:1100px;margin:0 auto;padding:0 16px 112px;">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode, mascaraCss: mascaraCss, mascaraConfig: mascaraConfig }) %>
  </main>
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>