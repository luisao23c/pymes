<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Portada</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --accent:#1a1a1a; --accent2:#333;
      --bg:#f8f7f4; --text:#1a1a1a; --muted:#aaa;
      --card:#ffffff; --border:rgba(0,0,0,0.04);
      --radius:16px;
      --head-font:'Outfit',system-ui,sans-serif;
      --body-font:'Outfit',system-ui,sans-serif;
    }
    body {
      font-family: var(--body-font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    h1,h2,h3,h4,h5,h6 { font-family: var(--head-font); }

    /* ═══ Shared components overrides ═══ */
    .product-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: var(--radius) !important;
      transition: all .25s ease !important;
      overflow: hidden;
      box-shadow: 0 1px 3px rgba(0,0,0,.04) !important;
    }
    .product-card:hover {
      transform: translateY(-3px) !important;
      box-shadow: 0 12px 32px rgba(0,0,0,.08) !important;
    }
    .offer-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: var(--radius) !important;
    }
    .badge-offer {
      background: #ef4444 !important; color: #fff !important;
      font-size:.6rem; font-weight:800; padding:.2rem .7rem;
      border-radius:8px;
    }
    .chip-active {
      background: #1a1a1a !important; color: #fff !important;
      border-color: #1a1a1a !important; border-radius: 10px !important;
    }
    .chip-idle {
      background: #fff !important; color: #666 !important;
      border: 1px solid #e5e5e5 !important; border-radius: 10px !important;
    }
    .chip-idle:hover {
      background: #1a1a1a !important; color: #fff !important;
      border-color: #1a1a1a !important;
    }
    .search-input {
      background: #fff !important; color: var(--text) !important;
      border: 1px solid #e5e5e5 !important; border-radius: 12px !important;
    }
    .search-input:focus {
      border-color: #1a1a1a !important;
      box-shadow: 0 0 0 3px rgba(0,0,0,.05) !important;
    }
    .cat-chip { border-radius: 10px !important; }

    /* ═══ Template-specific ═══ */
    .cover-hero {
      position: relative; width: 100%; height: 50vh; min-height: 320px;
      overflow: hidden; background: #1a1a1a;
    }
    .cover-hero img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; opacity: .7;
    }
    .cover-hero .cover-content {
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,.1) 0%, rgba(0,0,0,.6) 100%);
      display: flex; flex-direction: column; justify-content: flex-end;
      padding: 32px 24px;
    }
    .cover-bar {
      background: #1a1a1a; color: #fff; padding: 20px 24px;
      display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .6rem 1.5rem; border-radius: 12px;
      font-weight: 600; font-size: .8rem;
      background: #1a1a1a; color: #fff; border: none;
      transition: all .2s ease; cursor: pointer;
    }
    .btn-primary:hover { background: #333; transform: translateY(-1px); }
    .btn-wa { background: #22c55e !important; }
    .btn-wa:hover { background: #16a34a !important; }
    .cart-bar {
      backdrop-filter: blur(20px) !important;
      background: rgba(255,255,255,.9) !important;
      border-top: 1px solid rgba(0,0,0,.06) !important;
      border-radius: 20px 20px 0 0 !important;
    }
    .footer-muted { color: #aaa; border-top: 1px solid rgba(0,0,0,.06); }
    .verify-badge {
      position:absolute;bottom:-2px;right:-2px;width:20px;height:20px;
      background:#22c55e;border-radius:50%;border:2px solid #fff;
      display:flex;align-items:center;justify-content:center;
      font-size:10px;color:#fff;font-weight:900;
    }
    .scrollbar-hide::-webkit-scrollbar{display:none}
    .scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none}
  </style>
</head>
<body>
  <header data-sec="hero" class="cover-hero">
    <img src="<%= biz.cover || biz.logo || 'https://images.unsplash.com/photo-1567521464027-f127ff144326?w=1200' %>" alt="" />
    <div class="cover-content">
      <div style="display:flex;align-items:center;gap:14px;">
        <div style="position:relative;">
          <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=fff&color=1a1a1a&size=64' %>"
               style="width:64px;height:64px;border-radius:14px;object-fit:cover;border:3px solid rgba(255,255,255,.3);box-shadow:0 8px 24px rgba(0,0,0,.3);"
               alt="<%= biz.name %>" />
          <span class="verify-badge">✓</span>
        </div>
        <div>
          <h1 style="font-size:36px;font-weight:800;color:#fff;letter-spacing:-.03em;text-shadow:0 2px 12px rgba(0,0,0,.5);" data-editable="name"><%= biz.name %></h1>
          <p style="font-size:14px;color:rgba(255,255,255,.8);margin-top:4px;text-shadow:0 1px 4px rgba(0,0,0,.5);"><%= biz.description %></p>
        </div>
      </div>
    </div>
  </header>
  <div class="cover-bar">
    <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>"
       class="btn-primary btn-wa" style="border-radius:8px;">Contactar</a>
    <span style="font-size:12px;color:#888;margin-left:auto;">
      <i class="bi bi-geo-alt" style="margin-right:4px;"></i><%= biz.address || '' %>
    </span>
  </div>
  <main data-sec="contenido" style="max-width:1100px;margin:0 auto;padding:24px 16px 112px;">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode, mascaraCss: mascaraCss, mascaraConfig: mascaraConfig }) %>
  </main>
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>