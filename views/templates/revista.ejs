<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Revista</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:opsz,wght@5..96,400;5..96,500;5..96,600;5..96,700;5..96,800;5..96,900&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --accent:#1a1a1a; --accent2:#333;
      --bg:#faf9f6; --text:#1a1816; --muted:#999;
      --card:#ffffff; --border:rgba(0,0,0,0.06);
      --radius:12px;
      --head-font:'Playfair Display',Georgia,serif;
      --body-font:'DM Sans',system-ui,sans-serif;
    }
    body {
      font-family: var(--body-font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    h1,h2,h3,h4,h5,h6 { font-family: var(--head-font); }
    .serif { font-family: var(--head-font); }

    /* ═══ Shared components overrides ═══ */
    .product-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: var(--radius) !important;
      transition: all .25s ease !important;
      overflow: hidden;
    }
    .product-card:hover {
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 24px rgba(0,0,0,.08) !important;
    }
    .product-hero {
      background: #1a1a1a !important; border-radius: 16px !important;
      overflow: hidden; position: relative; transition: all .3s ease; color: #fff;
    }
    .product-hero:hover { transform: translateY(-3px) !important; box-shadow: 0 16px 48px rgba(0,0,0,.2) !important; }
    .offer-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: var(--radius) !important;
    }
    .badge-offer {
      background: #dc2626 !important; color: #fff !important;
      font-size:.6rem; font-weight:800; padding:.15rem .6rem;
      border-radius:4px; letter-spacing:.05em; text-transform:uppercase;
    }
    .chip-active {
      background: #1a1a1a !important; color: #fff !important;
      border-color: #1a1a1a !important; border-radius: 4px !important;
    }
    .chip-idle {
      background: transparent !important; color: #555 !important;
      border: 1px solid rgba(0,0,0,.08) !important; border-radius: 4px !important;
    }
    .chip-idle:hover {
      background: #1a1a1a !important; color: #fff !important;
      border-color: #1a1a1a !important;
    }
    .search-input {
      background: transparent !important; color: var(--text) !important;
      border: 1px solid rgba(0,0,0,.1) !important; border-radius: 6px !important;
    }
    .search-input:focus {
      border-color: #1a1a1a !important; box-shadow: none !important;
    }
    .cat-chip { border-radius: 4px !important; }

    /* ═══ Template-specific ═══ */
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .55rem 1.4rem; border-radius: 6px;
      font-weight: 600; font-size: .78rem; letter-spacing: .03em;
      background: #1a1a1a; color: #fff; border: none;
      transition: all .2s ease; cursor: pointer;
    }
    .btn-primary:hover { background: #333; transform: translateY(-1px); }
    .btn-wa { background: #22c55e !important; }
    .btn-wa:hover { background: #16a34a !important; }
    .cart-bar {
      backdrop-filter: blur(20px) saturate(1.8) !important;
      background: rgba(26,24,22,.92) !important;
      border: 1px solid rgba(255,255,245,.1) !important;
    }
    .footer-muted { color: #999; border-top: 1px solid rgba(0,0,0,.06); }
    .verify-badge {
      position:absolute;bottom:-2px;right:-2px;width:18px;height:18px;
      background:#1a1a1a;border-radius:50%;border:2px solid #fff;
      display:flex;align-items:center;justify-content:center;
      font-size:9px;color:#fff;font-weight:900;
    }
    .ed-divider { width:100%;height:1px;background:rgba(0,0,0,.08);margin:24px 0; }
    .ed-thick { height:3px; background:#1a1a1a; }
    .ed-label {
      font-family: var(--body-font); font-size:10px; font-weight:700;
      letter-spacing:.15em; text-transform:uppercase; color:#999;
    }
    .ed-section {
      font-family: var(--head-font); font-size:22px; font-weight:700;
      margin-bottom:16px; border-bottom:2px solid #1a1a1a;
      padding-bottom:8px; display:inline-block;
    }
    .scrollbar-hide::-webkit-scrollbar{display:none}
    .scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none}
  </style>
</head>
<body>
  <header data-sec="hero" style="background:var(--bg);">
    <div style="max-width:1100px;margin:0 auto;padding:24px 16px 0;">
      <div style="height:3px;background:#1a1a1a;margin-bottom:16px;"></div>
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;align-items:center;gap:14px;">
          <div style="position:relative;">
            <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=1a1a1a&color=fff&size=48' %>"
                 style="width:48px;height:48px;border-radius:50%;object-fit:cover;border:2px solid #1a1a1a;"
                 alt="<%= biz.name %>" />
            <span class="verify-badge">✓</span>
          </div>
          <div>
            <h1 class="serif" style="font-size:28px;font-weight:800;letter-spacing:-.02em;" data-editable="name"><%= biz.name %></h1>
            <p style="font-size:11px;color:#999;letter-spacing:.08em;text-transform:uppercase;margin-top:2px;"><%= biz.description %></p>
          </div>
        </div>
        <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>"
           class="btn-primary btn-wa" style="font-size:11px;padding:6px 16px;border-radius:4px;">Contactar</a>
      </div>
      <div style="height:1px;background:rgba(0,0,0,.08);margin-top:16px;"></div>
      <div style="height:1px;background:rgba(0,0,0,.08);margin-top:2px;"></div>
    </div>
  </header>
  <main data-sec="contenido" style="max-width:1100px;margin:0 auto;padding:0 16px 112px;">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode, mascaraCss: mascaraCss, mascaraConfig: mascaraConfig }) %>
  </main>
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>