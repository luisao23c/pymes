<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Menú</title>
  <script src="https://cdn.tailwindcss.com"></script>`n  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: #faf8f3;
      color: #1a1816;
      min-height: 100vh;
    }

    /* Glassmorphism */
    .glass {
      backdrop-filter: blur(16px) saturate(1.8);
      background: rgba(255, 255, 245, 0.55);
      border: 1px solid rgba(255, 255, 245, 0.35);
    }
    .glass-card {
      background: rgba(255, 255, 245, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 245, 0.3);
      border-radius: 20px;
      transition: all 0.25s ease;
    }
    .glass-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.04);
    }

    /* Botón principal (estilo restaurante) */
    .btn-order {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 2rem;
      border-radius: 60px;
      font-weight: 700;
      font-size: 0.85rem;
      background: #ea580c;
      color: #fff;
      border: none;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(234, 88, 12, 0.3);
    }
    .btn-order:hover {
      background: #c2410c;
      transform: scale(1.04);
      box-shadow: 0 8px 28px rgba(234, 88, 12, 0.4);
    }
    .btn-wa {
      background: #22c55e;
      box-shadow: 0 4px 16px rgba(34, 197, 94, 0.25);
    }
    .btn-wa:hover {
      background: #16a34a;
      box-shadow: 0 8px 28px rgba(34, 197, 94, 0.35);
    }

    /* Chips de categoría */
    .chip-active {
      background: #1a1a1a;
      color: #fff;
      border-color: #1a1a1a;
    }
    .chip-idle {
      background: rgba(255, 255, 245, 0.6);
      border: 1px solid rgba(0, 0, 0, 0.06);
      color: #3a3a3a;
    }
    .chip-idle:hover {
      background: #fff;
      border-color: #c0bdb6;
    }

    /* Input de búsqueda */
    .search-input {
      background: rgba(255, 255, 245, 0.7);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 245, 0.5);
      transition: all 0.2s;
    }
    .search-input:focus {
      outline: none;
      border-color: #ea580c;
      box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.1);
      background: rgba(255, 255, 245, 0.95);
    }

    /* Tarjeta de producto (formato menú) */
    .menu-item {
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid rgba(0, 0, 0, 0.04);
      transition: all 0.25s ease;
      padding: 1rem;
    }
    .menu-item:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
      transform: translateY(-2px);
    }

    /* Badge de oferta */
    .badge-offer {
      background: #ef4444;
      color: #fff;
      font-size: 0.6rem;
      font-weight: 700;
      padding: 0.1rem 0.6rem;
      border-radius: 60px;
    }

    /* Barra de carrito fija */
    .cart-bar {
      backdrop-filter: blur(20px) saturate(1.8);
      background: rgba(26, 24, 22, 0.85);
      border: 1px solid rgba(255, 255, 245, 0.08);
      border-radius: 60px;
    }

    /* Footer */
    .footer-muted {
      color: #b0aea8;
      border-top: 1px solid rgba(0, 0, 0, 0.04);
    }

    /* Scroll suave para categorías */
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

    /* Hero banner para restaurante */
    .hero-restaurant {
      position: relative;
      overflow: hidden;
      min-height: 45vh;
      display: flex;
      align-items: flex-end;
    }
    .hero-restaurant::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.3) 60%, #faf8f3 100%);
      pointer-events: none;
    }
    .hero-content {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 4xl;
      margin: 0 auto;
      padding: 2rem 1.5rem 3rem;
      text-align: center;
      color: #fff;
    }
  </style>
</head>
<body>

  <!-- HERO BANNER estilo restaurante -->
  <header data-sec="hero" class="hero-restaurant header-gradient">
    <img src="<%= biz.banner || 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200&q=80' %>"
         class="absolute inset-0 w-full h-full object-cover"
         alt="<%= biz.name %> banner" />
    <div class="hero-content">
      <div class="relative inline-block">
        <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=ea580c&color=fff&size=80' %>"
             class="w-20 h-20 rounded-2xl mx-auto shadow-xl ring-4 ring-white/30 object-cover"
             alt="<%= biz.name %>" />
        <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-emerald-500 rounded-full border-2 border-white shadow-md flex items-center justify-center text-white text-[10px] font-black">✓</div>
      </div>
      <h1 class="text-4xl font-black text-white mt-4 drop-shadow-lg cat-title"><%= biz.name %></h1>
      <p class="text-orange-100/90 text-sm mt-2 max-w-md mx-auto drop-shadow"><%= biz.description %></p>
      <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>"
         class="btn-order inline-flex items-center gap-2 mt-5 shadow-lg hover:scale-105 transition">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Reservar / Pedir
      </a>
    </div>
  </header>

  <!-- MAIN -->
  <main data-sec="contenido" class="max-w-6xl mx-auto px-4 py-8 pb-28">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode }) %>
  </main>



  <!-- Scripts (incluye lógica de carrito y filtros) -->
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>