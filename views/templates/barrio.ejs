<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Barrio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --accent:#d97706; --accent2:#f59e0b;
      --bg:#fdf6ec; --text:#3d2c1c; --muted:#8a7358;
      --card:#fffdf8; --border:#e8d5b8;
      --radius:999px;
      --head-font:'Nunito',system-ui,sans-serif;
      --body-font:'Nunito',system-ui,sans-serif;
    }
    body {
      font-family: var(--body-font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    h1,h2,h3,h4,h5,h6 { font-family: var(--head-font); }

    /* ═══ Shared components overrides ═══ */
    .product-card {
      background: var(--card) !important;
      border: 1.5px solid var(--border) !important;
      border-radius: 20px !important;
      transition: all .25s ease !important;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(61,44,28,.04) !important;
    }
    .product-card:hover {
      transform: translateY(-3px) !important;
      box-shadow: 0 10px 28px rgba(61,44,28,.1) !important;
      border-color: #d4b896 !important;
    }
    .offer-card {
      background: var(--card) !important;
      border: 1.5px solid var(--border) !important;
      border-radius: 20px !important;
    }
    .badge-offer {
      background: #dc2626 !important; color: #fff !important;
      font-size:.6rem; font-weight:800; padding:.2rem .6rem;
      border-radius:999px;
    }
    .chip-active {
      background: var(--accent) !important; color: #fff !important;
      border-color: var(--accent) !important; border-radius: 999px !important;
    }
    .chip-idle {
      background: rgba(255,255,255,.7) !important; color: #6b4e2a !important;
      border: 1.5px solid var(--border) !important; border-radius: 999px !important;
    }
    .chip-idle:hover {
      background: var(--accent) !important; color: #fff !important;
      border-color: var(--accent) !important;
    }
    .search-input {
      background: rgba(255,255,255,.7) !important; color: var(--text) !important;
      border: 1.5px solid var(--border) !important; border-radius: 999px !important;
    }
    .search-input::placeholder { color: #b8a48c; }
    .search-input:focus {
      border-color: var(--accent) !important;
      box-shadow: 0 0 0 3px rgba(217,119,6,.15) !important;
      background: #fff !important;
    }
    .cat-chip { border-radius: 999px !important; }

    /* ═══ Template-specific ═══ */
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .65rem 1.6rem; border-radius: 999px;
      font-weight: 700; font-size: .82rem;
      background: var(--accent); color: #fff; border: none;
      transition: all .2s ease; cursor: pointer;
      box-shadow: 0 4px 14px rgba(217,119,6,.3);
    }
    .btn-primary:hover { background: #b45309; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(217,119,6,.35); }
    .btn-wa { background: #22c55e !important; box-shadow: 0 4px 14px rgba(34,197,94,.3) !important; }
    .btn-wa:hover { background: #16a34a !important; box-shadow: 0 6px 20px rgba(34,197,94,.35) !important; }
    .cart-bar {
      backdrop-filter: blur(20px) saturate(1.8) !important;
      background: rgba(61,44,28,.88) !important;
      border-radius: 999px !important; margin: 0 12px 12px !important;
    }
    .footer-muted { color: #b8a48c; border-top: 1px solid #e8d5b8; }
    .verify-badge {
      position:absolute;bottom:-2px;right:-2px;width:22px;height:22px;
      background:#22c55e;border-radius:50%;border:3px solid var(--bg);
      display:flex;align-items:center;justify-content:center;
      font-size:10px;color:#fff;font-weight:900;
      box-shadow:0 2px 6px rgba(34,197,94,.3);
    }
    .barrio-dots {
      background-image: radial-gradient(circle, #e8d5b8 1px, transparent 1px);
      background-size: 20px 20px;
    }
    .scrollbar-hide::-webkit-scrollbar{display:none}
    .scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none}
  </style>
</head>
<body>
  <header data-sec="hero" class="barrio-dots" style="background:var(--bg);">
    <div style="max-width:800px;margin:0 auto;padding:36px 16px 28px;text-align:center;">
      <div style="position:relative;display:inline-block;">
        <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=d97706&color=fff&size=96' %>"
             style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:4px solid #fff;box-shadow:0 4px 16px rgba(217,119,6,.2);"
             alt="<%= biz.name %>" />
        <span class="verify-badge">✓</span>
      </div>
      <h1 style="font-size:30px;font-weight:900;letter-spacing:-.02em;margin-top:16px;color:var(--text);" data-editable="name"><%= biz.name %></h1>
      <p style="font-size:14px;color:var(--muted);margin-top:6px;max-width:400px;margin-left:auto;margin-right:auto;"><%= biz.description %></p>
      <div style="margin-top:18px;display:flex;justify-content:center;gap:10px;flex-wrap:wrap;">
        <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>" class="btn-primary btn-wa">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Pide por WhatsApp
        </a>
      </div>
    </div>
  </header>
  <main data-sec="contenido" style="max-width:900px;margin:0 auto;padding:0 16px 112px;">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode, mascaraCss: mascaraCss, mascaraConfig: mascaraConfig }) %>
  </main>
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>