<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Catálogo</title>
  <script src="https://cdn.tailwindcss.com"></script>`n  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=<%= theme.fontLink %>&display=swap" rel="stylesheet" />
  <style>
    :root {
      --accent: <%= theme.accent %>;
      --accent2: <%= theme.accent2 %>;
      --bg: <%= theme.bg %>;
      --text: <%= theme.text %>;
      --muted: <%= theme.muted %>;
      --card: <%= theme.card %>;
      --border: <%= theme.border %>;
      --radius: <%= theme.radius %>;
      --navcolor: <%= theme.accent %>;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: <%= theme.bodyFont %>; background: var(--bg); color: var(--text); line-height: 1.5; min-height: 100vh; }
    h1, h2, h3 { font-family: <%= theme.headFont %>; font-weight: 700; letter-spacing: -0.01em; }
    a { color: inherit; text-decoration: none; }
    .wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; }

    header { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--border); }
    .nav { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; }
    .logo { font-family: <%= theme.headFont %>; font-weight: 700; font-size: 1.4rem; }
    .navcta { background: <%= theme.accent %>; color: #fff; padding: 10px 20px; border-radius: <%= theme.radius %>; font-weight: 700; font-size: .9rem; }

    footer { background: <%= theme.dark ? theme.card : theme.text %>; color: <%= theme.dark ? theme.text : theme.bg %>; padding: 50px 24px 26px; <%= theme.dark ? 'border-top: 1px solid ' + theme.border : '' %>; }
    .fgrid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; max-width: 1140px; margin: 0 auto 30px; }
    footer h3 { margin-bottom: 14px; color: <%= theme.dark ? theme.accent2 : theme.bg %>; font-family: <%= theme.headFont %>; }
    footer p, footer li { color: <%= theme.dark ? theme.muted : 'rgba(255,255,255,0.75)' %>; font-size: .92rem; }
    footer ul { list-style: none; }
    footer li { margin-bottom: 8px; }
    .fbottom { text-align: center; border-top: 1px solid <%= theme.dark ? theme.border : 'rgba(255,255,255,0.15)' %>; padding-top: 20px; font-size: .82rem; color: <%= theme.dark ? theme.muted : 'rgba(255,255,255,0.6)' %>; max-width: 1140px; margin: 0 auto; }
    @media (max-width: 860px) { .fgrid { grid-template-columns: 1fr; } }
    <%- theme.css %>
  </style>
</head>
<body>

  <header>
    <div class="nav wrap">
      <div class="logo"><%= biz.name %></div>
      <a class="navcta" href="https://wa.me/<%= biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp %>" target="_blank" rel="noopener">Pedir</a>
    </div>
  </header>

  <main data-sec="contenido" class="wrap" style="padding:24px 0 70px;">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, theme, editMode }) %>
  </main>

  <footer id="contacto">
    <div class="fgrid">
      <div>
        <h3><%= biz.name %></h3>
        <p><%= biz.description %></p>
      </div>
      <div>
        <h3>Contacto</h3>
        <ul><li>WhatsApp: <%= biz.whatsapp %></li></ul>
      </div>
    </div>
    <div class="fbottom">© 2026 <%= biz.name %></div>
  </footer>

  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>
