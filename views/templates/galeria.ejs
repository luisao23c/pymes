<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Galería</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --accent:#111; --accent2:#333;
      --bg:#fff; --text:#111; --muted:#999;
      --card:transparent; --border:#e5e5e5;
      --radius:0px;
      --head-font:'Inter',system-ui,sans-serif;
      --body-font:'Inter',system-ui,sans-serif;
    }
    body {
      font-family: var(--body-font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      font-weight: 400; letter-spacing: -.01em;
    }
    h1,h2,h3,h4,h5,h6 { font-family: var(--head-font); }

    /* ═══ Shared components overrides ═══ */
    .product-card {
      background: transparent !important;
      border: none !important;
      border-radius: 0 !important;
      transition: none !important;
      overflow: hidden;
    }
    .product-card:hover { transform: none !important; box-shadow: none !important; }
    .product-card img { transition: opacity .3s ease; }
    .product-card:hover img { opacity: .85; }
    .offer-card {
      background: transparent !important;
      border: none !important;
      border-radius: 0 !important;
    }
    .badge-offer {
      background: #111 !important; color: #fff !important;
      font-size:.55rem; font-weight:600; padding:.15rem .5rem;
      border-radius:2px; letter-spacing:.05em; text-transform:uppercase;
    }
    .chip-active {
      background: #111 !important; color: #fff !important;
      border-color: #111 !important; border-radius: 60px !important;
    }
    .chip-idle {
      background: transparent !important; color: #888 !important;
      border: 1px solid #e5e5e5 !important; border-radius: 60px !important;
    }
    .chip-idle:hover {
      background: #111 !important; color: #fff !important;
      border-color: #111 !important;
    }
    .search-input {
      background: transparent !important; color: var(--text) !important;
      border: 1px solid #e5e5e5 !important; border-radius: 60px !important;
    }
    .search-input:focus {
      border-color: #111 !important; box-shadow: none !important;
    }
    .cat-chip { border-radius: 60px !important; }

    /* ═══ Template-specific ═══ */
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .5rem 1.2rem; border-radius: 60px;
      font-weight: 500; font-size: .75rem; letter-spacing: .01em;
      background: #111; color: #fff; border: none;
      transition: all .2s ease; cursor: pointer;
    }
    .btn-primary:hover { background: #333; }
    .btn-wa { background: #22c55e !important; }
    .btn-wa:hover { background: #16a34a !important; }
    .cart-bar {
      background: rgba(255,255,255,.95) !important;
      backdrop-filter: blur(20px) !important;
      border-top: 1px solid #eee !important;
    }
    .footer-muted { color: #ccc; border-top: 1px solid #eee; }
    .verify-badge {
      position:absolute;bottom:-2px;right:-2px;width:16px;height:16px;
      background:#22c55e;border-radius:50%;border:2px solid #fff;
      display:flex;align-items:center;justify-content:center;
      font-size:8px;color:#fff;font-weight:900;
    }
    .gallery-label { font-size:11px; color:#999; letter-spacing:.06em; }
    .gallery-price { font-size:14px; font-weight:600; color:#111; }
    .scrollbar-hide::-webkit-scrollbar{display:none}
    .scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none}
  </style>
</head>
<body>
  <header data-sec="hero" style="text-align:center;padding:64px 16px 40px;">
    <div style="position:relative;display:inline-block;">
      <img src="<%= biz.logo || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=f5f5f5&color=111&size=96' %>"
           style="width:88px;height:88px;border-radius:50%;object-fit:cover;"
           alt="<%= biz.name %>" />
      <span class="verify-badge">✓</span>
    </div>
    <h1 style="font-size:28px;font-weight:300;letter-spacing:-.03em;margin-top:24px;" data-editable="name"><%= biz.name %></h1>
    <p style="font-size:13px;color:#999;margin-top:8px;max-width:360px;margin-left:auto;margin-right:auto;"><%= biz.description %></p>
    <a href="<%= `https://wa.me/${biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp}` %>"
       class="btn-primary btn-wa" style="margin-top:20px;">Contactar</a>
  </header>
  <main data-sec="contenido" style="max-width:900px;margin:0 auto;padding:0 24px 112px;">
    <%- include('../partials/components', { biz, products, money, categories, components, pages, editMode, mascaraCss: mascaraCss, mascaraConfig: mascaraConfig }) %>
  </main>
  <%- include('../partials/cart-js', { biz, products }) %>
</body>
</html>