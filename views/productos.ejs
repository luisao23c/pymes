<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Productos', biz }) %>
</head>
<body class="m-material bg-slate-100 min-h-screen">
  <%- include('admin/sidebar', { biz, active: 'productos', canDesign }) %>

  <main class="md:pl-60">
    <div class="max-w-6xl mx-auto px-3 md:px-6 py-4 md:py-5 pb-24 md:pb-6">
      <script type="application/json" id="attr-templates-json"><%- safeJson(attributeTemplates || []) %></script>
      <script type="application/json" id="cat-json"><%- safeJson(categories || []) %></script>

      <!-- Encabezado -->
      <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <div>
          <h1 class="text-lg md:text-xl font-black tracking-tight text-slate-900">Mis productos</h1>
          <p class="text-xs text-slate-500 mt-0.5">
            <%= allProducts.length %> productos
            <% if (planMax !== Infinity) { %> · <%= allProducts.length %>/<%= planMax %> de tu plan <% } %>
          </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap justify-end">
          <a href="/<%= biz.slug %>/admin/exportar.xlsx" class="m-btn m-btn-outlined m-btn-sm" title="Descargar catálogo en Excel">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 10v6m0 0l-3-3m3 3l3-3M4 4h16v4H4zM4 12h16v8H4z"/></svg>
            Excel
          </a>
          <a href="/<%= biz.slug %>/admin/catalogo-print" target="_blank" class="m-btn m-btn-outlined m-btn-sm" title="Vista para imprimir / guardar PDF">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z"/></svg>
            Imprimir
          </a>
          <a href="/<%= biz.slug %>/admin/importar" class="m-btn m-btn-outlined m-btn-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
            Carga masiva
          </a>
          <a href="#nuevo-producto" class="m-btn m-btn-filled m-btn-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Nuevo
          </a>
        </div>
      </div>

      <% if (error) { %>
        <div id="panel-error" class="mb-3 bg-[var(--md-error-container)] text-[#8c1d18] text-sm font-bold px-4 py-3 rounded-xl m-pop flex items-center gap-2">
          <span class="shrink-0">⚠️</span><%= error %>
        </div>
      <% } %>

      <% if (biz.plan === 'free') { %>
        <div class="mb-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-2xl shadow-[var(--md-elevation-1)] px-4 py-3 flex items-center justify-between flex-wrap gap-2 m-ripple">
          <div class="flex items-center gap-3">
            <span class="text-xl">🚀</span>
            <div>
              <p class="font-extrabold text-sm">Plan Gratuito · <%= allProducts.length %>/<%= planMax %> productos</p>
              <p class="text-[11px] text-blue-100 mt-0.5">Productos ilimitados y atributos con el plan Pro.</p>
            </div>
          </div>
          <a href="/<%= biz.slug %>/admin/config" class="m-btn m-btn-filled m-btn-sm !bg-white !text-blue-700">Mejorar plan</a>
        </div>
      <% } %>

      <!-- Lista de productos -->
      <section id="productos" class="m-card p-4 mb-3 m-stagger relative">
        <div id="prod-loading" class="hidden absolute inset-0 z-20 items-center justify-center bg-white/70 backdrop-blur-[1px] rounded-xl">
          <div class="flex flex-col items-center gap-2">
            <span class="w-7 h-7 border-[3px] border-[var(--md-primary)] border-t-transparent rounded-full animate-spin"></span>
            <p class="text-xs font-bold text-slate-500">Cargando…</p>
          </div>
        </div>
        <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
          <h2 class="font-extrabold text-slate-900 text-sm">Catálogo <span class="m-badge m-badge-neutral !ml-1.5"><%= allProducts.length %></span></h2>
          <div class="relative">
            <input id="prod-search" type="text" placeholder="Buscar producto…" class="w-36 sm:w-56 border border-slate-200 rounded-full pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 mb-3" id="prod-filters">
          <button data-f="all" class="m-chip m-chip-selected !h-8">Todos <span class="m-badge m-badge-neutral !h-5 !text-[10px]"><%= allProducts.length %></span></button>
          <% const visibles = allProducts.filter(p => p.active).length; %>
          <button data-f="active" class="m-chip !h-8">Visibles <span class="m-badge m-badge-success !h-5 !text-[10px]"><%= visibles %></span></button>
          <button data-f="hidden" class="m-chip !h-8">Ocultos <span class="m-badge m-badge-neutral !h-5 !text-[10px]"><%= allProducts.length - visibles %></span></button>
          <% const agotados = allProducts.filter(p => p.stock !== null && p.stock <= 0).length; %>
          <button data-f="out" class="m-chip !h-8">Agotados <span class="m-badge m-badge-error !h-5 !text-[10px]"><%= agotados %></span></button>
          <% const bajos = allProducts.filter(p => p.stock !== null && p.stock > 0 && p.stock <= 5).length; %>
          <button data-f="low" class="m-chip !h-8">Stock bajo <span class="m-badge m-badge-warn !h-5 !text-[10px]"><%= bajos %></span></button>
          <% const enPromo = allProducts.filter(p => p.old_price).length; %>
          <button data-f="promo" class="m-chip !h-8">🔥 En promo <span class="m-badge m-badge-error !h-5 !text-[10px]"><%= enPromo %></span></button>
        </div>

        <% if (allProducts.length === 0) { %>
          <div class="text-center py-6 border-2 border-dashed border-slate-200 rounded-xl">
            <p class="text-2xl mb-1">📦</p>
            <p class="text-xs text-slate-500 font-semibold mb-3">Aún no tienes productos</p>
            <a href="#nuevo-producto" class="m-btn m-btn-filled m-btn-sm">Agregar mi primer producto</a>
          </div>
        <% } else { %>
          <div id="prod-grid" class="grid md:grid-cols-2 gap-2">
            <% allProducts.forEach((p, i) => { %>
              <div class="m-list-item m-ripple border border-slate-100 hover:border-slate-200 flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-3 <%= i >= 12 ? 'hidden' : '' %>" data-active-layer
                   data-search="<%= (p.name || '').toLowerCase() %>" data-state="<%= p.active ? 'active' : 'hidden' %>" data-stock="<%= p.stock === null ? '' : (p.stock > 5 ? 'ok' : (p.stock > 0 ? 'low' : 'out')) %>" data-promo="<%= p.old_price ? 1 : 0 %>"
                   data-edit-id="<%= p.id %>" data-edit-name="<%= (p.name || '').replace(/"/g, '&quot;') %>" data-edit-price="<%= p.price %>" data-edit-old="<%= p.old_price || '' %>"
                   data-edit-cat="<%= p.category_id || '' %>" data-edit-desc="<%= (p.description || '').replace(/"/g, '&quot;') %>" data-edit-image="<%= (p.image || '').replace(/"/g, '&quot;') %>" data-edit-galeria="<%= (p.galeria || '').replace(/"/g, '&quot;') %>"
                   data-edit-stock="<%= p.stock === null ? '' : p.stock %>" data-edit-variants="<%= encodeURIComponent(JSON.stringify(p.variants || [])) %>" data-edit-featured="<%= p.featured ? 1 : 0 %>" data-edit-promo="<%= p.promo_ends_at || '' %>"
                   data-edit-promo-type="<%= p.promo_type || '' %>" data-edit-promo-value="<%= p.promo_value || '' %>" data-edit-promo-gift="<%= (p.promo_gift || '').replace(/"/g, '&quot;') %>"
                   data-edit-sku="<%= (p.sku || '').replace(/"/g, '&quot;') %>" data-edit-tags="<%= (p.tags || '').replace(/"/g, '&quot;') %>" data-edit-video="<%= (p.video || '').replace(/"/g, '&quot;') %>" data-edit-specs="<%= (p.specs || '').replace(/"/g, '&quot;') %>" data-edit-barcode="<%= (p.barcode || '').replace(/"/g, '&quot;') %>">
                <div class="flex items-center gap-3 min-w-0 w-full sm:w-auto sm:flex-1">
                <img src="<%= p.image || '/img/sin-imagen.svg' %>" loading="lazy" class="w-11 h-11 rounded-xl object-cover shrink-0 border border-slate-100">
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-sm text-slate-800 truncate">
                    <% if (p.featured) { %><span title="Destacado">⭐</span><% } %> <%= p.name %>
                  </p>
                  <div class="flex items-center gap-1.5 flex-wrap mt-0.5">
                    <span class="text-[11px] text-slate-500 font-semibold"><%= money(p.price) %></span>
                    <% if (p.old_price) { %>
                      <span class="text-[10px] text-slate-400 line-through"><%= money(p.old_price) %></span>
                      <span class="m-badge !h-5 !text-[10px] m-badge-error">🔥 <%= p.promo_days !== undefined ? p.promo_days + ' días' : 'Promo' %></span>
                    <% } else if (p.promo_badge) { %>
                      <span class="m-badge !h-5 !text-[10px] m-badge-error"><%= p.promo_badge %></span>
                    <% } %>
                    <span class="w-0.5 h-0.5 rounded-full bg-slate-300"></span>
                    <span class="m-badge !h-5 !text-[10px] <%= p.active ? 'm-badge-success' : 'm-badge-neutral' %>"><%= p.active ? 'Visible' : 'Oculto' %></span>
                    <span class="m-badge !h-5 !text-[10px] <%= (p.stock === null || p.stock <= 0) ? 'm-badge-error' : 'm-badge-primary' %>"><%= (p.stock === null || p.stock <= 0) ? 'Agotado' : p.stock + ' en stock' %></span>
                    <% if (p.variantCount > 0) { %>
                      <span class="m-badge !h-5 !text-[10px] m-badge-warn"><%= p.variantCount %> <%= p.variantCount === 1 ? 'var.' : 'var.' %></span>
                    <% } %>
                  </div>
                </div>
                </div>
                <div class="flex items-center gap-0.5 flex-wrap justify-start sm:justify-end w-full sm:w-auto sm:shrink-0">
                  <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/mover">
                    <input type="hidden" name="dir" value="up">
                    <button class="m-btn-icon !w-9 !h-9 hover:!bg-slate-100 !text-slate-500" title="Subir producto"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 15l7-7 7 7"/></svg></button>
                  </form>
                  <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/mover">
                    <input type="hidden" name="dir" value="down">
                    <button class="m-btn-icon !w-9 !h-9 hover:!bg-slate-100 !text-slate-500" title="Bajar producto"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 9l7 7 7-7"/></svg></button>
                  </form>
                  <button class="m-btn-icon !w-8 !h-8 hover:!bg-blue-50 hover:!text-blue-600" title="Editar" onclick="editarProducto(this.closest('[data-edit-id]'))">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                  <button type="button" class="m-btn-icon !w-8 !h-8 hover:!bg-indigo-50 hover:!text-indigo-600" title="Duplicar" onclick="duplicarProducto(this.closest('[data-edit-id]'))">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 8h12v12H8zM8 8V4h12v12h-4M4 12h4"/></svg>
                  </button>
                  <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/featured">
                    <button class="m-btn-icon !w-8 !h-8 <%= p.featured ? '!text-amber-500' : '' %> hover:!bg-amber-50" title="Destacar"><%= p.featured ? '⭐' : '☆' %></button>
                  </form>
                  <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/toggle">
                    <label class="m-switch" title="<%= p.active ? 'Ocultar producto' : 'Mostrar producto' %>">
                      <input type="checkbox" <%= p.active ? 'checked' : '' %> onchange="this.form.requestSubmit()">
                      <span class="track"><span class="thumb"></span></span>
                    </label>
                  </form>
                  <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/eliminar" data-confirm="¿Eliminar <%= p.name.replace(/'/g, "\\'") %>?">
                    <button class="m-btn-icon !w-8 !h-8 hover:!bg-red-50 hover:!text-red-500" title="Eliminar">🗑</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
          <div id="prod-pager"></div>
        <% } %>
      </section>

      <!-- Agregar / editar producto (stepper) -->
      <section id="nuevo-producto" class="m-card p-4 mb-3" data-stepper>
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
          <h2 id="pf-title" class="font-extrabold text-slate-900 text-sm">Agregar producto</h2>
          <button type="button" id="pf-cancel" onclick="cancelarEdicion()" class="hidden text-xs font-bold text-red-500 hover:bg-red-50 px-3 py-1.5 rounded-full transition">✕ Cancelar edición</button>
        </div>

        <div id="pf-steps" class="flex items-center gap-1 mb-4 overflow-x-auto scrollbar-thin"></div>
        <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden mb-4">
          <div id="pf-bar" class="h-full bg-[var(--md-primary)] rounded-full transition-all duration-300" style="width:25%"></div>
        </div>

        <form method="POST" action="/<%= biz.slug %>/admin/producto" class="grid md:grid-cols-2 gap-x-4" id="pf-form">
          <div data-step-pane="1" class="md:col-span-2 grid md:grid-cols-2 gap-x-4">
            <div class="m-field">
              <label for="f-name">Nombre *</label>
              <input name="name" id="f-name" required placeholder="Ej: Taladro percutor 13mm">
            </div>
            <div class="m-field">
              <label for="f-cat">Categoría</label>
              <div class="flex items-center gap-2">
                <select name="category_id" id="f-cat" class="flex-1 min-w-0">
                  <option value="">Sin categoría</option>
                  <% categories.forEach(c => { %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                  <% }) %>
                </select>
                <button type="button" onclick="mostrarNuevaCategoria()" class="shrink-0 text-xs font-bold text-blue-600 hover:bg-blue-50 rounded-lg px-3 py-2">＋ Nueva</button>
              </div>
              <div id="cat-new-box" class="hidden mt-2 flex items-center gap-2">
                <input id="cat-new-input" type="text" placeholder="Nombre de la categoría" class="flex-1 min-w-0 border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <button type="button" onclick="crearCategoriaInline()" class="text-emerald-600 font-bold px-2">✓</button>
                <button type="button" onclick="document.getElementById('cat-new-box').classList.add('hidden')" class="text-slate-400 font-bold px-2">✕</button>
              </div>
            </div>
            <div class="m-field">
              <label for="f-price">Precio *</label>
              <input name="price" id="f-price" required type="number" step="0.01" min="0" placeholder="0.00">
            </div>
            <div class="m-field md:col-span-2">
              <label for="f-promo-type">Promoción <span class="font-normal text-slate-400">(opcional)</span></label>
              <select name="promo_type" id="f-promo-type" onchange="onPromoTypeChange()">
                <option value="">Sin promoción</option>
                <option value="descuento">💵 Precio rebajado (antes/ahora)</option>
                <option value="porcentaje">📉 Porcentaje de descuento</option>
                <option value="2x1">🛍️ 2x1 · lleva 2 paga 1</option>
                <option value="3x2">🛍️ 3x2 · lleva 3 paga 2</option>
                <option value="regalo">🎁 Lleva de regalo</option>
              </select>
            </div>
            <div id="promo-desc" class="m-field hidden">
              <label for="f-old">Precio antes</label>
              <input name="old_price" id="f-old" type="number" step="0.01" min="0" placeholder="0.00">
            </div>
            <div id="promo-pct" class="m-field hidden">
              <label for="f-promo-value">% de descuento</label>
              <input name="promo_value" id="f-promo-value" type="number" min="1" max="99" placeholder="20">
            </div>
            <div id="promo-gift" class="m-field hidden">
              <label for="f-promo-gift">¿Qué regalas?</label>
              <input name="promo_gift" id="f-promo-gift" placeholder="Ej: Martillo de uña 16oz">
            </div>
            <div id="promo-ends" class="m-field hidden">
              <label for="f-promo">La promo vence el… (opcional)</label>
              <input name="promo_ends_at" id="f-promo" type="date" placeholder=" ">
            </div>
            <div class="m-field" id="f-stock-wrap">
              <label for="f-stock" id="f-stock-label">Stock (0 o vacío = agotado)</label>
              <input name="stock" id="f-stock" type="number" min="0" placeholder=" ">
              <p id="f-stock-note" class="hidden text-[11px] font-bold text-amber-600 mt-1">Este producto tiene atributos: el stock se define por cada combinación en el paso 3 (Atributos).</p>
            </div>
            <div class="m-field">
              <label for="f-sku">SKU / código interno <span class="font-normal text-slate-400">(opcional)</span></label>
              <input name="sku" id="f-sku" placeholder="Ej: TAL-001">
            </div>
            <div class="m-field">
              <label for="f-barcode">Código de barras <span class="font-normal text-slate-400">(opcional)</span></label>
              <input name="barcode" id="f-barcode" placeholder="Ej: 7501234567890">
            </div>
            <div class="m-field md:col-span-2">
              <label for="f-tags">Etiquetas <span class="font-normal text-slate-400">(separadas por coma — mejoran la búsqueda)</span></label>
              <input name="tags" id="f-tags" placeholder="Ej: taladro, inalámbrico, batería">
            </div>
            <div class="m-field md:col-span-2">
              <label for="f-specs">Características <span class="font-normal text-slate-400">(una por línea: "Marca: Bosch")</span></label>
              <textarea name="specs" id="f-specs" rows="3" placeholder="Marca: Bosch&#10;Material: Acero&#10;Garantía: 1 año"></textarea>
            </div>
            <div class="m-field md:col-span-2">
              <label for="f-desc">Descripción atractiva</label>
              <textarea name="description" id="f-desc" rows="2" placeholder="Describe los beneficios…"></textarea>
            </div>
            <label class="md:col-span-2 flex items-center gap-2.5 bg-slate-50 rounded-xl px-4 py-3 text-sm font-bold text-slate-600 cursor-pointer">
              <input type="checkbox" name="featured" id="f-featured" value="1" class="w-4.5 h-4.5 accent-amber-500">
              ⭐ Producto destacado
            </label>
          </div>

          <div data-step-pane="2" class="md:col-span-2 hidden">
            <label class="font-bold text-xs text-slate-600 mb-1.5 block">Fotos del producto <span class="font-normal text-slate-400">(puedes subir varias — la primera es la portada)</span></label>
            <div class="grid grid-cols-3 sm:grid-cols-4 gap-2" id="f-fotos"></div>
            <label class="group cursor-pointer border-2 border-dashed border-slate-200 hover:border-[var(--md-primary)] hover:bg-blue-50/30 rounded-2xl p-4 text-center transition block mt-2">
              <input id="f-fotos-input" type="file" accept="image/*" multiple class="hidden" onchange="subirVarias('f', this)">
              <div class="text-2xl mb-1 group-hover:scale-110 transition">📷</div>
              <p class="text-xs font-bold text-slate-600">Subir fotos</p>
              <p class="text-[10px] text-slate-400 mt-0.5">Elige varias a la vez · .jpg .png .webp (máx 5MB c/u)</p>
            </label>
            <div class="mt-3">
              <label class="font-bold text-xs text-slate-600 mb-1.5 block">Video <span class="font-normal text-slate-400">(opcional, 1 por producto — pega una URL)</span></label>
              <input name="video" id="f-video" placeholder="https://… (YouTube, Vimeo o .mp4)" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
            </div>
            <input type="hidden" name="image" id="f-image">
            <input type="hidden" name="galeria" id="f-galeria">
          </div>

          <div data-step-pane="3" class="md:col-span-2 hidden">
            <div class="rounded-2xl border border-slate-200 p-3 mb-4">
              <p class="font-bold text-xs text-slate-700 mb-2">1 · Elige los atributos de este producto</p>
              <div id="f-tpl-pills" class="flex flex-wrap gap-2 items-center"></div>
              <p id="f-tpl-empty" class="text-[11px] text-slate-400 mt-1.5"></p>
            </div>

            <div class="mb-4">
              <p class="font-bold text-xs text-slate-700 mb-2">2 · Atributos seleccionados <span class="font-normal text-slate-400">(puedes ajustar los valores aquí)</span></p>
              <div id="f-var-box" class="space-y-2"></div>
            </div>

            <div>
              <p class="font-bold text-xs text-slate-700 mb-2">3 · Combinaciones <span class="font-normal text-slate-400">(toca cada una para subirle su foto — si no le pones, usa la del producto)</span></p>
              <div id="f-combo-box"></div>
            </div>
            <input type="hidden" name="variants" id="f-var-hidden">
          </div>

          <div data-step-pane="4" class="md:col-span-2 hidden">
            <div id="pf-resumen" class="rounded-2xl bg-slate-50 border border-slate-100 p-4 text-sm"></div>
          </div>

          <div class="md:col-span-2 mt-4 flex items-center gap-2">
            <button type="button" id="pf-back" class="m-btn m-btn-outlined hidden">← Atrás</button>
            <button type="button" id="pf-next" class="m-btn m-btn-filled">Siguiente →</button>
            <button type="submit" id="pf-save" class="m-btn m-btn-filled flex-1 hidden">Guardar producto</button>
          </div>
        </form>
      </section>

      <!-- Categorías -->
      <section id="categorias" class="m-card p-4 mb-3">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
          <h3 class="font-bold text-sm text-slate-700">Categorías <span class="m-badge m-badge-neutral !ml-1.5"><%= categories.length %></span></h3>
          <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
            <input id="cat-name" placeholder="Nueva categoría" class="w-full sm:w-52 border border-slate-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
            <button type="button" onclick="agregarCategoria()" class="m-btn m-btn-tonal m-btn-sm shrink-0">Crear</button>
          </div>
        </div>
        <div id="cat-list" class="flex flex-wrap gap-1.5"></div>
      </section>

      <!-- Mis atributos -->
      <section id="mis-atributos" class="m-card p-4 mb-3">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
          <h3 class="font-bold text-sm text-slate-700">Mis atributos <span class="m-badge m-badge-neutral !ml-1.5"><span id="attr-count">0</span></span></h3>
        </div>
        <div class="flex flex-col sm:flex-row gap-2 w-full mb-3">
          <input id="attr-name" placeholder="Nombre (ej: Talla)" class="w-full sm:w-44 border border-slate-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
          <input id="attr-values" placeholder="Valores separados por coma (XS, M, L)" class="w-full sm:flex-1 border border-slate-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
          <button type="button" onclick="agregarAtributo()" class="m-btn m-btn-tonal m-btn-sm shrink-0">Guardar</button>
        </div>
        <p class="text-[11px] text-slate-400 mb-3">Guárdalos una sola vez y úsalos en cualquier producto. Guardar con el mismo nombre actualiza los valores.</p>
        <div id="attr-list" class="flex flex-wrap gap-1.5"></div>
      </section>

    </div>
  </main>

  <a href="#nuevo-producto" class="m-fab m-ripple" title="Agregar producto">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
  </a>

  <!-- Editor de imagen -->
  <div id="img-editor" class="hidden fixed inset-0 z-[120] flex items-center justify-center bg-black/70 backdrop-blur-sm p-3">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
      <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">
        <h3 class="font-bold text-sm text-slate-800">Editar imagen</h3>
        <button type="button" onclick="cerrarEditorImagen()" class="text-slate-400 hover:text-slate-600 font-bold text-lg leading-none">✕</button>
      </div>
      <div class="p-4">
        <div id="img-editor-wrap" class="relative w-full overflow-hidden rounded-xl bg-checker select-none flex items-center justify-center" style="max-height:52vh;">
          <canvas id="img-editor-canvas" width="800" height="800" class="max-w-full max-h-[52vh] block"></canvas>
        </div>
        <div class="flex items-center gap-2 mt-3 flex-wrap">
          <button type="button" id="img-btn-fit" onclick="imgModo('contain')" class="text-xs font-bold px-3 py-1.5 rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50">Ajustar</button>
          <button type="button" id="img-btn-cover" onclick="imgModo('cover')" class="text-xs font-bold px-3 py-1.5 rounded-full border border-blue-600 bg-blue-50 text-blue-700">Expandir</button>
          <span class="text-[10px] text-slate-400 flex-1 text-right">Arrastra para mover</span>
        </div>
        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
          <span class="text-[10px] text-slate-400 mr-1">Aspecto</span>
          <button type="button" class="img-aspect" data-a="1:1" onclick="imgAspect('1:1')">1:1</button>
          <button type="button" class="img-aspect" data-a="4:3" onclick="imgAspect('4:3')">4:3</button>
          <button type="button" class="img-aspect" data-a="16:9" onclick="imgAspect('16:9')">16:9</button>
          <button type="button" class="img-aspect" data-a="3:4" onclick="imgAspect('3:4')">3:4</button>
          <span class="mx-1 text-slate-200">|</span>
          <button type="button" onclick="imgRotar()" title="Rotar 90°" class="text-xs font-bold px-2.5 py-1.5 rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50">⟳ Rotar</button>
          <button type="button" onclick="imgEspejo()" title="Voltear horizontal" class="text-xs font-bold px-2.5 py-1.5 rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50">⇋ Voltear</button>
          <button type="button" onclick="imgReset()" title="Restaurar original" class="text-xs font-bold px-2.5 py-1.5 rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50">↺ Restaurar</button>
        </div>
        <div class="flex items-center gap-2 mt-2">
          <span class="text-xs text-slate-400 shrink-0">Zoom</span>
          <input id="img-zoom" type="range" min="1" max="3" step="0.01" value="1" class="flex-1" oninput="imgZoomChange(this.value)">
        </div>
        <div class="flex gap-2 mt-4">
          <button type="button" onclick="cerrarEditorImagen()" class="flex-1 m-btn m-btn-outlined">Cancelar</button>
          <button type="button" onclick="aplicarEditorImagen()" class="flex-1 m-btn m-btn-filled">Aplicar</button>
        </div>
