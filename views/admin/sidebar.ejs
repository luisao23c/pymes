<!-- ============================================================
BOTTOM NAV MÓVIL (máx 4 opciones + "Más")
============================================================ -->
<% const PRIO = { panel:0, productos:1, clientes:2, proveedores:3, config:4, importar:5, empleados:6, planes:7 }; %>
<% const navItems = items.slice().sort((a, b) => ((PRIO[a.id] !== undefined ? PRIO[a.id] : 99) - (PRIO[b.id] !== undefined ? PRIO[b.id] : 99))); %>
<% const mainNav = navItems.slice(0, 4); const moreNav = navItems.slice(4); %>
<nav class="m-bottomnav md:hidden m-scroll">
  <div class="flex w-full">
    <% mainNav.forEach(it => { %>
      <a href="<%= it.href %>" class="m-ripple <%= active === it.id ? 'm-active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="<%= it.icon %>"/></svg>
        <span><%= it.label %></span>
      </a>
    <% }) %>
    <% if (moreNav.length) { %>
      <button type="button" class="m-ripple <%= moreNav.some(x => x.id === active) ? 'm-active' : '' %>" onclick="abrirMasMenu()">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
        <span>Más</span>
      </button>
    <% } %>
  </div>
</nav>

<!-- Menú "Más" (móvil) -->
<div id="mas-menu" class="md:hidden fixed inset-0 z-[60] hidden">
  <div class="absolute inset-0 bg-black/50" onclick="document.getElementById('mas-menu').classList.add('hidden')"></div>
  <div class="absolute bottom-0 left-0 right-0 bg-white dark:bg-slate-900 rounded-t-2xl p-4 pb-8 max-h-[72vh] overflow-y-auto m-scroll">
    <div class="flex items-center justify-between mb-3">
      <p class="font-extrabold text-slate-800 dark:text-white text-sm">Más opciones</p>
      <button type="button" onclick="document.getElementById('mas-menu').classList.add('hidden')" class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 font-bold">✕</button>
    </div>
    <div class="grid grid-cols-3 gap-2">
      <% moreNav.forEach(it => { %>
        <a href="<%= it.href %>" class="flex flex-col items-center gap-1.5 py-3 rounded-xl <%= active === it.id ? 'bg-indigo-50 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300' : 'bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300' %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="<%= it.icon %>"/></svg>
          <span class="text-[11px] font-bold text-center leading-tight"><%= it.label %></span>
        </a>
      <% }) %>
    </div>
  </div>
</div>
<script>
  function abrirMasMenu() { var m = document.getElementById('mas-menu'); if (m) m.classList.remove('hidden'); }
</script>

<script>
  // Sidebar toggle (desktop)
  function toggleSidebar() {
    var body = document.body;
    if (window.innerWidth >= 768) {
      body.classList.toggle('sidebar-closed');
      try { localStorage.setItem('panel_sidebar', body.classList.contains('sidebar-closed') ? 'closed' : 'open'); } catch(e) {}
    } else {
      body.classList.toggle('sidebar-open');
    }
  }
  function closeSidebarMobile() {
    document.body.classList.remove('sidebar-open');
  }
  (function() {
    // Restore sidebar state
    try {
      var state = localStorage.getItem('panel_sidebar');
      if (state === 'closed') document.body.classList.add('sidebar-closed');
    } catch(e) {}
    // On mobile: default closed
    if (window.innerWidth < 768) {
      document.body.classList.remove('sidebar-closed');
    }
  })();
