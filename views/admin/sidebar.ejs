<%
  const permsList = (typeof perms !== 'undefined' && Array.isArray(perms)) ? perms : ['productos.ver','productos.crear','productos.editar','productos.eliminar','pedidos.gestionar','reportes','config','empleados'];
  const has = (p) => permsList.includes(p);
  const hasModule = (m) => permsList.some(p => p === m || p.indexOf(m + '.') === 0);
  const items = [
    { id: 'panel', label: 'Panel', show: () => has('reportes') || has('pedidos.gestionar'), href: '/' + biz.slug + '/admin/panel', icon: 'M3 12h18M3 6h18M3 18h12M17 18h4' },
    { id: 'productos', label: 'Productos', show: () => hasModule('productos'), href: '/' + biz.slug + '/admin/productos', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
    { id: 'importar', label: 'Carga masiva', show: () => false, href: '/' + biz.slug + '/admin/importar', icon: 'M12 4v12m0 0l-4-4m4 4l4-4M4 20h16' },
    { id: 'empleados', label: 'Empleados', show: () => has('empleados'), href: '/' + biz.slug + '/admin/empleados', icon: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zm14 10v-2a4 4 0 00-3-3.87M15 3.13a4 4 0 010 7.75' },
    { id: 'clientes', label: 'Clientes', show: () => has('clientes'), href: '/' + biz.slug + '/admin/clientes', icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m9-6.13a4 4 0 100-8 4 4 0 000 8zM16 7a4 4 0 11-8 0 4 4 0 018 0z' },
    { id: 'proveedores', label: 'Proveedores', show: () => has('config'), href: '/' + biz.slug + '/admin/proveedores', icon: 'M3 3v18h18M8 14h4m-4-4h4M7 7h10m-7 12h10' },
    { id: 'config', label: 'Configuración', show: () => has('config'), href: '/' + biz.slug + '/admin/config', icon: 'M4 6h16M4 12h16M4 18h10M14 18h6' },
    { id: 'planes', label: 'Planes', show: () => has('config'), href: '/' + biz.slug + '/admin/planes', icon: 'M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zm4 12h6m-6-4h6m-6-4h6' }
  ].filter(it => it.show());
  const avatar = biz.logo || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(biz.name) + '&background=17324a&color=fff');
  const isPro = biz.plan === 'pro';
  const esEmpleado = typeof isEmployee !== 'undefined' && isEmployee;
%>

<!-- ============================================================
SIDEBAR NUEVO (diseño totalmente distinto)
- Fondo claro con borde lateral
- Perfil en la parte superior con nombre y plan
- Enlaces principales centrados, con icono + texto, estilo "botón"
- Opciones secundarias (modo oscuro, upgrade, salir) en la parte inferior
- Barra lateral sutil en el borde izquierdo
============================================================ -->

<!-- Botón toggle sidebar (desktop) -->
<button class="sidebar-toggle" onclick="toggleSidebar()" title="Ocultar/Mostrar menú">
  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h12M3 12h12M3 18h12"/></svg>
</button>

<!-- Overlay móvil -->
<div class="sidebar-overlay" onclick="closeSidebarMobile()"></div>

<aside class="fixed inset-y-0 left-0 w-60 hidden md:flex flex-col z-40 transition-all duration-300" style="background:var(--ap-card);border-right:1px solid var(--ap-border);color:var(--ap-text)">

  <!-- Perfil: logo + nombre + plan (padding-right reserva el espacio del botón de colapsar,
       que es position:fixed y no empuja el layout por sí solo) -->
  <div class="pl-5 pr-14 pt-6 pb-5 shrink-0" style="border-bottom:1px solid var(--ap-border)">
    <div class="flex items-center gap-3">
      <img src="<%= avatar %>" class="w-9 h-9 rounded-lg object-cover shrink-0" style="border:1px solid var(--ap-border)">
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-[13.5px] truncate leading-tight" style="color:var(--ap-text)"><%= esEmpleado ? (typeof empName !== 'undefined' ? empName : 'Empleado') : biz.name %></p>
        <p class="text-[10.5px] font-semibold uppercase tracking-[0.1em] mt-1" style="color:<%= isPro ? 'var(--ap-accent-text)' : 'var(--ap-text-sec)' %>">
          <%= esEmpleado ? 'Empleado' : (isPro ? 'Plan Pro' : (biz.plan === 'demo' ? 'Demo' : 'Plan gratis')) %>
        </p>
      </div>
    </div>
  </div>

  <!-- Enlaces principales -->
  <nav class="m-sidebar flex-1 px-3 py-5 space-y-0.5 overflow-y-auto m-scroll">
    <% items.forEach(it => { %>
      <% const act = active === it.id; %>
      <a href="<%= it.href %>"
         class="m-ripple group flex items-center gap-3 px-3 py-2.5 rounded-lg text-[13.5px] font-medium transition-colors duration-150
                <%= act ? 'm-active-nav' : '' %>" style="<%= act ? '' : 'color:var(--ap-text-sec)' %>">
        <svg class="w-[17px] h-[17px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.75"><path d="<%= it.icon %>"/></svg>
        <span class="flex-1"><%= it.label %></span>
        <% if (it.id === 'panel') { %><span id="new-orders-badge" style="display:none" class="min-w-5 h-5 px-1.5 rounded-full bg-red-500 text-white text-[10px] font-black items-center justify-center">0</span><% } %>
        <% if (it.id === 'productos') { %><span id="low-stock-badge" style="display:<%= (typeof lowStockCount !== 'undefined' && lowStockCount > 0) ? 'flex' : 'none' %>" class="min-w-5 h-5 px-1.5 rounded-full bg-red-500 text-white text-[10px] font-black items-center justify-center" title="Productos con stock bajo o agotado"><%= (typeof lowStockCount !== 'undefined') ? lowStockCount : 0 %></span><% } %>
      </a>
    <% }) %>
  </nav>

  <!-- Pie: opciones secundarias (modo oscuro, salir) -->
  <div class="px-3 pb-5 space-y-1 pt-3" style="border-top:1px solid var(--ap-border)">
    <div class="flex items-center justify-between px-3 py-2">
      <span class="flex items-center gap-2.5 text-[13px] font-medium" style="color:var(--ap-text-sec)">
        <svg class="w-[17px] h-[17px]" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"/></svg>
        Modo oscuro
      </span>
      <button type="button" onclick="toggleDark()" class="m-switch m-ripple">
        <input id="dark-toggle" type="checkbox">
        <span class="track"><span class="thumb"></span></span>
      </button>
    </div>

    <a href="/<%= biz.slug %>/admin/salir"
       class="m-ripple flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors" style="color:var(--ap-text-sec)"
       onmouseover="this.style.color='#b43232'" onmouseout="this.style.color='var(--ap-text-sec)'">
      <svg class="w-[17px] h-[17px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4m7 14l5-5-5-5m5 5H9"/></svg>
      Salir
    </a>
  </div>
</aside>

<!-- ============================================================
SCRIPT: Toggle modo oscuro
============================================================ -->
<script>
  function toggleDark() {
    var on = document.body.classList.toggle('dark');
    try { localStorage.setItem('panel_dark', on ? '1' : '0'); } catch (e) {}
  }
  (function () {
    var dark = false;
    try { dark = localStorage.getItem('panel_dark') === '1'; } catch (e) {}
    if (dark) document.body.classList.add('dark');
    var t = document.getElementById('dark-toggle');
    if (t) t.checked = dark;
  })();
</script>

<script>
  // Notificación de pedidos nuevos (sin recargar): badge + sonido cuando llega un pedido.
  (function () {
    var badge = document.getElementById('new-orders-badge');
    var onPanel = <%= (active === 'panel') ? 'true' : 'false' %>;
    var showPanel = <%= (has('reportes') || has('pedidos.gestionar')) ? 'true' : 'false' %>;
    if (!showPanel) return;
    var slug = '<%= biz.slug %>';
    var key = 'lastOrder_' + slug;
    var lastSeen = 0, initialized = false, prevCount = 0;
    try { lastSeen = parseInt(localStorage.getItem(key) || '0', 10) || 0; } catch (e) {}
    function beep() {
      try {
        var AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        var ctx = new AC();
        var o = ctx.createOscillator(), g = ctx.createGain();
        o.type = 'sine'; o.frequency.value = 880;
        o.connect(g); g.connect(ctx.destination);
        g.gain.setValueAtTime(0.0001, ctx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.4);
        o.start(); o.stop(ctx.currentTime + 0.42);
      } catch (e) {}
    }
    function poll() {
      fetch('/' + slug + '/admin/api/new-orders', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d || d.lastId === undefined) return;
          if (!initialized) {
            if (!lastSeen) lastSeen = d.lastId;
            initialized = true;
          }
          if (onPanel) {
            lastSeen = d.lastId;
            if (badge) badge.style.display = 'none';
            try { localStorage.setItem(key, String(lastSeen)); } catch (e) {}
            prevCount = 0;
            return;
          }
          var count = d.lastId - lastSeen;
          if (count > 0) {
            if (badge) { badge.textContent = count; badge.style.display = 'flex'; }
            if (count > prevCount) {
              beep();
              if (window.mostrarToast) mostrarToast(count + ' pedido(s) nuevo(s) 🛎️', 'ok');
            }
          }
          prevCount = count;
        }).catch(function () {});
    }
    poll();
    setInterval(poll, 15000);
  })();
</script>

<script>
  // Aviso de stock bajo (sin recargar): badge + sonido cuando algo se va agotando.
  (function () {
    var badge = document.getElementById('low-stock-badge');
    if (!badge) return;
    var slug = '<%= biz.slug %>';
    var prev = parseInt(badge.textContent, 10) || 0;
    var first = true;
    function beep() {
      try {
        var AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        var ctx = new AC();
        var o = ctx.createOscillator(), g = ctx.createGain();
        o.type = 'sine'; o.frequency.value = 660;
        o.connect(g); g.connect(ctx.destination);
        g.gain.setValueAtTime(0.0001, ctx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.35);
        o.start(); o.stop(ctx.currentTime + 0.37);
      } catch (e) {}
    }
    function poll() {
      fetch('/' + slug + '/admin/api/low-stock', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d || d.count === undefined) return;
          if (badge) {
            if (d.count > 0) { badge.textContent = d.count; badge.style.display = 'flex'; }
            else badge.style.display = 'none';
          }
          if (!first && d.count > prev) {
            beep();
            if (window.mostrarToast) mostrarToast('⚠️ ' + d.count + ' producto(s) con stock bajo', 'info');
          }
          first = false;
          prev = d.count;
        }).catch(function () {});
    }
    poll();
    setInterval(poll, 30000);
  })();
</script>

<!-- ============================================================
BARRA SUPERIOR MÓVIL (sin cambios, solo para móvil)
============================================================ -->
<header class="admin-mobile-topbar md:hidden" style="color:var(--ap-text)">
  <div class="admin-mobile-topbar__inner flex items-center justify-between">
    <a href="<%= items.length ? items[0].href : '/' + biz.slug + '/admin/panel' %>" class="admin-mobile-topbar__brand flex items-center gap-2 min-w-0" aria-label="Inicio del panel de <%= biz.name %>">
      <img src="<%= avatar %>" class="w-8 h-8 rounded-lg object-cover shrink-0">
      <span class="font-extrabold text-sm truncate"><%= biz.name %></span>
    </a>
    <div class="admin-mobile-topbar__actions">
      <a href="/<%= biz.slug %>" target="_blank" class="admin-mobile-topbar__action" title="Ver catálogo" aria-label="Ver catálogo público">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/></svg>
      </a>
      <a href="/<%= biz.slug %>/admin/salir" class="admin-mobile-topbar__action" title="Salir" aria-label="Cerrar sesión">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4m7 14l5-5-5-5m5 5H9"/></svg>
      </a>
    </div>
  </div>
</header>

<!-- ============================================================
BOTTOM NAV MÓVIL (máx 4 opciones + "Más")
============================================================ -->
<% const PRIO = { panel:0, productos:1, clientes:2, proveedores:3, config:4, importar:5, empleados:6, planes:7 }; %>
<% const navItems = items.slice().sort((a, b) => ((PRIO[a.id] !== undefined ? PRIO[a.id] : 99) - (PRIO[b.id] !== undefined ? PRIO[b.id] : 99))); %>
<% const mainNav = navItems.slice(0, 4); const moreNav = navItems.slice(4); %>
<nav class="m-bottomnav md:hidden m-scroll" aria-label="Navegación principal">
  <div class="flex w-full">
    <% mainNav.forEach(it => { %>
      <a href="<%= it.href %>" class="m-ripple <%= active === it.id ? 'm-active' : '' %>" <%= active === it.id ? 'aria-current="page"' : '' %>>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="<%= it.icon %>"/></svg>
        <span><%= it.label %></span>
      </a>
    <% }) %>
    <% if (moreNav.length) { %>
      <button type="button" class="m-ripple <%= moreNav.some(x => x.id === active) ? 'm-active' : '' %>" onclick="abrirMasMenu()" aria-controls="mas-menu" aria-expanded="false" id="mas-menu-trigger">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
        <span>Más</span>
      </button>
    <% } %>
  </div>
</nav>

<!-- Menú "Más" (móvil) -->
<div id="mas-menu" class="md:hidden fixed inset-0 z-[60] hidden" role="dialog" aria-modal="true" aria-labelledby="mas-menu-title">
  <div class="mobile-sheet-backdrop absolute inset-0 bg-black/50" onclick="cerrarMasMenu()"></div>
  <div class="mobile-sheet-panel absolute bottom-0 left-0 right-0 rounded-t-2xl p-5 pb-8 max-h-[72vh] overflow-y-auto m-scroll" style="background:var(--ap-card)">
    <span class="mobile-sheet-handle" aria-hidden="true"></span>
    <div class="flex items-center justify-between mb-4">
      <p id="mas-menu-title" class="font-semibold text-[15px]" style="color:var(--ap-text)">Más opciones</p>
      <button type="button" onclick="cerrarMasMenu()" class="w-11 h-11 rounded-xl grid place-items-center" style="background:var(--ap-bg);color:var(--ap-text-sec)" aria-label="Cerrar más opciones"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 5 8 8m0-8-8 8"/></svg></button>
    </div>
    <div class="mobile-more-grid grid grid-cols-3 gap-2">
      <% moreNav.forEach(it => { %>
        <a href="<%= it.href %>" class="flex flex-col items-center gap-2 py-3.5 rounded-lg" style="<%= active === it.id ? 'background:var(--ap-accent);color:#fff' : 'background:var(--ap-bg);color:var(--ap-text-sec)' %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75"><path d="<%= it.icon %>"/></svg>
          <span class="text-[11px] font-medium text-center leading-tight"><%= it.label %></span>
        </a>
      <% }) %>
    </div>
  </div>
</div>
<script>
  function abrirMasMenu() {
    var m = document.getElementById('mas-menu');
    var trigger = document.getElementById('mas-menu-trigger');
    if (!m) return;
    m.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    if (trigger) trigger.setAttribute('aria-expanded', 'true');
    var close = m.querySelector('[aria-label="Cerrar más opciones"]');
    if (close) close.focus();
  }
  function cerrarMasMenu() {
    var m = document.getElementById('mas-menu');
    var trigger = document.getElementById('mas-menu-trigger');
    if (!m) return;
    m.classList.add('hidden');
    document.body.style.overflow = '';
    if (trigger) { trigger.setAttribute('aria-expanded', 'false'); trigger.focus(); }
  }
</script>

<script>
  // Sidebar toggle (desktop)
  function toggleSidebar() {
    var body = document.body;
    if (window.innerWidth >= 768) {
      body.classList.toggle('sidebar-closed');
      try { localStorage.setItem('panel_sidebar', body.classList.contains('sidebar-closed') ? 'closed' : 'open'); } catch(e) {}
    } else {
      body.classList.toggle('sidebar-open');
    }
  }
  function closeSidebarMobile() {
    document.body.classList.remove('sidebar-open');
  }
  (function() {
    // Restore sidebar state
    try {
      var state = localStorage.getItem('panel_sidebar');
      if (state === 'closed') document.body.classList.add('sidebar-closed');
    } catch(e) {}
    // On mobile: default closed
    if (window.innerWidth < 768) {
      document.body.classList.remove('sidebar-closed');
    }
  })();
</script>
