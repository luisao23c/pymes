<!-- ============================================================
SIDEBAR NUEVO (diseño totalmente distinto)
- Fondo claro con borde lateral
- Perfil en la parte superior con nombre y plan
- Enlaces principales centrados, con icono + texto, estilo "botón"
- Opciones secundarias (modo oscuro, upgrade, salir) en la parte inferior
- Barra lateral sutil en el borde izquierdo
============================================================ -->

<!-- Botón toggle sidebar (desktop) -->
<button class="sidebar-toggle" onclick="toggleSidebar()" title="Ocultar/Mostrar menú">
  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h12M3 12h12M3 18h12"/></svg>
</button>

<!-- Overlay móvil -->
<div class="sidebar-overlay" onclick="closeSidebarMobile()"></div>

<aside class="fixed inset-y-0 left-0 w-56 backdrop-blur-sm hidden md:flex flex-col z-40 transition-all duration-300" style="background:var(--ap-card);border-right:1px solid var(--ap-border);color:var(--ap-text);box-shadow:var(--ap-shadow-md)">
  
  <!-- Perfil: logo + nombre + plan, alineado horizontalmente -->
  <div class="px-4 pt-5 pb-3 shrink-0" style="border-bottom:1px solid var(--ap-border)">
    <div class="flex items-center gap-3">
      <div class="relative shrink-0">
        <img src="<%= avatar %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-white/20 dark:ring-slate-700/30 shadow-sm">
        <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-400 ring-2 ring-white dark:ring-slate-900"></span>
      </div>
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-sm truncate leading-tight"><%= esEmpleado ? (typeof empName !== 'undefined' ? empName : 'Empleado') : biz.name %></p>
        <span class="inline-block text-[10px] font-bold tracking-wide mt-0.5 px-2 py-0.5 rounded-full <%= esEmpleado ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : (isPro ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300' : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400') %>">
          <%= esEmpleado ? 'EMPLEADO' : (isPro ? '★ PRO' : 'GRATIS') %>
        </span>
      </div>
    </div>
  </div>

  <!-- Enlaces principales (centrados, estilo botón) -->
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto m-scroll">
    <% items.forEach(it => { %>
      <% const act = active === it.id; %>
      <a href="<%= it.href %>"
         class="m-ripple group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200
                <%= act ? 'm-active-nav' : '' %>" style="<%= act ? '' : 'color:var(--ap-text-sec)' %>">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition"
                     style="<%= act ? 'background:rgba(255,255,255,0.2);color:#fff' : 'background:transparent;color:var(--ap-text-sec)' %>">
          <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.9"><path d="<%= it.icon %>"/></svg>
        </span>
        <span class="flex-1"><%= it.label %></span>
        <% if (it.id === 'panel') { %><span id="new-orders-badge" style="display:none" class="min-w-5 h-5 px-1.5 rounded-full bg-red-500 text-white text-[10px] font-black items-center justify-center">0</span><% } %>
        <% if (it.id === 'productos') { %><span id="low-stock-badge" style="display:<%= (typeof lowStockCount !== 'undefined' && lowStockCount > 0) ? 'flex' : 'none' %>" class="min-w-5 h-5 px-1.5 rounded-full bg-red-500 text-white text-[10px] font-black items-center justify-center" title="Productos con stock bajo o agotado"><%= (typeof lowStockCount !== 'undefined') ? lowStockCount : 0 %></span><% } %>
        <% if (act) { %>
          <span class="w-1.5 h-1.5 rounded-full bg-white shadow-[0_0_8px_2px_rgba(255,255,255,.3)]"></span>
        <% } %>
      </a>
    <% }) %>
  </nav>

  <!-- Pie: opciones secundarias (modo oscuro, salir) -->
  <div class="px-3 pb-3 space-y-2 pt-2" style="border-top:1px solid var(--ap-border)">
    <div class="flex items-center justify-between px-2 py-1.5">
      <span class="flex items-center gap-2 text-xs font-medium" style="color:var(--ap-text-sec)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"/></svg>
        Modo oscuro
      </span>
