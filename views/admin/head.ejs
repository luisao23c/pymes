<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf" content="<%= csrf %>">
<title><%= title %> | <%= biz.name %></title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
        boxShadow: {
          card: '0 1px 2px 0 rgb(0 0 0 / 0.04), 0 1px 3px 0 rgb(0 0 0 / 0.05)',
          float: '0 10px 30px -10px rgb(0 0 0 / 0.18)'
        }
      }
    }
  };
</script>
<style>
  body { font-family: 'Inter', system-ui, sans-serif; }
  .scrollbar-thin::-webkit-scrollbar { width: 6px; height: 6px; }
  .scrollbar-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
  .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
  input[type="number"]::-webkit-outer-spin-button,
  input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .fade-in { animation: fadeIn .25s ease both; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .toast-in { animation: toastIn .25s ease both; }
  @keyframes toastIn { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
</style>
<link rel="stylesheet" href="/css/material.css">
<script src="/js/material.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Inyecta el token CSRF en todos los formularios (incluso tras re-render AJAX)
  (function () {
    function csrfValue() {
      var m = document.querySelector('meta[name="csrf"]');
      return m ? m.getAttribute('content') : '';
    }
    function injectAll() {
      var t = csrfValue();
      if (!t) return;
      document.querySelectorAll('form').forEach(function (f) {
        if (f.querySelector('input[name="_csrf"]')) return;
        var i = document.createElement('input');
        i.type = 'hidden'; i.name = '_csrf'; i.value = t;
        f.appendChild(i);
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', injectAll);
    else injectAll();
    var main = document.querySelector('main');
    if (main && 'MutationObserver' in window) {
      new MutationObserver(function () { injectAll(); }).observe(main, { childList: true, subtree: true });
    }
    window.__csrfValue = csrfValue;
  })();
</script>
