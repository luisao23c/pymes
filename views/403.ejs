<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sin permiso · <%= biz.name %></title>
  <script src="/vendor/tailwind.js"></script>
</head>
<body class="bg-slate-100 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">
    <!-- Cabecera con la tienda -->
    <div class="px-6 pt-6 pb-4 flex items-center gap-3 border-b border-slate-100">
      <% if (biz.logo) { %>
        <img src="<%= biz.logo %>" class="w-10 h-10 rounded-xl object-cover">
      <% } else { %>
        <div class="w-10 h-10 rounded-xl bg-[#2c2c2e] text-white flex items-center justify-center font-black text-lg"><%= biz.name.charAt(0) %></div>
      <% } %>
      <div class="min-w-0">
        <p class="font-extrabold text-sm text-slate-800 truncate"><%= biz.name %></p>
        <p class="text-[11px] font-bold text-amber-600 tracking-wide">EMPLEADO</p>
      </div>
      <a href="/<%= biz.slug %>/admin/salir" class="ml-auto text-xs font-bold text-red-500 hover:text-red-600 transition">Cerrar sesión</a>
    </div>

    <div class="px-6 py-8 text-center">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-red-50 flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15v2m0-4h.01M7 8h10a1 1 0 011 1v10a1 1 0 01-1 1H7a1 1 0 01-1-1V9a1 1 0 011-1zm5 7v2m0-4h.01"/></svg>
      </div>
      <h1 class="font-extrabold text-lg text-slate-900">No tienes permiso para ver esta sección</h1>
      <p class="text-sm text-slate-500 mt-2 leading-relaxed">
        <% if (empName) { %>El PIN de <strong class="text-slate-700"><%= empName %></strong> solo permite ciertas secciones del panel, y esta no está incluida.<% } else { %>Tu PIN solo permite ciertas secciones del panel, y esta no está incluida.<% } %>
      </p>

      <% if (permsLabels && permsLabels.length) { %>
        <div class="mt-5 text-left bg-slate-50 rounded-xl p-4 border border-slate-100">
          <p class="text-[11px] font-black text-slate-400 uppercase tracking-wider mb-2">Tus accesos actuales</p>
          <div class="flex flex-wrap gap-1.5">
            <% permsLabels.forEach(l => { %>
              <span class="text-xs font-semibold bg-white border border-slate-200 text-slate-600 px-2.5 py-1 rounded-full"><%= l %></span>
            <% }) %>
          </div>
        </div>
      <% } %>

      <p class="text-xs text-slate-400 mt-4 leading-relaxed">
        Si necesitas entrar aquí, pídele al dueño de la tienda que active esta sección desde
        <strong class="text-slate-500">Empleados → ✎ Editar</strong>.
      </p>

      <div class="mt-6 flex flex-col gap-2">
        <% if (home) { %>
          <a href="<%= home %>" class="w-full inline-flex items-center justify-center gap-2 bg-[#2c2c2e] hover:bg-[#454548] text-white text-sm font-bold px-4 py-3 rounded-xl transition">
            ← Ir a mi sección permitida
          </a>
        <% } %>
        <a href="/<%= biz.slug %>" class="w-full inline-flex items-center justify-center text-xs font-bold text-slate-400 hover:text-slate-600 transition">Volver a la tienda</a>
      </div>
    </div>
  </div>
</body>
</html>