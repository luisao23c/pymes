<!-- ============================================================
EDITOR DE IMAGEN PROFESIONAL (compartido entre productos, config y diseno)
Incluir con: EJS include de partials/img-editor pasando upUrl (endpoint de subida) y z (z-index).
API globales compatibles:
  abrirEditorImagen(src, onDone?, onCancel?)  — o pasar un contenedor [data-url] con img
  cerrarEditorImagen() / aplicarEditorImagen()
Hooks opcionales de la página (definir antes de abrir):
  window.imgeUploaded(url)            → tras subir la imagen editada con éxito
  window.imgeContainerApplied(el,url) → tras aplicar sobre un contenedor [data-url]
============================================================ -->
<style>
  .imge-ov{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:14px;background:rgba(15,23,42,.6);backdrop-filter:blur(4px);opacity:0;pointer-events:none;transition:opacity .18s ease;}
  .imge-ov.open{opacity:1;pointer-events:auto;}
  .imge-card{background:#fff;border-radius:18px;box-shadow:0 24px 70px rgba(15,23,42,.35);width:100%;max-width:940px;max-height:94vh;display:flex;flex-direction:column;overflow:hidden;font-family:inherit;color:#0f172a;}
  .imge-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid #eef1f6;flex-shrink:0;}
  .imge-head .imge-logo{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#4f46e5,#7c3aed);display:flex;align-items:center;justify-content:center;font-size:15px;}
  .imge-head h3{margin:0;font-size:15px;font-weight:800;flex:1;}
  .imge-x{width:30px;height:30px;border:none;border-radius:9px;background:#f1f5f9;color:#64748b;font-size:15px;font-weight:800;cursor:pointer;}
  .imge-x:hover{background:#fee2e2;color:#b91c1c;}
  .imge-body{display:grid;grid-template-columns:1.25fr .95fr;gap:0;overflow:hidden;min-height:0;}
  .imge-main{display:flex;flex-direction:column;min-width:0;}
  .imge-stage{position:relative;flex:1;min-height:320px;display:flex;align-items:center;justify-content:center;background:#f8fafc;background-image:linear-gradient(45deg,#eef1f6 25%,transparent 25%),linear-gradient(-45deg,#eef1f6 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eef1f6 75%),linear-gradient(-45deg,transparent 75%,#eef1f6 75%);background-size:18px 18px;background-position:0 0,0 9px,9px -9px,-9px 0;overflow:hidden;touch-action:none;}
  .imge-stage canvas{max-width:100%;max-height:60vh;display:block;box-shadow:0 4px 22px rgba(15,23,42,.16);border-radius:8px;background:#fff;cursor:grab;}
  .imge-stage.drag canvas{cursor:grabbing;}
  .imge-compare{position:absolute;left:10px;bottom:10px;border:1px solid #e2e8f0;background:#fff;color:#334155;font-size:11px;font-weight:800;padding:7px 11px;border-radius:20px;box-shadow:0 2px 8px rgba(0,0,0,.12);cursor:pointer;user-select:none;}
  .imge-compare.hold{background:#0f172a;color:#fff;}
  .imge-cdims{position:absolute;right:10px;bottom:10px;background:rgba(15,23,42,.55);color:#fff;font-size:10px;font-weight:700;padding:4px 8px;border-radius:8px;letter-spacing:.3px;}
  .imge-mainfoot{padding:10px 14px;border-top:1px solid #eef1f6;display:flex;align-items:center;gap:10px;flex-shrink:0;}
  .imge-mainfoot .imge-hint{font-size:10.5px;color:#94a3b8;flex:1;}
  .imge-zoom{flex:1;max-width:240px;accent-color:#4f46e5;}
  .imge-panel{border-left:1px solid #eef1f6;overflow-y:auto;padding:12px 14px 14px;display:flex;flex-direction:column;gap:12px;background:#fcfcfe;}
  .imge-sec{background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:10px 11px;}
  .imge-sec h5{margin:0 0 8px;font-size:10px;font-weight:900;letter-spacing:.09em;text-transform:uppercase;color:#94a3b8;display:flex;align-items:center;gap:6px;}
  .imge-row-tools{display:flex;gap:6px;flex-wrap:wrap;}
  .imge-btn{display:inline-flex;align-items:center;justify-content:center;gap:4px;font-size:11px;font-weight:800;color:#475569;background:#fff;border:1px solid #e2e8f0;border-radius:9px;padding:6px 9px;cursor:pointer;transition:all .12s;}
  .imge-btn:hover{background:#eef2ff;border-color:#c7d2fe;color:#4338ca;}
  .imge-btn.on{background:#4f46e5;border-color:#4f46e5;color:#fff;box-shadow:0 2px 8px rgba(79,70,229,.3);}
  .imge-chips{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;}
  .imge-chip{display:flex;flex-direction:column;align-items:center;gap:4px;padding:6px 2px;border:1px solid #e2e8f0;border-radius:9px;background:#fff;cursor:pointer;}
  .imge-chip:hover{border-color:#c7d2fe;}
  .imge-chip.on{border-color:#4f46e5;background:#eef2ff;box-shadow:0 0 0 1px #4f46e5;}
  .imge-chip .sw{width:100%;height:26px;border-radius:6px;background:linear-gradient(135deg,#6366f1,#a5b4fc);}
  .imge-chip span{font-size:9.5px;font-weight:800;color:#475569;}
  .imge-chip.on span{color:#4338ca;}
  .imge-adj{display:flex;flex-direction:column;gap:8px;}
  .imge-adj .row{display:flex;align-items:center;gap:8px;}
  .imge-adj .row .lbl{width:74px;font-size:11px;font-weight:700;color:#475569;flex-shrink:0;}
  .imge-adj .row input[type=range]{flex:1;accent-color:#4f46e5;min-width:0;}
  .imge-adj .row .val{width:34px;text-align:right;font-size:10.5px;font-weight:800;color:#64748b;}
  .imge-adj .row .rst{border:none;background:none;color:#cbd5e1;font-size:12px;cursor:pointer;padding:0 2px;width:14px;}
  .imge-adj .row .rst:hover{color:#ef4444;}
  .imge-orient{display:flex;flex-direction:column;gap:8px;}
  .imge-orient .btns{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;}
  .imge-orient .fine{display:flex;align-items:center;gap:8px;}
  .imge-orient .fine span{font-size:10.5px;font-weight:800;color:#94a3b8;width:46px;flex-shrink:0;}
  .imge-orient .fine input[type=range]{flex:1;accent-color:#4f46e5;}
  .imge-foot{display:flex;gap:10px;padding:12px 16px;border-top:1px solid #eef1f6;flex-shrink:0;background:#fff;}
  .imge-foot button{flex:1;padding:10px;border-radius:10px;font-size:13px;font-weight:800;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#475569;}
  .imge-foot button:hover{border-color:#cbd5e1;background:#f8fafc;}
  .imge-foot .imge-cancel:hover{background:#fef2f2;border-color:#fecaca;color:#b91c1c;}
  .imge-foot .imge-apply{background:#4f46e5;border-color:#4f46e5;color:#fff;}
  .imge-foot .imge-apply:hover{background:#4338ca;}
  .imge-foot .imge-apply:disabled{opacity:.55;cursor:wait;}
  @media (max-width:760px){ .imge-body{grid-template-columns:1fr;overflow-y:auto;} .imge-stage{min-height:240px;} .imge-stage canvas{max-height:40vh;} }
</style>

<div id="imge-ov" class="imge-ov" style="z-index:<%= (typeof z !== 'undefined') ? z : 9000 %>">
  <div class="imge-card" role="dialog" aria-modal="true" aria-label="Editor de imagen">
    <div class="imge-head">
      <div class="imge-logo">🖼️</div>
      <h3>Editar imagen</h3>
      <button type="button" class="imge-x" onclick="imgeClose()" title="Cerrar">✕</button>
    </div>

    <div class="imge-body">
      <!-- Columna: vista previa -->
      <div class="imge-main">
        <div class="imge-stage" id="imge-stage">
          <canvas id="imge-canvas" width="800" height="800"></canvas>
          <button type="button" class="imge-compare" id="imge-compare" title="Mantén presionado para ver el original">◉ Ver original</button>
          <span class="imge-cdims" id="imge-dims"></span>
        </div>
        <div class="imge-mainfoot">
          <span class="imge-hint">Arrastra para encuadrar</span>
          <input type="range" id="imge-zoom" class="imge-zoom" min="1" max="4" step="0.01" value="1">
          <span class="imge-hint" style="width:44px;text-align:right" id="imge-zoomval">100%</span>
        </div>
      </div>

      <!-- Columna: controles -->
      <aside class="imge-panel">
        <div class="imge-sec">
          <h5>1 · Formato</h5>
          <div class="imge-row-tools" style="margin-bottom:8px">
            <button type="button" class="imge-btn on" id="imge-mode-cover" onclick="imgeMode('cover')">⬒ Expandir</button>
            <button type="button" class="imge-btn" id="imge-mode-contain" onclick="imgeMode('contain')">⬜ Ajustar</button>
          </div>
          <div class="imge-chips" id="imge-aspects"></div>
        </div>

        <div class="imge-sec">
          <h5>2 · Ajustes</h5>
          <div class="imge-adj" id="imge-adjs"></div>
        </div>

        <div class="imge-sec">
          <h5>3 · Filtros</h5>
          <div class="imge-chips" id="imge-filters" style="grid-template-columns:repeat(4,1fr)"></div>
        </div>

        <div class="imge-sec">
          <h5>4 · Orientación</h5>
          <div class="imge-orient">
            <div class="btns">
              <button type="button" class="imge-btn" onclick="imgeRot90(-1)" title="Girar 90° a la izquierda">⟲</button>
              <button type="button" class="imge-btn" onclick="imgeRot90(1)" title="Girar 90° a la derecha">⟳</button>
              <button type="button" class="imge-btn" id="imge-flipx" onclick="imgeFlipX()" title="Voltear horizontal">⇋</button>
              <button type="button" class="imge-btn" id="imge-flipy" onclick="imgeFlipY()" title="Voltear vertical">⇵</button>
            </div>
            <div class="fine">
              <span>Enderezar</span>
              <input type="range" id="imge-fine" min="-45" max="45" step="0.5" value="0">
              <button type="button" class="imge-btn rst" onclick="imgeFine(0);document.getElementById('imge-fine').value=0" title="Quitar inclinación">↺</button>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <div class="imge-foot">
      <button type="button" class="imge-cancel" onclick="imgeClose()">Cancelar</button>
      <button type="button" onclick="imgeResetAll()">↺ Restaurar todo</button>
      <button type="button" class="imge-apply" id="imge-apply" onclick="imgeApply()">✓ Aplicar</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  if (window.__imgeLoaded) return; // evitar doble carga si la página incluye el partial dos veces
  window.__imgeLoaded = true;

  var UP_URL = '<%= (typeof upUrl !== 'undefined') ? upUrl : "" %>';
  var S = {
    img: null, mode: 'cover', aspect: '1:1',
    zoom: 1, panX: 0, panY: 0, baseScale: 1,
    rotQ: 0, fine: 0, flipX: false, flipY: false,
    adj: { br: 0, co: 0, sa: 0 },
    fx: { g: 0, sep: 0, h: 0 },
    preset: 'original',
    outW: 800, outH: 800,
    compare: false, applying: false,
    cbDone: null, cbCancel: null, container: null, rawBBox: null
  };

  var ADJ = [
    { k: 'br', lbl: 'Brillo' },
    { k: 'co', lbl: 'Contraste' },
    { k: 'sa', lbl: 'Saturación' }
  ];
  var ASPECTS = [
    { v: '1:1', w: 1, h: 1 }, { v: '4:5', w: 4, h: 5 }, { v: '3:4', w: 3, h: 4 },
    { v: '2:3', w: 2, h: 3 }, { v: '4:3', w: 4, h: 3 }, { v: '3:2', w: 3, h: 2 },
    { v: '16:9', w: 16, h: 9 }, { v: '9:16', w: 9, h: 16 }, { v: 'libre', w: 0, h: 0 }
  ];
  // Filtros rápidos (valores relativos al centro: br/co/sa en %, g/sep 0..1, h grados)
  var PRESETS = {
    original: { br: 0, co: 0, sa: 0, g: 0, sep: 0, h: 0 },
    vivo:     { br: 3, co: 12, sa: 45, g: 0, sep: 0, h: 0 },
    bn:       { br: 0, co: 12, sa: 0, g: 1, sep: 0, h: 0 },
    sepia:    { br: 8, co: -4, sa: -10, g: 0, sep: .8, h: -6 },
    frio:     { br: 2, co: 2, sa: 14, g: 0, sep: 0, h: 16 },
    calido:   { br: 5, co: 0, sa: 10, g: 0, sep: 0, h: -14 },
    mate:     { br: 16, co: -24, sa: -20, g: 0, sep: 0, h: 0 },
    contra:   { br: 0, co: 40, sa: 8, g: 0, sep: 0, h: 0 },
    vintage:  { br: 12, co: -10, sa: -16, g: 0, sep: .45, h: -4 }
  };
  var PRESET_META = {
    original: ['Original', '#e2e8f0'], vivo: ['Vívido', 'linear-gradient(135deg,#22c55e,#a3e635)'],
    bn: ['B/N', 'linear-gradient(135deg,#475569,#cbd5e1)'], sepia: ['Sepia', 'linear-gradient(135deg,#92400e,#fcd34d)'],
    frio: ['Frío', 'linear-gradient(135deg,#3b82f6,#7dd3fc)'], calido: ['Cálido', 'linear-gradient(135deg,#ea580c,#fbbf24)'],
    mate: ['Mate', 'linear-gradient(135deg,#f1f5f9,#94a3b8)'], contra: ['Alto', 'linear-gradient(135deg,#0f172a,#64748b)'],
    vintage: ['Vintage', 'linear-gradient(135deg,#b45309,#fde68a)']
  };

  var $ = function (id) { return document.getElementById(id); };

  function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }

  function totToast(msg, tipo) {
    try { if (window.mostrarToast) window.mostrarToast(msg, tipo || 'error'); }
    catch (e) { try { alert(msg); } catch (e2) {} }
  }

  function csrf() { try { return (window.__csrfValue && window.__csrfValue()) || ''; } catch (e) { return ''; } }

  function cssFilter() {
    var a = S.adj, f = S.fx;
    var br = clamp(1 + a.br / 100, 0, 2.4);
    var co = clamp(1 + a.co / 100, 0, 2.4);
    var sa = clamp(1 + a.sa / 100, 0, 3);
    var p = 'brightness(' + br.toFixed(3) + ') contrast(' + co.toFixed(3) + ') saturate(' + sa.toFixed(3) + ')';
    if (f.g) p += ' grayscale(1)';
    if (f.sep) p += ' sepia(' + f.sep + ')';
    if (f.h) p += ' hue-rotate(' + f.h + 'deg)';
    return p;
  }

  function rotation() { return (S.rotQ + S.fine) % 360; }

  function bboxOf() {
    var img = S.img, r = rotation() * Math.PI / 180;
    var c = Math.abs(Math.cos(r)), sn = Math.abs(Math.sin(r));
    return { w: img.width * c + img.height * sn, h: img.width * sn + img.height * c };
  }

  function outSize() {
    if (S.aspect === 'libre') {
      var bb = bboxOf();
      var m = Math.max(bb.w, bb.h), k = Math.min(1, 1600 / (m || 1));
      return { W: Math.max(64, Math.round(bb.w * k)), H: Math.max(64, Math.round(bb.h * k)) };
    }
    var a = null;
    for (var i = 0; i < ASPECTS.length; i++) if (ASPECTS[i].v === S.aspect) a = ASPECTS[i];
    if (!a) a = ASPECTS[0];
    var MAX = 1200;
    var W, H;
    if (a.w >= a.h) { W = MAX; H = Math.round(MAX * a.h / a.w); }
    else { H = MAX; W = Math.round(MAX * a.w / a.h); }
    return { W: W, H: H };
  }

  function draw() {
    var canvas = $('imge-canvas'), img = S.img;
    if (!canvas || !img) return;
    if (S.compare) { drawOriginal(canvas); return; }
    var sz = outSize();
    if (canvas.width !== sz.W) canvas.width = sz.W;
    if (canvas.height !== sz.H) canvas.height = sz.H;
    S.outW = sz.W; S.outH = sz.H;
    var ctx = canvas.getContext('2d');
    var bb = bboxOf();
    var scale = S.mode === 'cover'
      ? Math.max(sz.W / bb.w, sz.H / bb.h) * S.zoom
      : Math.min(sz.W / bb.w, sz.H / bb.h);
    var rot = rotation() * Math.PI / 180;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, sz.W, sz.H);
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, sz.W, sz.H);
    ctx.save();
    ctx.translate(sz.W / 2, sz.H / 2);
    if (S.flipX) ctx.scale(-1, 1);
    if (S.flipY) ctx.scale(1, -1);
    if (rot) ctx.rotate(rot);
    var css = cssFilter();
    try { ctx.filter = css; } catch (e) {}
    ctx.drawImage(img, -img.width / 2 + (S.mode === 'cover' ? S.panX : 0), -img.height / 2 + (S.mode === 'cover' ? S.panY : 0), img.width * scale, img.height * scale);
    ctx.restore();
    try { ctx.filter = 'none'; } catch (e) {}
    $('imge-dims').textContent = sz.W + ' × ' + sz.H;
  }

  function drawOriginal(canvas) {
    var img = S.img;
    var sz = outSize();
    var ctx = canvas.getContext('2d');
    var k = Math.min(sz.W / img.width, sz.H / img.height);
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, sz.W, sz.H);
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, sz.W, sz.H);
    try { ctx.filter = 'none'; } catch (e) {}
    ctx.drawImage(img, (sz.W - img.width * k) / 2, (sz.H - img.height * k) / 2, img.width * k, img.height * k);
  }

  function recalc() {
    if (!S.img) return;
    var sz = outSize();
    var bb = bboxOf();
    S.baseScale = S.mode === 'cover'
      ? Math.max(sz.W / bb.w, sz.H / bb.h)
      : Math.min(sz.W / bb.w, sz.H / bb.h);
    S.zoom = 1;
    S.panX = 0; S.panY = 0;
    var z = $('imge-zoom'); if (z) { z.value = 1; z.disabled = S.mode !== 'cover'; }
    var zv = $('imge-zoomval'); if (zv) zv.textContent = '100%';
    draw();
  }

  function panClamp() {
    if (S.mode !== 'cover') { S.panX = 0; S.panY = 0; return; }
    var sz = outSize(), bb = bboxOf();
    var w = bb.w * S.baseScale * S.zoom, h = bb.h * S.baseScale * S.zoom;
    var maxX = Math.max(0, (w - sz.W) / 2), maxY = Math.max(0, (h - sz.H) / 2);
    S.panX = clamp(S.panX, -maxX, maxX);
    S.panY = clamp(S.panY, -maxY, maxY);
  }

  function zoomSet(v, updateInput) {
    if (S.mode !== 'cover') v = 1;
    S.zoom = clamp(parseFloat(v) || 1, 1, 4);
    panClamp();
    var zv = $('imge-zoomval'); if (zv) zv.textContent = Math.round(S.zoom * 100) + '%';
    if (updateInput) { var z = $('imge-zoom'); if (z) z.value = S.zoom; }
    draw();
  }

  // ---- Construcción de controles ----
  function buildAspects() {
    var box = $('imge-aspects');
    ASPECTS.forEach(function (a) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'imge-chip' + (a.v === S.aspect ? ' on' : '');
      b.innerHTML = '<span class="sw" style="background:' + (a.v === 'libre' ? 'repeating-linear-gradient(45deg,#cbd5e1 0 4px,#eef1f6 4px 8px)' : '#c7d2fe') + '"></span><span>' + (a.v === 'libre' ? 'Libre' : a.v) + '</span>';
      b.onclick = function () {
        S.aspect = a.v;
        buildAspects();
        recalc();
      };
      box.appendChild(b);
    });
  }

  function buildAdjs() {
    var box = $('imge-adjs');
    if (!box || box.children.length) return; // solo se construyen una vez
    ADJ.forEach(function (d) {
      var row = document.createElement('div');
      row.className = 'row';
      row.innerHTML = '<span class="lbl">' + d.lbl + '</span>' +
        '<input type="range" min="-100" max="100" step="1" value="0" data-k="' + d.k + '">' +
        '<span class="val">0</span>' +
        '<button type="button" class="rst" title="Restablecer">↺</button>';
      var inp = row.querySelector('input'), val = row.querySelector('.val'), rst = row.querySelector('.rst');
      function paint() { val.textContent = (S.adj[d.k] > 0 ? '+' : '') + S.adj[d.k]; rst.style.visibility = S.adj[d.k] ? 'visible' : 'hidden'; }
      inp.addEventListener('input', function () {
        if (S.preset !== 'original') { S.preset = 'original'; buildFilters(); }
        S.adj[d.k] = parseInt(inp.value, 10) || 0;
        paint(); draw();
      });
      rst.addEventListener('click', function () {
        if (S.preset !== 'original') { S.preset = 'original'; buildFilters(); }
        S.adj[d.k] = 0; inp.value = 0; paint(); draw();
      });
      paint();
      box.appendChild(row);
    });
  }

  function presetSwatch(key) {
    var f = PRESETS[key];
    var br = clamp(1 + f.br / 100, .2, 1.8), co = clamp(1 + f.co / 100, .2, 1.8), sa = clamp(1 + f.sa / 100, 0, 2);
    var p = 'brightness(' + br + ') contrast(' + co + ') saturate(' + sa + ')';
    if (f.g) p += ' grayscale(1)';
    if (f.sep) p += ' sepia(' + f.sep + ')';
    if (f.h) p += ' hue-rotate(' + f.h + 'deg)';
    return p;
  }

  function buildFilters() {
    var box = $('imge-filters');
    box.innerHTML = '';
    Object.keys(PRESETS).forEach(function (key) {
      var meta = PRESET_META[key];
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'imge-chip' + (S.preset === key ? ' on' : '');
      b.innerHTML = '<span class="sw" style="filter:' + presetSwatch(key) + ';background:linear-gradient(135deg,#c084fc,#818cf8)"></span><span>' + meta[0] + '</span>';
      b.onclick = function () { applyPreset(key); };
      box.appendChild(b);
    });
  }

  function applyPreset(key) {
    var p = PRESETS[key];
    S.preset = key;
    S.adj.br = p.br; S.adj.co = p.co; S.adj.sa = p.sa;
    S.fx.g = p.g; S.fx.sep = p.sep; S.fx.h = p.h;
    syncSliders(); buildFilters(); draw();
  }

  function syncSliders() {
    var rows = $('imge-adjs').querySelectorAll('.row');
    rows.forEach(function (row) {
      var k = row.querySelector('input').getAttribute('data-k');
      row.querySelector('input').value = S.adj[k];
      row.querySelector('.val').textContent = (S.adj[k] > 0 ? '+' : '') + S.adj[k];
      row.querySelector('.rst').style.visibility = S.adj[k] ? 'visible' : 'hidden';
    });
  }

  // ---- Acciones públicas (compatibles con los onclick de las páginas) ----
  function imgeMode(m) {
    S.mode = m;
    $('imge-mode-cover').classList.toggle('on', m === 'cover');
    $('imge-mode-contain').classList.toggle('on', m === 'contain');
    recalc();
  }
  function imgeRot90(dir) { S.rotQ = (S.rotQ + dir * 90 + 360) % 360; recalc(); }
  function imgeFine(v) { S.fine = clamp(parseFloat(v) || 0, -45, 45); draw(); }
  function imgeFlipX() { S.flipX = !S.flipX; $('imge-flipx').classList.toggle('on', S.flipX); draw(); }
  function imgeFlipY() { S.flipY = !S.flipY; $('imge-flipy').classList.toggle('on', S.flipY); draw(); }
  function imgeResetAll() {
    S.mode = 'cover'; S.aspect = '1:1'; S.zoom = 1; S.panX = 0; S.panY = 0;
    S.rotQ = 0; S.fine = 0; S.flipX = false; S.flipY = false;
    S.adj = { br: 0, co: 0, sa: 0 }; S.fx = { g: 0, sep: 0, h: 0 };
    S.preset = 'original'; S.compare = false;
    $('imge-fine').value = 0;
    $('imge-flipx').classList.remove('on'); $('imge-flipy').classList.remove('on');
    $('imge-mode-cover').classList.add('on'); $('imge-mode-contain').classList.remove('on');
    buildAspects(); buildFilters(); syncSliders();
    recalc();
  }
  function imgeClose() {
    var cancel = S.cbCancel;
    S.cbDone = null; S.cbCancel = null; S.container = null; S.compare = false;
    $('imge-ov').classList.remove('open');
    document.body.style.overflow = '';
    if (cancel) try { cancel(); } catch (e) {}
  }
  function imgeOpen(src, onDone, onCancel, container) {
    if (!src) return;
    S.cbDone = onDone || null;
    S.cbCancel = onCancel || null;
    S.container = container || null;
    var img = new Image();
    img.onload = function () {
      S.img = img;
      S.mode = 'cover'; S.aspect = '1:1'; S.rotQ = 0; S.fine = 0;
      S.flipX = false; S.flipY = false;
      S.adj = { br: 0, co: 0, sa: 0 }; S.fx = { g: 0, sep: 0, h: 0 };
      S.preset = 'original'; S.compare = false;
      $('imge-fine').value = 0;
      $('imge-flipx').classList.remove('on'); $('imge-flipy').classList.remove('on');
      $('imge-mode-cover').classList.add('on'); $('imge-mode-contain').classList.remove('on');
      buildAspects(); buildFilters(); syncSliders();
      $('imge-ov').classList.add('open');
      document.body.style.overflow = 'hidden';
      recalc();
    };
    img.onerror = function () { totToast('No se pudo cargar la imagen'); };
    img.src = src;
  }
  function imgeApply() {
    var canvas = $('imge-canvas');
    if (!canvas || !S.img || S.applying) return;
    S.applying = true;
    S.compare = false;
    draw();
    var btn = $('imge-apply'); if (btn) btn.disabled = true;
    canvas.toBlob(function (blob) {
      if (!blob) { S.applying = false; if (btn) btn.disabled = false; totToast('No se pudo procesar la imagen'); return; }
      var cbDone = S.cbDone, container = S.container;
      S.cbDone = null; S.cbCancel = null; S.container = null;
      var fd = new FormData();
      fd.append('foto', blob, 'editada.png');
      var tok = csrf();
      if (tok) fd.append('_csrf', tok);
      fetch(UP_URL, { method: 'POST', body: fd, headers: tok ? { 'x-csrf-token': tok } : {}, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          imgeClose();
          S.applying = false; if (btn) btn.disabled = false;
          if (d && d.url) {
            try { if (window.imgeUploaded) window.imgeUploaded(d.url); } catch (e) {}
            if (container) {
              container.setAttribute('data-url', d.url);
              var im = container.querySelector('img');
              if (im) im.src = d.url;
              try { if (window.imgeContainerApplied) window.imgeContainerApplied(container, d.url); } catch (e) {}
            }
            if (cbDone) try { cbDone(d.url); } catch (e) {}
            totToast('Imagen aplicada ✓', 'ok');
          } else {
            totToast('No se pudo guardar la imagen');
            if (cbDone) try { cbDone(null); } catch (e) {}
          }
        })
        .catch(function () {
          imgeClose();
          S.applying = false; if (btn) btn.disabled = false;
          totToast('Error al guardar la imagen');
        });
    }, 'image/png');
  }

  // ---- Gestos ----
  function initGestures() {
    var stage = $('imge-stage');
    var dragging = false, sx = 0, sy = 0, sox = 0, soy = 0;
    function pt(e) { return (e.touches && e.touches.length) ? e.touches[0] : e; }
    function start(e) {
      if (!S.img || S.compare || S.mode !== 'cover') return;
      dragging = true;
      var p = pt(e);
      sx = p.clientX; sy = p.clientY; sox = S.panX; soy = S.panY;
      stage.classList.add('drag');
      if (e.cancelable) e.preventDefault();
    }
    function move(e) {
      if (!dragging) return;
      var p = pt(e);
      var rect = stage.getBoundingClientRect();
      var sz = outSize();
      var kx = sz.W / (rect.width || 1), ky = sz.H / (rect.height || 1);
      S.panX = sox + (p.clientX - sx) * kx;
      S.panY = soy + (p.clientY - sy) * ky;
      panClamp();
      draw();
      if (e.cancelable) e.preventDefault();
    }
    function end() { dragging = false; stage.classList.remove('drag'); }
    stage.addEventListener('mousedown', start);
    window.addEventListener('mousemove', move);
    window.addEventListener('mouseup', end);
    stage.addEventListener('touchstart', start, { passive: false });
    window.addEventListener('touchmove', move, { passive: false });
    window.addEventListener('touchend', end);
    stage.addEventListener('wheel', function (e) {
      if (!S.img || S.mode !== 'cover') return;
      if (e.cancelable) e.preventDefault();
      zoomSet(S.zoom * (e.deltaY < 0 ? 1.1 : 0.9), true);
    }, { passive: false });

    // Comparar: mantener pulsado
    var cmp = $('imge-compare');
    function down() { if (!S.img) return; S.compare = true; cmp.classList.add('hold'); draw(); }
    function up() { if (!S.compare) return; S.compare = false; cmp.classList.remove('hold'); draw(); }
    cmp.addEventListener('mousedown', down);
    cmp.addEventListener('touchstart', down, { passive: true });
    window.addEventListener('mouseup', up);
    window.addEventListener('touchend', up);
    cmp.addEventListener('mouseleave', up);
  }

  function initZoom() {
    var z = $('imge-zoom');
    z.addEventListener('input', function () { zoomSet(z.value, false); });
  }

  function initFine() {
    $('imge-fine').addEventListener('input', function () { imgeFine(this.value); });
  }

  // API pública (compat con las páginas que ya llaman abrirEditorImagen)
  window.abrirEditorImagen = function (a, b, c) {
    if (a && a.nodeType === 1) {
      var url = a.getAttribute('data-url');
      imgeOpen(url, null, null, a);
    } else {
      imgeOpen(a, (typeof b === 'function') ? b : null, (typeof c === 'function') ? c : null);
    }
  };
  window.cerrarEditorImagen = imgeClose;
  window.aplicarEditorImagen = imgeApply;
  window.imgeOpen = imgeOpen;
  window.imgeClose = imgeClose;
  window.imgeApply = imgeApply;
  window.imgeMode = imgeMode;
  window.imgeRot90 = imgeRot90;
  window.imgeFine = imgeFine;
  window.imgeFlipX = imgeFlipX;
  window.imgeFlipY = imgeFlipY;
  window.imgeResetAll = imgeResetAll;

  initGestures();
  initZoom();
  initFine();
  buildAdjs();
})();
</script>
