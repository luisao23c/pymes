  <script>
    (function () {
      if (!<%= editMode ? 'true' : 'false' %>) return;
      function msg(o) { try { parent.postMessage(o, '*'); } catch (e) {} }
      function parsePath(s) { var a = String(s || '').split(':').filter(Boolean); var out = []; for (var i = 0; i + 1 < a.length; i += 2) out.push([a[i], parseInt(a[i + 1]) || 0]); return out; }
      function pathOf(el) { return parsePath(el.getAttribute('data-path')); }
      function deselectAll() { document.querySelectorAll('.c-wrap.c-selected').forEach(function (x) { x.classList.remove('c-selected'); }); closePop(); }
      var pop = null;
      function closePop() { if (pop && pop.parentNode) pop.parentNode.removeChild(pop); pop = null; }
      function sel(key, label, opts) { return '<span class="c-pop-lbl">' + label + '</span><select data-k="' + key + '">' + opts.map(function (o) { return '<option value="' + o[0] + '">' + o[1] + '</option>'; }).join('') + '</select>'; }
      function openPop(wrap) {
        closePop();
        var id = wrap.getAttribute('data-cid');
        var type = wrap.getAttribute('data-ctype');
        var path = pathOf(wrap);
        var el = document.createElement('div'); el.className = 'c-pop'; el.setAttribute('data-cid', id);
        var h = '<div class="c-pop-head"><span class="c-pop-title">' + (type === 'row' ? 'Fila / Columnas' : type) + '</span><button type="button" class="c-pop-x" data-a="close">✕</button></div>';
        if (type === 'banner') { h += sel('height', 'Tamaño', [['compacto', 'Compacto'], ['normal', 'Normal'], ['grande', 'Grande']]); h += sel('width', 'Ancho', [['full', '100%'], ['grande', '75%'], ['media', '50%'], ['pequena', '25%']]); h += '<button type="button" class="c-pop-up" data-a="upload">🖼️ Subir imagen</button>'; }
        else if (type === 'imagen') { h += sel('width', 'Ancho', [['full', '100%'], ['grande', '75%'], ['media', '50%'], ['pequena', '25%']]); h += sel('height', 'Alto', [['normal', 'Normal'], ['grande', 'Grande'], ['full', 'Pantalla completa']]); h += sel('object_position', 'Enfoque', [['top-left', 'Arriba izquierda'], ['top', 'Arriba centro'], ['top-right', 'Arriba derecha'], ['left', 'Izquierda'], ['center', 'Centro'], ['right', 'Derecha'], ['bottom-left', 'Abajo izquierda'], ['bottom', 'Abajo centro'], ['bottom-right', 'Abajo derecha']]); h += '<span class="c-pop-lbl">Leyenda</span><input type="text" data-k="title" placeholder="Texto de la leyenda…" style="width:100%;padding:8px;border:1px solid #e2e8f0;border-radius:8px;font-size:12px;">' + sel('captionPos', 'Posición de la leyenda', [['none', 'Debajo de la imagen'], ['top-left', 'Encima · arriba izquierda'], ['top', 'Encima · arriba centro'], ['top-right', 'Encima · arriba derecha'], ['left', 'Encima · centro izquierda'], ['center', 'Encima · centro'], ['right', 'Encima · centro derecha'], ['bottom-left', 'Encima · abajo izquierda'], ['bottom', 'Encima · abajo centro'], ['bottom-right', 'Encima · abajo derecha']]) + '<span class="c-pop-lbl">Color de la leyenda</span><input type="color" data-k="captionColor" value="#ffffff" style="width:100%;height:36px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;padding:2px;cursor:pointer;">' + sel('captionSize', 'Tamaño de la leyenda', [['12', '12 px'], ['14', '14 px'], ['16', '16 px'], ['18', '18 px'], ['20', '20 px'], ['24', '24 px'], ['30', '30 px'], ['36', '36 px'], ['42', '42 px']]) + '<button type="button" class="c-pop-up" data-a="upload">🖼️ Subir imagen</button>'; }
        else if (type === 'texto') { h += sel('size', 'Tamaño', [['pequeno', 'Pequeño'], ['normal', 'Normal'], ['grande', 'Grande']]); h += sel('align', 'Alinear', [['left', 'Izquierda'], ['center', 'Centrado']]); }
        else if (type === 'row') { h += '<span class="c-pop-lbl">Divide la fila (grilla 12 · 12 = ancho completo)</span><div id="cpop-cols"></div><button type="button" class="c-pop-up" data-a="coladd">＋ Agregar columna</button>'; }
        else if (type === 'card') { h += '<span class="c-pop-lbl">Contenido</span><div class="c-pop-hint">Usa ＋ dentro de la tarjeta para meter elementos.</div>'; }
        else if (type === 'fondo' || type === 'seccion') { h += sel('bgType', 'Tipo de fondo', [['solid', 'Color sólido'], ['linear', 'Degradado lineal'], ['radial', 'Degradado radial'], ['conic', 'Degradado cónico'], ['image', 'Imagen'], ['pattern', 'Patrón']]); h += '<span class="c-pop-lbl">Color</span><input type="color" data-k="color" value="#ffffff" style="width:100%;height:36px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;padding:2px;cursor:pointer;"><span class="c-pop-lbl">Color secundario</span><input type="color" data-k="bg2" value="#e2e8f0" style="width:100%;height:36px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;padding:2px;cursor:pointer;">' + sel('bgAngle', 'Dirección', [['90', 'De izquierda a derecha'], ['135', 'Diagonal'], ['180', 'De arriba a abajo'], ['45', 'Diagonal invertida']]) + '<span class="c-pop-lbl">Imagen de fondo (URL)</span><input type="text" data-k="bgImage" placeholder="https://…" style="width:100%;padding:8px;border:1px solid #e2e8f0;border-radius:8px;font-size:12px;">' + sel('bgPattern', 'Patrón', [['rayas', 'Rayas diagonales'], ['horizontales', 'Rayas horizontales'], ['puntos', 'Puntos'], ['cuadros', 'Cuadros']]) + '<span class="c-pop-lbl">Color del patrón</span><input type="color" data-k="bgPatternC" value="#e2e8f0" style="width:100%;height:36px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;padding:2px;cursor:pointer;"><span class="c-pop-lbl" style="margin-top:8px;">Contenido</span><div class="c-pop-hint">Usa ＋ dentro de la sección para meter elementos.</div>'; }
        else if (type === 'paginas') { h += '<div id="cpop-pags"></div><button type="button" class="c-pop-up" data-a="pagadd">＋ Nueva página</button>'; }
        h += '<div class="c-pop-actions"><button type="button" data-a="up">▲</button><button type="button" data-a="dn">▼</button><button type="button" data-a="dup">⧉</button><button type="button" data-a="more">⚙</button><button type="button" data-a="del" class="del">✕</button></div>';
        el.innerHTML = h;
        wrap.appendChild(el); pop = el;
        el._id = id; el._path = path;
        el.querySelector('[data-a="close"]').onclick = closePop;
        el.querySelector('[data-a="up"]').onclick = function () { msg({ action: 'move', id: id, dir: -1, path: path }); };
        el.querySelector('[data-a="dn"]').onclick = function () { msg({ action: 'move', id: id, dir: 1, path: path }); };
        el.querySelector('[data-a="dup"]').onclick = function () { msg({ action: 'dup', id: id, path: path }); };
        el.querySelector('[data-a="more"]').onclick = function () { msg({ action: 'edit', id: id, path: path }); };
        el.querySelector('[data-a="del"]').onclick = function () { msg({ action: 'del', id: id, path: path }); };
        var up = el.querySelector('[data-a="upload"]'); if (up) up.onclick = function () { msg({ action: 'upload', id: id, path: path }); };
        var addCol = el.querySelector('[data-a="coladd"]'); if (addCol) addCol.onclick = function () { msg({ action: 'rowadd', id: id, path: path }); };
        var pagAdd = el.querySelector('[data-a="pagadd"]'); if (pagAdd) pagAdd.onclick = function () { msg({ action: 'pagadd', id: id, path: path }); };
        el.querySelectorAll('select[data-k]').forEach(function (s) { s.addEventListener('change', function () { msg({ action: 'prop', id: id, key: s.getAttribute('data-k'), value: s.value, path: path }); }); });
        el.querySelectorAll('input[data-k]').forEach(function (inp) { inp.addEventListener('change', function () { msg({ action: 'prop', id: id, key: inp.getAttribute('data-k'), value: inp.value, path: path }); }); });
        msg({ action: 'select', id: id, path: path });
      }
      function selectComp(wrap) { deselectAll(); if (wrap) { wrap.classList.add('c-selected'); openPop(wrap); } }
      function findWrap(id, path) {
        var all = document.querySelectorAll('.c-wrap');
        for (var i = 0; i < all.length; i++) if (all[i].getAttribute('data-cid') === String(id)) { if (all[i].getAttribute('data-path') === String(path || '')) return all[i]; }
        return null;
      }
      function bind() {
        document.querySelectorAll('.c-add').forEach(function (el) { el.addEventListener('click', function () { msg({ action: 'add', type: '', pos: parseInt(el.getAttribute('data-pos')) || 0, path: pathOf(el) }); }); });
        document.querySelectorAll('.ce-pick-img').forEach(function (el) { el.addEventListener('click', function (e) { e.stopPropagation(); var w = el.closest('.c-wrap'); msg({ action: 'upload', id: el.getAttribute('data-id'), path: w ? pathOf(w) : [] }); }); });
        document.querySelectorAll('[data-scroll]').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); var el2 = document.getElementById('pag-' + a.getAttribute('data-scroll')); if (el2) el2.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); });
        document.querySelectorAll('.c-wrap').forEach(function (wrap) { wrap.addEventListener('click', function (e) { var t = e.target; if (t && t.closest) { if (t.closest('.c-pop') || t.closest('.c-add')) return; if (t.closest('.c-wrap') !== wrap) return; } selectComp(wrap); }); });
        document.querySelectorAll('.ce-text').forEach(function (el) {
          el.addEventListener('click', function (e) { e.stopPropagation(); if (el.getAttribute('contenteditable') !== 'true') { el.setAttribute('contenteditable', 'true'); el.classList.add('ce-active'); el.focus(); } });
          el.addEventListener('input', function () { var w = el.closest('.c-wrap'); if (!w) return; msg({ action: 'inline', id: w.getAttribute('data-cid'), key: el.getAttribute('data-ce'), value: el.textContent, path: pathOf(w) }); });
          el.addEventListener('blur', function () { el.removeAttribute('contenteditable'); el.classList.remove('ce-active'); });
          el.addEventListener('keydown', function (e) { if (e.key === 'Escape') el.blur(); if (e.key === 'Enter' && (el.getAttribute('data-ce') === 'title' || el.tagName === 'SPAN')) { e.preventDefault(); el.blur(); } });
        });
      }
      document.addEventListener('dragover', function (e) { e.preventDefault(); var strip = (e.target && e.target.closest) ? e.target.closest('.c-add') : null; document.querySelectorAll('.c-add').forEach(function (x) { x.classList.remove('c-drop'); }); if (strip) strip.classList.add('c-drop'); });
      document.addEventListener('drop', function (e) { e.preventDefault(); document.querySelectorAll('.c-add').forEach(function (x) { x.classList.remove('c-drop'); }); var type = null; try { type = e.dataTransfer.getData('text/x-comp'); } catch (err) {} if (!type) return; var strip = (e.target && e.target.closest) ? e.target.closest('.c-add') : null; msg({ action: 'drop', type: type, pos: strip ? (parseInt(strip.getAttribute('data-pos')) || 0) : -1, path: strip ? pathOf(strip) : [] }); });
      document.addEventListener('click', function (e) { var a = e.target && e.target.closest ? e.target.closest('a[href]') : null; if (a) e.preventDefault(); if (!e.target.closest || !e.target.closest('.c-wrap')) deselectAll(); });
      window.addEventListener('message', function (ev) {
        var d = ev.data; if (!d || typeof d !== 'object' || !d.action) return;
        if (d.action === 'html') { var c = document.getElementById('composer'); if (c) { c.innerHTML = d.html; bind(); } closePop(); }
        else if (d.action === 'reselect') { var w = findWrap(d.id, d.path); if (w) { deselectAll(); w.classList.add('c-selected'); openPop(w); } }
        else if (d.action === 'props') { if (pop && pop.getAttribute('data-cid') === String(d.id)) { var ps = d.props || {}; pop.querySelectorAll('select[data-k]').forEach(function (s) { var k = s.getAttribute('data-k'); if (Object.prototype.hasOwnProperty.call(ps, k) && String(s.value) !== String(ps[k])) s.value = ps[k]; }); pop.querySelectorAll('input[data-k]').forEach(function (c) { var k = c.getAttribute('data-k'); if (Object.prototype.hasOwnProperty.call(ps, k) && String(c.value) !== String(ps[k] || '')) c.value = ps[k] || '#ffffff'; }); renderCols(ps); renderPags(ps); } }
        else if (d.action === 'grid') { document.documentElement.classList.toggle('guides-off', d.on === false); }
      });
      function renderPags(ps) {
        if (!pop) return;
        var cc = pop.querySelector('#cpop-pags');
        if (!cc) return;
        var pags = Array.isArray(ps.pags) ? ps.pags : [];
        cc.innerHTML = '';
        if (!pags.length) {
          var e = document.createElement('div'); e.className = 'c-pop-hint'; e.textContent = 'Aún no hay páginas. Crea una con ＋ Nueva página.';
          cc.appendChild(e);
        }
        pags.forEach(function (pg, i) {
          var row = document.createElement('div'); row.className = 'c-pop-colrow';
          var num = document.createElement('span'); num.className = 'c-pop-colnum'; num.textContent = (i + 1) + '·';
          var nm = document.createElement('span'); nm.className = 'c-pop-hint'; nm.style.flex = '1'; nm.style.marginTop = '0'; nm.textContent = pg.title || 'Página';
          var rm = document.createElement('button'); rm.type = 'button'; rm.textContent = '✕';
          rm.onclick = function () { msg({ action: 'pagdel', id: pop._id, path: pop._path, pag: pg.id }); };
          row.appendChild(num); row.appendChild(nm); row.appendChild(rm);
          cc.appendChild(row);
        });
      }
      function renderCols(ps) {
        if (!pop) return;
        var cc = pop.querySelector('#cpop-cols');
        if (!cc) return;
        var cols = Array.isArray(ps.cols) ? ps.cols : [];
        cc.innerHTML = '';
        cols.forEach(function (sp, i) {
          var row = document.createElement('div'); row.className = 'c-pop-colrow';
          var num = document.createElement('span'); num.className = 'c-pop-colnum'; num.textContent = (i + 1) + '·';
          var sl = document.createElement('select');
          for (var s = 1; s <= 12; s++) { var o = document.createElement('option'); o.value = s; o.textContent = s + (s === 12 ? ' (ancho)' : ''); if (Number(sp) === s) o.selected = true; sl.appendChild(o); }
          sl.addEventListener('change', function () { msg({ action: 'rowcol', id: pop._id, i: i, span: parseInt(this.value, 10), path: pop._path }); });
          var rm = document.createElement('button'); rm.type = 'button'; rm.textContent = '✕';
          rm.onclick = function () { msg({ action: 'rowdel', id: pop._id, i: i, path: pop._path }); };
          row.appendChild(num); row.appendChild(sl); row.appendChild(rm);
          cc.appendChild(row);
        });
        var total = cols.reduce(function (a, b) { return a + (Number(b) || 0); }, 0);
        var hint = document.createElement('div'); hint.className = 'c-pop-hint'; hint.textContent = 'Total ' + total + '/12' + (total > 12 ? ' · el sobrante pasa a la línea de abajo' : '');
        cc.appendChild(hint);
      }
      window.__bind = bind;
      window.addEventListener('load', function () { msg({ action: 'ready' }); });
      bind();
    })();
  </script>
<% } %>

<script>
  window.ctEnviarContacto = function (form) {
    var wa = form.getAttribute('data-wa') || '';
    var f = form.elements;
    var nombre = (f.nombre && f.nombre.value || '').trim();
    var telefono = (f.telefono && f.telefono.value || '').trim();
    var mensaje = (f.mensaje && f.mensaje.value || '').trim();
    if (!mensaje) return;
    var texto = 'Hola, soy ' + (nombre || 'un cliente');
    if (telefono) texto += ' (tel. ' + telefono + ')';
    texto += '. ' + mensaje;
    var btn = form.querySelector('button[type="submit"]');
    if (btn) { btn.disabled = true; btn.textContent = 'Abriendo WhatsApp…'; }
    window.open('https://wa.me/' + wa + '?text=' + encodeURIComponent(texto), '_blank', 'noopener');
    setTimeout(function () { if (btn) { btn.disabled = false; btn.innerHTML = '💬 ' + (form.getAttribute('data-boton') || 'Enviar consulta'); } }, 2500);
  };
  if (typeof window.ctSldInit === 'undefined') {
    window.ctSldInit = true;
    document.addEventListener('DOMContentLoaded', function () {
      document.documentElement.classList.add('ct-js');
      document.querySelectorAll('.ct-sld').forEach(function (sld) {
        var track = sld.querySelector('.ct-sld-track');
        if (!track || !track.children.length) return;
        var n = track.children.length;
        var dots = sld.querySelectorAll('.ct-sld-dot');
        function idx() {
          if (track.scrollLeft <= 1) return 0;
          var w = track.children[0].offsetWidth || 1;
          return Math.min(n - 1, Math.round(track.scrollLeft / w));
        }
        function go(i) {
          i = Math.max(0, Math.min(n - 1, i));
          var w = track.children[0].offsetWidth || 1;
          track.scrollTo({ left: i * w, behavior: 'smooth' });
        }
        function mark() {
          var i = idx();
          dots.forEach(function (d, k) { d.classList.toggle('active', k === i); });
        }
        dots.forEach(function (d, k) {
          d.addEventListener('click', function () { go(k); });
        });
        sld.querySelectorAll('.ct-sld-arrow').forEach(function (a) {
          a.addEventListener('click', function (e) { e.stopPropagation(); go(idx() + (parseInt(a.getAttribute('data-sld-nav'), 10) || 1)); });
        });
        var x0 = null;
        track.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
        track.addEventListener('touchend', function (e) {
          if (x0 === null) return;
          var dx = e.changedTouches[0].clientX - x0;
          x0 = null;
          if (Math.abs(dx) > 40) go(idx() + (dx < 0 ? 1 : -1));
        }, { passive: true });
        track.addEventListener('scroll', function () { mark(); }, { passive: true });
        var timer = setInterval(function () {
          if (sld.getAttribute('data-sld-auto') !== 'off' && !sld.matches(':hover')) go(idx() + 1);
        }, 4000);
        sld.addEventListener('mouseenter', function () { clearInterval(timer); });
        sld.addEventListener('mouseleave', function () {
          timer = setInterval(function () {
            if (!sld.matches(':hover')) go(idx() + 1);
          }, 4000);
        });
        mark();
      });
      if (typeof window.ctRevealInit === 'undefined') {
        window.ctRevealInit = true;
        var animEls = document.querySelectorAll('.ct-anim-fade,.ct-anim-up,.ct-anim-down,.ct-anim-left,.ct-anim-right,.ct-anim-zoom');
        function reveal(el){
          if (window.requestAnimationFrame){
            window.requestAnimationFrame(function(){
              window.requestAnimationFrame(function(){ el.classList.add('ct-anim-on'); });
            });
          } else el.classList.add('ct-anim-on');
        }
        if (animEls.length && 'IntersectionObserver' in window) {
          var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                obs.unobserve(en.target);
                reveal(en.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
          animEls.forEach(function (el) { obs.observe(el); });
          setTimeout(function () {
            animEls.forEach(function (el) {
              if (el.classList.contains('ct-anim-on')) return;
              var r = el.getBoundingClientRect();
              var vh = window.innerHeight || document.documentElement.clientHeight;
              if (r.top < vh - 30 && r.bottom > 0) reveal(el);
            });
          }, 350);
          window.addEventListener('load', function () {
            animEls.forEach(function (el) {
              if (el.classList.contains('ct-anim-on')) return;
              var r = el.getBoundingClientRect();
              var vh = window.innerHeight || document.documentElement.clientHeight;
              if (r.top < vh - 30 && r.bottom > 0) reveal(el);
            });
          });
        } else {
          animEls.forEach(reveal);
        }
      }
    });
  }
</script>
