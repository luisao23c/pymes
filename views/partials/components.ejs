    .ct-anim-on.ct-dur-epica{transition:opacity 7s cubic-bezier(.22,1,.36,1),transform 7s cubic-bezier(.22,1,.36,1);}
    @media (prefers-reduced-motion:reduce){.ct-anim-fade,.ct-anim-up,.ct-anim-down,.ct-anim-left,.ct-anim-right,.ct-anim-zoom{opacity:1;transform:none;transition:none;}}
    .ct-hov-scale{transition:transform .3s cubic-bezier(.16,1,.3,1);}
