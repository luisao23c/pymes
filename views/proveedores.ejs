<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Proveedores', biz }) %>
</head>
<body class="m-material bg-slate-100 min-h-screen">
  <%- include('admin/sidebar', { biz, active: 'proveedores', canDesign }) %>

  <main class="transition-all duration-300">
    <div class="max-w-4xl mx-auto px-4 md:px-8 py-4 md:py-6 pb-24 md:pb-6">

      <div class="mb-4">
        <h1 class="text-lg md:text-xl font-black tracking-tight text-slate-900">Proveedores y compras</h1>
        <p class="text-xs text-slate-500 mt-0.5">Registra proveedores, arma pedidos y repón stock al recibir.</p>
      </div>

      <% if (ok) { %>
        <div class="mb-3 bg-emerald-50 text-emerald-700 text-sm font-bold px-4 py-3 rounded-xl m-pop"><%= msg || 'Guardado ✓' %></div>
      <% } %>

      <!-- Proveedores -->
      <section class="m-card p-4 mb-3">
        <h2 class="font-extrabold text-slate-900 text-sm mb-3">Proveedores <span class="m-badge m-badge-neutral !ml-1"><%= suppliers.length %></span></h2>
        <form method="POST" action="/<%= biz.slug %>/admin/proveedor" class="grid sm:grid-cols-3 gap-3 mb-3">
          <div class="m-field"><label>Nombre *</label><input name="name" required placeholder="Ej: Distribuidora Torres"></div>
          <div class="m-field"><label>WhatsApp</label><input name="phone" inputmode="numeric" placeholder="Ej: 8712345678"></div>
          <div class="m-field"><label>Email</label><input name="email" type="email" placeholder="ventas@torres.mx"></div>
          <div class="m-field sm:col-span-3"><label>Notas</label><input name="notes" placeholder="Ej: entrega los martes"></div>
          <div class="sm:col-span-3"><button class="m-btn m-btn-filled w-full !min-h-11">Guardar proveedor</button></div>
        </form>
        <div class="flex flex-wrap gap-2">
          <% suppliers.forEach(s => { %>
            <span class="m-chip">
              <%= s.name %><% if (s.phone) { %> · 💬 <%= s.phone %><% } %><% if (s.email) { %> · ✉️ <%= s.email %><% } %>
              <form method="POST" action="/<%= biz.slug %>/admin/proveedor/<%= s.id %>/eliminar" data-confirm="¿Eliminar a <%= s.name %>?" class="inline">
                <button class="text-slate-400 hover:text-red-500 font-bold leading-none" title="Eliminar">✕</button>
              </form>
            </span>
          <% }) %>
          <% if (!suppliers.length) { %><p class="text-xs text-slate-400">Aún no tienes proveedores.</p><% } %>
        </div>
      </section>

      <!-- Nuevo pedido de compra -->
      <section class="m-card p-4 mb-3">
        <h2 class="font-extrabold text-slate-900 text-sm mb-3">Nuevo pedido de compra</h2>
        <form method="POST" action="/<%= biz.slug %>/admin/compra" id="po-form">
          <div class="m-field mb-3">
            <label>Proveedor</label>
            <select name="supplier_id" id="po-supplier">
              <option value="">Selecciona…</option>
              <% suppliers.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
            </select>
          </div>

          <p class="font-bold text-xs text-slate-600 mb-1">Productos del pedido <span class="font-normal text-slate-400">(elige uno existente o escribe uno nuevo — se creará al recibir)</span></p>
          <p class="text-[11px] text-slate-400 mb-1.5">⌨️ <b>Enter</b> avanza a la siguiente celda y al final crea fila nueva · <b>Ctrl+V</b> pega tu lista de Excel directo en la tabla</p>
          <div class="overflow-x-auto mb-2 rounded-xl border border-slate-200" id="po-grid">
            <table class="w-full text-sm min-w-[680px]">
              <thead>
                <tr class="text-left text-[10px] uppercase tracking-wide text-slate-400 border-b border-slate-100 bg-slate-50">
                  <th class="px-3 py-2 font-black">Producto</th>
                  <th class="px-2 py-2 w-36 font-black">Variante</th>
                  <th class="px-2 py-2 w-20 font-black">Cant.</th>
                  <th class="px-2 py-2 w-24 font-black">Costo</th>
                  <th class="px-2 py-2 w-24 font-black">Precio venta</th>
                  <th class="px-2 py-2 w-24 font-black text-right">Subtotal</th>
                  <th class="px-2 py-2 w-10"></th>
                </tr>
              </thead>
              <tbody id="po-items"></tbody>
            </table>
          </div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <button type="button" onclick="poAddRow({focus:true})" class="m-btn m-btn-tonal m-btn-sm">＋ Agregar línea</button>
            <details class="inline-block">
              <summary class="text-xs font-bold text-blue-600 hover:text-blue-700 cursor-pointer">📋 Pegar lista (Excel/CSV)</summary>
              <div class="mt-2">
                <textarea id="po-paste" rows="4" placeholder="producto, cantidad, costo, precio venta&#10;Tornillos 8mm, 10, 3.50, 6.00" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                <button type="button" onclick="poPasteBox()" class="m-btn m-btn-tonal m-btn-sm mt-1">Cargar lista</button>
              </div>
            </details>
          </div>

          <div class="flex items-center justify-between bg-slate-50 rounded-xl px-4 py-3 mb-3">
            <span class="text-xs font-bold text-slate-500">Total estimado</span>
            <span id="po-total" class="font-black text-lg text-slate-900">$0.00</span>
          </div>

          <input type="hidden" name="items" id="po-items-json">
          <button type="submit" class="m-btn m-btn-filled w-full !min-h-11">Registrar pedido</button>
        </form>
      </section>

      <!-- Historial -->
      <section class="m-card p-4">
        <h2 class="font-extrabold text-slate-900 text-sm mb-3">Pedidos de compra</h2>
        <% if (pos.length === 0) { %>
          <p class="text-xs text-slate-400">Sin pedidos todavía.</p>
        <% } else { %>
          <div class="space-y-2.5">
            <% pos.forEach(po => { %>
              <div class="p-3 rounded-xl border <%= po.received ? 'border-emerald-200 bg-emerald-50/40' : 'border-slate-100' %>">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <div class="flex items-center gap-2">
                    <p class="font-bold text-sm text-slate-800"><%= po.supplier_name || 'Sin proveedor' %></p>
                    <% if (po.received) { %><span class="m-badge m-badge-success !h-5 !text-[10px]">RECIBIDO</span><% } else { %><span class="m-badge m-badge-warn !h-5 !text-[10px]">PENDIENTE</span><% } %>
                  </div>
                  <span class="font-black text-slate-900"><%= money(po.total) %></span>
                </div>
                <div class="mt-1.5 text-xs text-slate-600 space-y-0.5">
                  <% po.items.forEach(it => { %>
                    <div class="flex justify-between gap-2"><span>• <%= it.qty %> x <%= it.name %><% if (it.variant) { %> <span class="text-slate-400">(<%= it.variant %>)</span><% } %></span><span class="text-slate-400"><%= money(it.cost * it.qty) %></span></div>
                  <% }) %>
                </div>
                <p class="text-[10px] text-slate-400 mt-1.5"><%= fmtFecha(po.created_at) %></p>
                <div class="flex flex-wrap items-center gap-1.5 mt-2">
                  <% if (po.supplier_phone) { %>
                    <a href="https://wa.me/<%= po.supplier_phone.startsWith('52') ? po.supplier_phone : '52' + po.supplier_phone %>?text=<%= po.msg %>" target="_blank" class="m-btn m-btn-sm m-btn-tonal !min-h-0 !py-1.5">💬 Pedir por WhatsApp</a>
                  <% } %>
                  <% if (po.supplier_email) { %>
                    <a href="mailto:<%= po.supplier_email %>?subject=<%= po.esubject %>&body=<%= po.ebody %>" class="m-btn m-btn-sm m-btn-tonal !min-h-0 !py-1.5">✉️ Pedir por email</a>
                  <% } %>
                  <button type="button" onclick="copiarPedido('<%= po.msg %>')" class="m-btn m-btn-sm m-btn-outlined !min-h-0 !py-1.5">📋 Copiar texto</button>
                  <% if (!po.received) { %>
                    <form method="POST" action="/<%= biz.slug %>/admin/compra/<%= po.id %>/recibido" data-confirm="¿Marcar como RECIBIDO y sumar el stock a tus productos?" class="inline">
                      <button class="m-btn m-btn-sm m-btn-filled !min-h-0 !py-1.5 !bg-emerald-600">✓ Recibido (suma stock)</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/<%= biz.slug %>/admin/compra/<%= po.id %>/eliminar" data-confirm="¿Eliminar este pedido?" class="inline">
                    <button class="m-btn-icon !w-8 !h-8 hover:!bg-red-50 hover:!text-red-500" title="Eliminar">🗑</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

    </div>
  </main>

  <%- include('admin/panel-ajax') %>
  <%- include('admin/toast') %>

  <script>
    var PRODS = <%- safeJson(products.map(p => ({ id: p.id, name: p.name, sku: p.sku, price: p.price, variantOpts: p.variantOpts || [] }))) %>;
    var prodNameToId = {};
    PRODS.forEach(p => prodNameToId[norm(p.name)] = p.id);
    var prodById = {};
    PRODS.forEach(p => prodById[p.id] = p);

    function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function norm(s){ return String(s==null?'':s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''); }

    var childOf = new WeakMap(); // fila maestra -> [filas hijas (combinaciones extra)]
    var NAV = ['.po-name', '.po-vname', '.po-qty', '.po-cost', '.po-price'];

    function poCells(row) {
      return NAV.map(s => row.querySelector(s)).filter(function(c){ return c && !c.classList.contains('hidden'); });
    }
    function poFocusCell(row, cell) {
      if (!cell) return;
      cell.focus();
      if (cell.select) cell.select();
    }
    function poNextCell(row, cell) {
      var cells = poCells(row);
      var i = cells.indexOf(cell);
      if (i >= 0 && i < cells.length - 1) { poFocusCell(row, cells[i + 1]); return true; }
      return false;
    }
    function poRowByCell(cell) {
      var el = cell; while (el && !(el.classList && el.classList.contains('po-row'))) el = el.parentElement;
      return el;
    }
    function poGoRow(row, cellSel, dir) {
      if (!row) return false;
      var rows = poRows();
      var i = rows.indexOf(row) + dir;
      if (i < 0 || i >= rows.length) return false;
      var c = rows[i].querySelector(cellSel);
      if (c && !c.classList.contains('hidden') && !c.readOnly) { poFocusCell(rows[i], c); return true; }
      return poGoRow(rows[i], cellSel, dir);
    }

    function poNameStyle(row) {
      var inp = row.querySelector('.po-name');
      var unlinked = !row.dataset.pid && inp.value.trim() && !inp.readOnly;
      inp.classList.toggle('border-dashed', unlinked);
      inp.classList.toggle('border-blue-400', unlinked);
      inp.classList.toggle('bg-blue-50/50', unlinked);
    }

    // ===== Autocomplete de productos (estilo Excel) =====
    // Un solo dropdown anclado al <body>: ningún transform/overflow del panel lo desplaza o recorta
    var poAc = document.createElement('div');
    poAc.className = 'po-ac hidden fixed z-[70] min-w-[280px] max-h-56 overflow-auto bg-white border border-slate-200 rounded-xl shadow-xl';
    document.body.appendChild(poAc);

    function acBox() { return poAc; }
    function acHide() { poAc.classList.add('hidden'); poAc.innerHTML = ''; poAc._idx = -1; poAc._row = null; }
    function acPlace(row) {
      var inp = row.querySelector('.po-name');
      var r = inp.getBoundingClientRect();
      var vv = window.visualViewport;
      var vw = (vv && vv.width) || window.innerWidth;
      var vh = (vv && vv.height) || window.innerHeight;
      var H = 224; // max-h-56
      var w = Math.max(r.width, 280);
      var left = Math.max(8, Math.min(r.left, vw - w - 8));
      var below = r.bottom + 6;
      var top;
      if (below + H <= vh - 8) top = below;
      else if (r.top - H - 6 >= 8) top = r.top - H - 6;
      else top = Math.max(8, vh - H - 8);
      poAc.style.left = left + 'px';
      poAc.style.top = top + 'px';
      poAc.style.width = w + 'px';
    }
    function acUpdate(row) {
      var inp = row.querySelector('.po-name');
      if (row.classList.contains('po-child') || inp.readOnly) { acHide(); return; }
      var q = norm(inp.value);
      // Sin texto: muestra todo el catálogo para elegir sin escribir (como el select de antes)
      var list = q ? PRODS.filter(function(p){
        return norm(p.name).indexOf(q) >= 0 || (p.sku ? norm(p.sku).indexOf(q) >= 0 : false);
      }) : PRODS;
      var matches = list.slice(0, q ? 8 : 50);
      var html = matches.map(function(p, i){
        return '<button type="button" data-pid="' + p.id + '" class="po-ac-it w-full text-left px-3 py-2 text-sm hover:bg-blue-50 ' + (i === 0 ? 'bg-blue-50/60' : '') + ' border-b border-slate-50">' +
          '<b class="text-slate-800">' + esc(p.name) + '</b>' +
          (p.sku ? ' <span class="text-slate-400 text-xs">(' + esc(p.sku) + ')</span>' : '') +
          (p.variantOpts && p.variantOpts.length ? ' <span class="text-amber-600 text-xs">🎛 ' + p.variantOpts.length + '</span>' : '') +
          (p.price ? ' <span class="text-slate-400 text-xs">$' + Number(p.price).toFixed(2) + '</span>' : '') +
        '</button>';
      }).join('');
      if (q) html += '<button type="button" class="po-ac-new w-full text-left px-3 py-2 text-xs font-bold text-blue-600 hover:bg-blue-50">➕ Usar "' + esc(inp.value.trim()) + '" como producto nuevo</button>';
      poAc.innerHTML = html;
      poAc._row = row;
      poAc.classList.remove('hidden');
      acPlace(row);
      poAc._idx = 0;
      poAc.querySelectorAll('.po-ac-it').forEach(function(btn, i){
        btn.addEventListener('mousedown', function(e){ e.preventDefault(); acPick(row, parseInt(btn.dataset.pid)); });
      });
      var nb = poAc.querySelector('.po-ac-new');
      if (nb) nb.addEventListener('mousedown', function(e){
        e.preventDefault(); acHide(); poFocusCell(row, row.querySelector('.po-qty'));
      });
    }
    function acMove(row, dir) {
      var items = poAc.querySelectorAll('.po-ac-it');
      if (poAc.classList.contains('hidden') || !items.length) return false;
      poAc._idx = (poAc._idx + dir + items.length) % items.length;
      items.forEach(function(it, i){ it.classList.toggle('bg-blue-50', i === poAc._idx); });
      items[poAc._idx].scrollIntoView({ block: 'nearest' });
      return true;
    }
    function acPick(row, id) {
      var p = prodById[id];
      if (!p) return;
      var hadChildren = (childOf.get(row) || []).length > 0;
      if (row.dataset.pid && row.dataset.pid !== String(id) && hadChildren) {
        (childOf.get(row) || []).forEach(function(ch){ ch.remove(); });
        childOf.set(row, []);
        row.dataset.var = '';
      }
      row.dataset.pid = String(id);
      row.querySelector('.po-name').value = p.name;
      // Preprecio: llena el precio de venta con el actual del producto si la celda está vacía
      var cost = row.querySelector('.po-cost'), price = row.querySelector('.po-price');
      if (!price.value && p.price) price.value = Number(p.price).toFixed(2);
      acHide();
      poNameStyle(row);
      refreshVariant(row);
      var vdet = row.querySelector('.po-vdet');
      if (!vdet.classList.contains('hidden')) vdet.open = true; // variantes listas para marcar
      poFocusCell(row, row.querySelector('.po-qty'));
      poRecalc();
    }

    // ===== Filas =====
    function poAddRow(opts) {
      opts = opts || {};
      var row = document.createElement('tr');
      row.className = 'po-row border-b border-slate-100 last:border-0';
      row.dataset.pid = opts.product_id ? String(opts.product_id) : '';
      row.dataset.prevPid = row.dataset.pid;
      row.dataset.var = opts.variant || '';
      row.innerHTML =
        '<td class="px-3 py-1.5 align-middle relative">' +
          '<input type="text" class="po-name w-full min-w-[170px] border border-slate-200 rounded-lg px-2 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Producto (escribe para buscar)" autocomplete="off">' +
        '</td>' +
        '<td class="px-2 py-1.5 align-middle">' +
          '<span class="po-vstatic hidden bg-amber-100 text-amber-800 rounded-lg px-2 py-1.5 text-xs font-bold whitespace-nowrap"></span>' +
          '<details class="po-vdet hidden relative text-xs">' +
            '<summary tabindex="-1" class="po-vsum bg-amber-50 border border-amber-300 text-amber-800 rounded-lg px-2 py-1.5 font-bold cursor-pointer select-none">🎛 Variantes <span class="po-vcount text-amber-500"></span></summary>' +
            '<div class="po-vlist absolute z-30 mt-1 w-64 max-h-52 overflow-auto bg-white border border-slate-200 rounded-xl shadow-xl p-2 space-y-1"></div>' +
          '</details>' +
          '<input type="text" tabindex="-1" class="po-vname w-full border border-amber-300 bg-amber-50 rounded-lg px-2 py-1.5 text-sm hidden" placeholder="Atributo (ej: XS / Azul)">' +
        '</td>' +
        '<td class="px-2 py-1.5 align-middle"><input type="number" min="1" class="po-qty w-full border border-slate-200 rounded-lg px-2 py-1.5 text-sm" placeholder="0"></td>' +
        '<td class="px-2 py-1.5 align-middle"><input type="number" min="0" step="0.01" class="po-cost w-full border border-slate-200 rounded-lg px-2 py-1.5 text-sm" placeholder="0.00"></td>' +
        '<td class="px-2 py-1.5 align-middle"><input type="number" min="0" step="0.01" class="po-price w-full border border-slate-200 rounded-lg px-2 py-1.5 text-sm" placeholder="0.00"></td>' +
        '<td class="px-2 py-1.5 align-middle text-right"><span class="po-sub text-xs font-black text-slate-700">$0.00</span></td>' +
        '<td class="px-2 py-1.5 align-middle text-center"><button type="button" class="po-del w-7 h-7 rounded-full bg-slate-100 text-slate-400 hover:bg-red-50 hover:text-red-500 font-bold">✕</button></td>';

      var inp = row.querySelector('.po-name');
      var vname = row.querySelector('.po-vname');
      var qty = row.querySelector('.po-qty');
      var cost = row.querySelector('.po-cost');
      var price = row.querySelector('.po-price');

      // Navegación tipo Excel en las celdas numéricas
      [qty, cost, price].forEach(function(cell){
        cell.addEventListener('focus', function(){ cell.select(); });
        cell.addEventListener('input', poRecalc);
        cell.addEventListener('keydown', function(e){
          if (e.key === 'Enter') {
            e.preventDefault();
            if (!poNextCell(row, cell)) poEnterNextRow(row);
          } else if (e.key === 'ArrowDown') { e.preventDefault(); poGoRow(row, '.' + cell.classList[0], 1); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); poGoRow(row, '.' + cell.classList[0], -1); }
        });
      });

      // Autocomplete + navegación en la celda de producto
      inp.addEventListener('input', function(){ row.dataset.pid = ''; refreshVariant(row); poNameStyle(row); acUpdate(row); });
      inp.addEventListener('focus', function(){
        if (inp.readOnly) return;
        // Si ya tiene un producto vinculado, selecciona el texto para reemplazarlo fácil
        if (row.dataset.pid) requestAnimationFrame(function(){ inp.select(); });
        acUpdate(row);
      });
      inp.addEventListener('blur', function(){
        setTimeout(function(){
          acHide(row);
          // Si escribió el nombre exacto de un producto, lo vincula solo
          if (!row.dataset.pid && !inp.readOnly) {
            var id = prodNameToId[norm(inp.value)];
            if (id) { row.dataset.pid = String(id); refreshVariant(row); }
            poNameStyle(row);
          }
        }, 120);
      });
      inp.addEventListener('keydown', function(e){
        if (e.key === 'ArrowDown') { e.preventDefault(); if (!acMove(row, 1)) acUpdate(row); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); acMove(row, -1); }
        else if (e.key === 'Enter') {
          e.preventDefault();
          var b = acBox(row);
          var items = b.querySelectorAll('.po-ac-it');
          if (!b.classList.contains('hidden') && row._acIdx >= 0 && items[row._acIdx]) { acPick(row, parseInt(items[row._acIdx].dataset.pid)); return; }
          acHide(row);
          if (!poNextCell(row, inp)) poEnterNextRow(row);
        }
        else if (e.key === 'Escape') { acHide(row); }
      });

      vname.addEventListener('input', poRecalc);
      row.querySelector('.po-del').onclick = function(){ removeRow(row); };

      if (opts.product_id) { inp.value = prodById[opts.product_id] ? prodById[opts.product_id].name : ''; }
      else if (opts.name) inp.value = opts.name;
      if (opts.qty) qty.value = opts.qty;
      if (opts.cost) cost.value = opts.cost;
      if (opts.price) price.value = opts.price;

      if (opts._childOf) {
        row.classList.add('po-child');
        inp.readOnly = true;
        inp.classList.add('bg-slate-50', 'text-slate-500');
      }
      refreshVariant(row);
      poNameStyle(row);
      document.getElementById('po-items').appendChild(row);
      if (opts._childOf) {
        var kids = childOf.get(opts._childOf) || [];
        kids.push(row);
        childOf.set(opts._childOf, kids);
      }
      poRecalc();
      if (opts.focus) poFocusCell(row, inp);
      return row;
    }

    function poEnterNextRow(row) {
      var rows = poRows();
      if (rows.indexOf(row) === rows.length - 1) poAddRow({ focus: true });
      else poFocusCell(rows[rows.indexOf(row) + 1], rows[rows.indexOf(row) + 1].querySelector('.po-name'));
    }

    function removeRow(row) {
      (childOf.get(row) || []).forEach(function(ch){ ch.remove(); });
      childOf.delete(row);
      row.remove();
      poRecalc();
    }

    function buildVList(row) {
      var vlist = row.querySelector('.po-vlist');
      var p = row.dataset.pid ? prodById[parseInt(row.dataset.pid)] : null;
      var combos = (p && p.variantOpts && p.variantOpts.length) ? p.variantOpts : [];
      vlist.innerHTML = combos.map(function(c){
        return '<label class="flex items-center gap-1.5 py-0.5 cursor-pointer"><input type="checkbox" class="po-vchk accent-amber-500" value="' + esc(c) + '"> <span class="text-slate-700">' + esc(c) + '</span></label>';
      }).join('');
      var kids = childOf.get(row) || [];
      vlist.querySelectorAll('.po-vchk').forEach(function(cb){
        cb.checked = cb.value === row.dataset.var || kids.some(function(ch){ return ch.dataset.var === cb.value; });
        cb.addEventListener('change', function(){ poVChanged(row); });
      });
    }

    function refreshVariant(row) {
      var isChild = row.classList.contains('po-child');
      var pid = row.dataset.pid ? parseInt(row.dataset.pid) : null;
      var p = pid ? prodById[pid] : null;
      var hasVar = p && p.variantOpts && p.variantOpts.length;
      var inp = row.querySelector('.po-name');
      var vname = row.querySelector('.po-vname');
      var vdet = row.querySelector('.po-vdet');
      var vstatic = row.querySelector('.po-vstatic');

      // Si la fila maestra cambia de producto, se limpian los hijos y la variante elegida
      if (!isChild && row.dataset.prevPid && row.dataset.prevPid !== row.dataset.pid) {
        (childOf.get(row) || []).forEach(function(ch){ ch.remove(); });
        childOf.set(row, []);
        row.dataset.var = '';
      }
      row.dataset.prevPid = row.dataset.pid;

      if (isChild) {
        vstatic.textContent = row.dataset.var;
        vstatic.classList.remove('hidden');
        vdet.classList.add('hidden'); vdet.open = false;
        vname.classList.add('hidden');
      } else if (hasVar) {
        vstatic.classList.add('hidden');
        vname.classList.add('hidden');
        vdet.classList.remove('hidden');
        buildVList(row);
        var n = row.querySelectorAll('.po-vchk:checked').length;
        row.querySelector('.po-vcount').textContent = n ? '(' + n + ')' : '';
      } else if (pid) {
        vstatic.classList.add('hidden');
        vdet.classList.add('hidden'); vdet.open = false;
        vname.classList.add('hidden');
      } else {
        vstatic.classList.add('hidden');
        vdet.classList.add('hidden'); vdet.open = false;
        vname.classList.remove('hidden');
      }
      poRecalc();
    }

    // La fila maestra guarda la 1ª combinación; el resto se agregan solas como filas hijas.
    function poVChanged(master) {
      (childOf.get(master) || []).forEach(function(ch){ ch.remove(); });
      childOf.set(master, []);
      var checked = Array.prototype.slice.call(master.querySelectorAll('.po-vchk:checked')).map(function(cb){ return cb.value; });
      master.dataset.var = checked[0] || '';
      master.querySelector('.po-vcount').textContent = checked.length ? '(' + checked.length + ')' : '';
      var baseQty = parseInt(master.querySelector('.po-qty').value) || 1;
      var mCost = master.querySelector('.po-cost').value;
      var mPrice = master.querySelector('.po-price').value;
      checked.slice(1).forEach(function(v){
        poAddRow({ product_id: master.dataset.pid, variant: v, qty: baseQty, cost: mCost, price: mPrice, _childOf: master });
      });
      poRecalc();
    }

    function poRows() { return Array.prototype.slice.call(document.querySelectorAll('.po-row')); }

    function poRecalc() {
      var total = 0;
      poRows().forEach(function(r){
        var qty = parseInt(r.querySelector('.po-qty').value) || 0;
        var cost = parseFloat(r.querySelector('.po-cost').value) || 0;
        var sub = qty * cost;
        total += sub;
        r.querySelector('.po-sub').textContent = '$' + sub.toFixed(2);
      });
      document.getElementById('po-total').textContent = '$' + total.toFixed(2);
      document.getElementById('po-items-json').value = JSON.stringify(poSerialize());
    }

    function poSerialize() {
      return poRows().map(function(r){
        var pid = r.dataset.pid ? parseInt(r.dataset.pid) : null;
        var prodName = pid ? prodById[pid].name : r.querySelector('.po-name').value.trim();
        var variant = r.dataset.var || r.querySelector('.po-vname').value.trim() || '';
        return { product_id: pid, name: prodName, variant: variant, qty: parseInt(r.querySelector('.po-qty').value) || 0, cost: parseFloat(r.querySelector('.po-cost').value) || 0, price: parseFloat(r.querySelector('.po-price').value) || 0 };
      }).filter(function(x){ return x.name && x.qty > 0; });
    }

    // ===== Pegar desde Excel directamente en la tabla (Ctrl+V sobre la cuadrícula) =====
    function poFillRow(row, o) {
      var inp = row.querySelector('.po-name');
      if (o.product_id) { row.dataset.pid = String(o.product_id); inp.value = prodById[o.product_id].name; }
      else { row.dataset.pid = ''; inp.value = o.name || ''; }
      if (o.qty) row.querySelector('.po-qty').value = o.qty;
      if (o.cost) row.querySelector('.po-cost').value = o.cost;
      if (o.price) row.querySelector('.po-price').value = o.price;
      refreshVariant(row);
      poNameStyle(row);
    }

    function poPasteText(txt, startRow) {
      var lines = txt.split(/\r?\n/).map(function(l){ return l.trim(); }).filter(Boolean);
      if (!lines.length) return 0;
      var rows = poRows();
      var si = startRow ? rows.indexOf(startRow) : -1;
      var count = 0;
      lines.forEach(function(line, i){
        var parts = line.split(/[\t,;]/).map(function(p){ return p.trim(); });
        var name = parts[0] || '';
        var qty = parseInt(parts[1]) || 0;
        var cost = parseFloat(parts[2]) || 0;
        var price = parseFloat(parts[3]) || 0;
        var m1 = name.match(/^(\d+)\s*[x*]\s*(.+)$/); // formato "10 x Tornillos"
        if (m1) { qty = parseInt(m1[1]); name = m1[2].trim(); }
        if (!name) return;
        var o = { qty: qty || 1, cost: cost, price: price };
        var id = prodNameToId[norm(name)];
        if (id) o.product_id = id; else o.name = name;
        if (i === 0 && si >= 0) { poFillRow(rows[si], o); }
        else { poAddRow(o); }
        count++;
      });
      poRecalc();
      return count;
    }

    function poPasteBox() { poPasteText(document.getElementById('po-paste').value, null); document.getElementById('po-paste').value = ''; }

    document.getElementById('po-grid').addEventListener('paste', function(e){
      var txt = (e.clipboardData || window.clipboardData).getData('text');
      if (!txt || (txt.indexOf('\n') < 0 && txt.indexOf('\t') < 0)) return; // valor simple → pegado normal
      e.preventDefault();
      var row = e.target && e.target.closest ? e.target.closest('.po-row') : null;
      poPasteText(txt, row);
    });

    // El autocomplete sigue anclado a su celda al hacer scroll (antes se cerraba y por eso "no salía")
    function acReposAll(){
      poRows().forEach(function(r){ var b = acBox(r); if (b && !b.classList.contains('hidden')) acPlace(r); });
    }
    window.addEventListener('scroll', acReposAll, { passive: true });
    document.getElementById('po-grid').addEventListener('scroll', acReposAll, { passive: true });
    if (window.visualViewport) window.visualViewport.addEventListener('resize', acReposAll);

    function copiarPedido(msg) {
      var text = decodeURIComponent(msg);
      try { navigator.clipboard.writeText(text); mostrarToast('Texto copiado ✓', 'ok'); } catch(e) { mostrarToast('No se pudo copiar', 'error'); }
    }

    document.getElementById('po-form').addEventListener('submit', function(e){
      var items = poSerialize();
      if (!items.length) { e.preventDefault(); mostrarToast('Agrega al menos un producto', 'error'); return; }
      if (!document.getElementById('po-supplier').value) { e.preventDefault(); mostrarToast('Selecciona un proveedor', 'error'); return; }
      document.getElementById('po-items-json').value = JSON.stringify(items);
    });

    poAddRow();
    document.querySelector('.po-name').focus();
  </script>
</body>
</html>
